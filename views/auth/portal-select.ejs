<%- include('../partials/head') %>

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-sky-50/50 to-emerald-50/40 text-slate-800 relative overflow-hidden flex flex-col justify-between">
  <!-- Soft Luminous Glow Accents -->
  <div class="pointer-events-none absolute -top-40 -left-40 w-96 h-96 rounded-full bg-emerald-200/40 blur-3xl"></div>
  <div class="pointer-events-none absolute top-1/3 -right-40 w-96 h-96 rounded-full bg-sky-200/40 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-40 left-1/3 w-96 h-96 rounded-full bg-indigo-100/40 blur-3xl"></div>

  <!-- Top Header Bar -->
  <header class="relative z-10 w-full max-w-7xl mx-auto px-6 py-6 sm:py-8 flex items-center justify-between border-b border-slate-200/80">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-white p-1.5 shadow-sm border border-slate-200 flex items-center justify-center shrink-0">
        <img src="/spvn-logo.png" alt="SPVN Monogram" class="w-full h-full object-contain" />
      </div>
      <div>
        <h1 class="text-base sm:text-lg font-black tracking-tight text-slate-950 leading-tight">
          <%= collegeName %>
        </h1>
        <p class="text-xs text-slate-600 font-medium hidden sm:block">
          <%= collegeAddress %>
        </p>
      </div>
    </div>

    <div class="hidden sm:flex items-center gap-2 bg-white/90 border border-emerald-200 px-3.5 py-1.5 rounded-full text-xs font-bold text-emerald-800 shadow-2xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Portal System Active</span>
    </div>
  </header>

  <!-- Main Hero Selection Section -->
  <main class="relative z-10 w-full max-w-5xl mx-auto px-6 py-10 sm:py-16 my-auto">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 rounded-full bg-sky-100/80 border border-sky-300/80 px-4 py-1.5 mb-4 text-xs font-black uppercase tracking-widest text-sky-800">
        <span>Academic Year <%= academicYear %></span>
      </div>

      <h2 class="text-3xl sm:text-5xl font-black text-slate-950 tracking-tight leading-[1.14]">
        CET Online <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 via-teal-600 to-emerald-600">Examination Portal</span>
      </h2>

      <p class="mt-4 text-sm sm:text-base text-slate-600 font-medium leading-relaxed">
        Welcome to the secure computer-based entrance examination & assessment platform. Please choose your portal to sign in:
      </p>
    </div>

    <!-- TWO BIG AND BOLD ROLE BUTTONS -->
    <div class="grid md:grid-cols-2 gap-6 sm:gap-8 max-w-4xl mx-auto">

      <!-- 1. ADMIN LOGIN BUTTON / CARD -->
      <a href="/auth/admin"
         class="group relative flex flex-col justify-between rounded-[32px] bg-white border-2 border-emerald-500/40 hover:border-emerald-500 p-7 sm:p-9 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(16,185,129,0.18)] shadow-[0_8px_30px_rgba(15,23,42,0.06)] active:scale-[0.99] text-left">
        <div class="absolute inset-0 rounded-[32px] bg-gradient-to-br from-emerald-50/70 via-transparent to-white pointer-events-none"></div>

        <div class="relative z-10">
          <div class="flex items-center justify-between mb-6">
            <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-700 text-white flex items-center justify-center shadow-lg shadow-emerald-700/25 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-8 h-8 sm:w-9 sm:h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-50 border border-emerald-300 text-emerald-800">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Faculty & Staff
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-black text-slate-950 group-hover:text-emerald-700 transition-colors">
            Admin Login
          </h3>

          <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Manage question banks, generate test papers, configure batches, monitor live exams, and export comprehensive merit results.
          </p>
        </div>

        <div class="relative z-10 mt-8">
          <div class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 hover:from-emerald-500 hover:to-teal-600 text-white font-black text-base sm:text-lg flex items-center justify-center gap-3 shadow-md shadow-emerald-700/25 group-hover:brightness-105 transition-all">
            <span>Click for Admin Login</span>
            <svg class="w-5 h-5 group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
        </div>
      </a>

      <!-- 2. STUDENT LOGIN BUTTON / CARD -->
      <a href="/auth/login"
         class="group relative flex flex-col justify-between rounded-[32px] bg-white border-2 border-sky-500/40 hover:border-sky-500 p-7 sm:p-9 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(14,165,233,0.18)] shadow-[0_8px_30px_rgba(15,23,42,0.06)] active:scale-[0.99] text-left">
        <div class="absolute inset-0 rounded-[32px] bg-gradient-to-br from-sky-50/70 via-transparent to-white pointer-events-none"></div>

        <div class="relative z-10">
          <div class="flex items-center justify-between mb-6">
            <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-2xl bg-gradient-to-br from-sky-600 to-indigo-700 text-white flex items-center justify-center shadow-lg shadow-sky-700/25 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-8 h-8 sm:w-9 sm:h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
              </svg>
            </div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-sky-50 border border-sky-300 text-sky-800">
              <span class="w-2 h-2 rounded-full bg-sky-600"></span>
              All Students
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-black text-slate-950 group-hover:text-sky-700 transition-colors">
            Student Login
          </h3>

          <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Enter with your Roll Number to take scheduled entrance tests, practice subject mock exams, view scorecards, and check percentile ranks.
          </p>
        </div>

        <div class="relative z-10 mt-8">
          <div class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-sky-600 via-sky-700 to-indigo-700 hover:from-sky-500 hover:to-indigo-600 text-white font-black text-base sm:text-lg flex items-center justify-center gap-3 shadow-md shadow-sky-700/25 group-hover:brightness-105 transition-all">
            <span>Click for Student Login</span>
            <svg class="w-5 h-5 group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
        </div>
      </a>

    </div>
  </main>

  <!-- Footer -->
  <footer class="relative z-10 w-full max-w-7xl mx-auto px-6 py-6 border-t border-slate-200/80 text-center text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-3 font-medium">
    <p>© <%= new Date().getFullYear() %> <%= collegeName %>. All rights reserved.</p>
    <div class="flex items-center gap-4 text-slate-600 font-medium">
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        256-Bit SSL Encrypted
      </span>
      <span>•</span>
      <span>Standardized CET Testing System</span>
    </div>
  </footer>
</div>

</body>
</html>
