<%- include('../partials/head') %>
<div class="flex min-h-screen"><%- include('../partials/sidebar-admin') %>
<main class="lg:ml-64 flex-1 min-h-screen bg-slate-50">
<header class="sticky top-0 z-20 bg-white border-b px-8 py-4 flex items-center justify-between"><div><p class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Reports</p><h1 class="text-xl font-bold text-slate-900">Leaderboard</h1></div><a href="/admin/results?testId=<%= test._id %>" class="px-4 py-2 border rounded-xl text-sm font-semibold bg-white">Back to Results</a></header>
<div class="p-8"><%- include('../partials/flash') %>
<div class="bg-gradient-to-r from-slate-950 to-blue-950 text-white rounded-3xl p-7 mb-6"><div class="text-sm text-blue-200">Test Leaderboard</div><h2 class="text-2xl font-bold mt-1"><%= test.title %></h2><div class="mt-5 flex gap-8 text-sm"><div><b class="text-2xl"><%= rows.length %></b><div class="text-slate-300">Completed</div></div><div><b class="text-2xl"><%= rows[0] ? rows[0].percentage.toFixed(1) : '0.0' %>%</b><div class="text-slate-300">Top Score</div></div></div></div>
<div class="bg-white rounded-2xl border shadow-sm overflow-hidden"><div class="px-6 py-4 border-b"><h3 class="font-bold">Rank List</h3></div><div class="overflow-x-auto"><table class="w-full text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-4 text-left">Rank</th><th class="p-4 text-left">Student</th><th class="p-4 text-left">Score</th><th class="p-4 text-left">Percentage</th><th class="p-4 text-left">Accuracy</th><th class="p-4 text-left">Correct</th><th class="p-4 text-left">Wrong</th><th class="p-4 text-left">Time</th><th class="p-4 text-left">Report</th></tr></thead><tbody class="divide-y">
<% rows.forEach((r,i)=>{ %><tr class="hover:bg-slate-50"><td class="p-4"><span class="inline-flex w-8 h-8 items-center justify-center rounded-full font-bold <%= i<3?'bg-amber-100 text-amber-700':'bg-slate-100 text-slate-700' %>"><%= r.displayRank %></span></td><td class="p-4"><div class="font-semibold"><%= r.studentId?.name || 'Student' %></div><div class="text-xs text-slate-400"><%= r.studentId?.rollNo || '' %></div></td><td class="p-4 font-bold"><%= r.score %>/<%= r.totalMarks %></td><td class="p-4 font-semibold text-blue-600"><%= r.percentage.toFixed(1) %>%</td><td class="p-4"><%= r.accuracy.toFixed(1) %>%</td><td class="p-4 text-emerald-600 font-semibold"><%= r.correctAnswers||0 %></td><td class="p-4 text-rose-600 font-semibold"><%= r.wrongAnswers||0 %></td><td class="p-4 text-slate-500"><%= r.timeTaken ? Math.floor(r.timeTaken/60)+'m '+(r.timeTaken%60)+'s' : '—' %></td><td class="p-4"><a class="text-blue-600 font-semibold" href="/results/<%= r._id %>">View</a></td></tr><% }) %>
<% if(!rows.length){ %><tr><td colspan="9" class="p-12 text-center text-slate-400">No completed attempts yet.</td></tr><% } %></tbody></table></div></div></div></main></div></body></html>
