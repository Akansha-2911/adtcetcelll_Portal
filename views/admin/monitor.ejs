<%- include('../partials/head') %>
<div class="flex min-h-screen bg-[#f7f9fb]"><%- include('../partials/sidebar-admin') %><main class="lg:ml-64 flex-1 min-w-0">
<header class="spvn-ui-topbar sticky top-0 z-10 px-5 lg:px-8"><div class="flex items-center gap-4"><button onclick="openSidebar()" class="lg:hidden text-slate-500">☰</button><nav class="spvn-ui-topnav flex-1"><a href="/admin/organization">Organization</a><a href="/admin/tests">Test Management</a><a href="/admin/results">Reports</a><a href="/admin/analytics">Analytics</a><a href="/admin/monitor" class="active">Monitor</a><a href="/admin/content">Content</a></nav></div></header>
<div class="p-5 lg:p-8"><%- include('../partials/flash') %><div class="flex items-center justify-between mb-6"><div><h1 class="spvn-ui-heading">Live Test Monitor</h1><p class="text-sm text-slate-500 mt-1">Track live candidates, completed attempts and anti-cheat flags.</p></div><button onclick="location.reload()" class="spvn-ui-btn spvn-ui-btn-soft">↻ Refresh</button></div>
<div class="grid gap-4"><% if(!tests.length){ %><div class="spvn-ui-panel p-12 text-center text-slate-400">No published or active tests to monitor.</div><% } %><% tests.forEach(t=>{ %><div class="spvn-ui-panel p-5"><div class="flex flex-col xl:flex-row xl:items-center gap-5"><div class="flex-1"><div class="flex items-center gap-2"><h2 class="font-bold text-slate-900"><%= t.title %></h2><span class="text-[10px] uppercase font-bold px-2 py-1 rounded-full <%= t.state==='Live'?'bg-emerald-100 text-emerald-700':t.state==='Ended'?'bg-slate-100 text-slate-600':'bg-amber-100 text-amber-700' %>"><%= t.state %></span></div><p class="text-xs text-slate-400 mt-1"><%= (t.groups||[]).map(g=>g.name).join(', ') || 'No batch assigned' %></p><p class="text-xs text-slate-500 mt-2"><%= t.startTime?new Date(t.startTime).toLocaleString('en-IN'):'Open start' %> → <%= t.endTime?new Date(t.endTime).toLocaleString('en-IN'):'Open end' %></p></div><div class="grid grid-cols-3 gap-3 min-w-[330px]"><div class="bg-sky-50 rounded-xl p-3 text-center"><p class="text-xl font-bold text-sky-700"><%= t.inProgress %></p><p class="text-[10px] text-sky-600">LIVE</p></div><div class="bg-emerald-50 rounded-xl p-3 text-center"><p class="text-xl font-bold text-emerald-700"><%= t.submitted %></p><p class="text-[10px] text-emerald-600">SUBMITTED</p></div><div class="bg-rose-50 rounded-xl p-3 text-center"><p class="text-xl font-bold text-rose-700"><%= t.flagged %></p><p class="text-[10px] text-rose-600">FLAGGED</p></div></div><div class="flex gap-2"><a href="/admin/monitor/<%= t._id %>" class="spvn-ui-btn spvn-ui-btn-blue">Open Monitor</a><form action="/admin/tests/<%= t._id %>/status" method="POST"><input type="hidden" name="status" value="<%= t.status==='active'?'closed':'active' %>"><button class="spvn-ui-btn <%= t.status==='active'?'spvn-ui-btn-danger':'spvn-ui-btn-primary' %>"><%= t.status==='active'?'Close':'Set Active' %></button></form></div></div></div><% }) %></div>
</div></main></div></body></html>
