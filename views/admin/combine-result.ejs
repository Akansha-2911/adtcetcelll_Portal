<%- include('../partials/head') %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 min-h-screen bg-slate-50">
    <header class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <div>
          <h1 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Combine Exam Results
          </h1>
          <p class="text-xs text-slate-500">Merge subject tests across multiple days into a single batch report</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a href="/admin/results" class="border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 px-3.5 py-2 rounded-xl text-xs font-semibold transition">
          ← Back to All Results
        </a>
      </div>
    </header>

    <div class="p-5 lg:p-8 space-y-6">
      <%- include('../partials/flash') %>
      <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm font-medium">
          <%= errorMsg %>
        </div>
      <% } %>

      <!-- Combination Setup Card -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <form action="/admin/results/combine" method="GET" class="space-y-5">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
            <div class="md:col-span-1">
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">1. Select Student Batch *</label>
              <select name="groupId" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:ring-2 focus:ring-indigo-500">
                <option value="">— Choose Batch —</option>
                <% groups.forEach(g => { %>
                  <option value="<%= g._id %>" <%= String(selectedGroupId) === String(g._id) ? 'selected' : '' %>><%= g.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="md:col-span-2">
              <p class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">2. Filter &amp; Search Tests</p>
              <input type="text" id="testSearchInput" onkeyup="filterTestList(this.value)" placeholder="Search test name or subject..."
                class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500"/>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">3. Select Tests to Combine *</label>
              <span class="text-xs text-slate-400">Select 2 or more tests (e.g. Physics + Chemistry + Biology)</span>
            </div>

            <div class="max-h-60 overflow-y-auto border border-slate-200 rounded-xl divide-y divide-slate-100 p-1 bg-slate-50/50" id="testCheckboxList">
              <% 
                const testsList = typeof allTests !== 'undefined' ? allTests : (typeof tests !== 'undefined' ? tests : []);
                const checkedIds = typeof selectedTestIds !== 'undefined' && Array.isArray(selectedTestIds) ? selectedTestIds.map(String) : [];
                testsList.forEach(t => { 
                  const isChecked = checkedIds.includes(String(t._id));
                  const subs = Array.isArray(t.subject) ? t.subject.join(', ') : (t.subject || '—');
              %>
                <label class="test-item-row flex items-center gap-3 p-3 rounded-lg hover:bg-white cursor-pointer transition">
                  <input type="checkbox" name="testIds" value="<%= t._id %>" <%= isChecked ? 'checked' : '' %>
                    class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500"/>
                  <div class="flex-1 min-w-0">
                    <p class="font-bold text-slate-900 text-sm truncate"><%= t.title %></p>
                    <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-500">
                      <span class="inline-block px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 font-semibold text-[10px]"><%= subs %></span>
                      <span>• <%= t.totalMarks || 0 %> Marks</span>
                      <span>• <%= new Date(t.createdAt).toLocaleDateString('en-IN') %></span>
                    </div>
                  </div>
                </label>
              <% }) %>
            </div>
          </div>

          <div class="pt-2 flex justify-end">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-6 rounded-xl text-sm transition shadow-sm flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <span>Generate Combined Result</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Result Card -->
      <% if (combinedData) { %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-6 border-b border-slate-200 flex flex-wrap items-center justify-between gap-4 bg-slate-50/50">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-full bg-indigo-100 text-indigo-800 text-xs font-bold">
                  Batch: <%= (combinedData.group && combinedData.group.name) || 'Selected Batch' %>
                </span>
                <span class="text-xs text-slate-400">
                  Combined <%= combinedData.tests.length %> Test(s)
                </span>
              </div>
              <h2 class="text-base font-extrabold text-slate-900 mt-1">
                <%= combinedData.tests.map(t => t.title).join(' + ') %>
              </h2>
              <div class="flex flex-wrap items-center gap-4 mt-2 text-xs font-semibold">
                <span class="text-slate-600">Total Students in Batch: <strong class="text-slate-900"><%= combinedData.totalStudents %></strong></span>
                <span class="text-emerald-700">Appeared: <strong><%= combinedData.appearedCount %></strong></span>
                <span class="text-rose-700">Completely Absent: <strong><%= combinedData.absentCount %></strong></span>
              </div>
            </div>

            <div class="flex items-center gap-2.5">
              <%
                const gId = (combinedData.group && combinedData.group._id) || selectedGroupId || '';
                const testIdsParam = (combinedData.tests || []).map(t => 'testIds=' + (t._id || t.id)).join('&');
                const excelUrl = `/admin/results/combine/excel?groupId=${gId}&${testIdsParam}`;
                const pdfUrl = `/admin/results/combine/pdf?groupId=${gId}&${testIdsParam}`;
              %>
              <a href="<%= excelUrl %>" class="flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-xl text-xs shadow-sm transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <span>Download Excel (.xlsx)</span>
              </a>

              <a href="<%= pdfUrl %>" target="_blank" class="flex items-center gap-1.5 bg-navy-950 hover:bg-navy-900 text-white font-semibold px-4 py-2 rounded-xl text-xs shadow-sm transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                <span>Download PDF</span>
              </a>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-xs sm:text-sm">
              <thead class="bg-slate-900 text-white text-[11px] uppercase tracking-wider">
                <tr>
                  <th class="px-4 py-3 text-left">Rank</th>
                  <th class="px-4 py-3 text-left">Roll No</th>
                  <th class="px-4 py-3 text-left">Student Name</th>
                  <% combinedData.subjects.forEach(sub => { %>
                    <th class="px-4 py-3 text-center"><%= sub %></th>
                  <% }) %>
                  <th class="px-4 py-3 text-center bg-slate-800">Total</th>
                  <th class="px-4 py-3 text-center bg-indigo-950">Percentile</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% if (!combinedData.studentRows || combinedData.studentRows.length === 0) { %>
                  <tr>
                    <td colspan="<%= 5 + combinedData.subjects.length %>" class="px-6 py-12 text-center text-slate-400">
                      No students are currently enrolled in this batch.
                    </td>
                  </tr>
                <% } %>
                <% combinedData.studentRows.forEach(row => { %>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-4 py-3 text-slate-500 font-semibold"><%= row.rank %></td>
                    <td class="px-4 py-3 font-mono font-bold text-indigo-700 text-xs"><%= row.rollNo %></td>
                    <td class="px-4 py-3 font-semibold text-slate-900"><%= row.name %></td>
                    <% (combinedData.subjects || []).forEach(sub => { 
                      const mark = (row.subjectMarks && row.subjectMarks[sub] !== undefined) ? row.subjectMarks[sub] : 'A';
                      const isAbsent = mark === 'A';
                    %>
                      <td class="px-4 py-3 text-center">
                        <% if (isAbsent) { %>
                          <span class="inline-block px-2 py-0.5 rounded-md bg-rose-100 text-rose-700 font-bold text-xs border border-rose-200">
                            A
                          </span>
                        <% } else { %>
                          <span class="font-bold text-slate-800"><%= mark %></span>
                        <% } %>
                      </td>
                    <% }) %>
                    <td class="px-4 py-3 text-center font-bold text-slate-900 bg-slate-50/50">
                      <%= row.total === 'A' ? 'A' : row.total %>
                    </td>
                    <td class="px-4 py-3 text-center font-bold font-mono text-indigo-700 bg-indigo-50/30">
                      <%= row.percentile %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</div>

<script>
function filterTestList(q) {
  const query = (q || '').toLowerCase();
  document.querySelectorAll('.test-item-row').forEach(row => {
    const text = row.textContent.toLowerCase();
    row.style.display = text.includes(query) ? '' : 'none';
  });
}
</script>
</body>
</html>
