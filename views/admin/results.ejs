<%- include('../partials/head') %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 min-h-screen">
    <header class="sticky top-0 z-20 bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Batch-wise Results</h1>
        <p class="text-xs text-slate-500">View test performance and combined multi-subject results</p>
      </div>
      <a href="/admin/results/combine" class="flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl text-sm font-semibold transition shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Combine Results</span>
      </a>
    </header>
    <div class="p-8">
      <%- include('../partials/flash') %>
      <form method="GET" action="/admin/results" class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 mb-5">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_1fr_auto] gap-4 items-end">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1.5">Batch</label>
            <select id="resultBatch" name="groupId" onchange="filterResultTests()"
              class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="">All Batches</option>
              <% groups.forEach(group => { %>
              <option value="<%= group._id %>" <%= selectedGroupId===group._id.toString()?'selected':'' %>><%= group.name %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1.5">Test</label>
            <select id="resultTest" name="testId"
              class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="">All Tests</option>
              <% tests.forEach(test => { %>
              <option value="<%= test._id %>"
                data-groups="<%= (test.groups||[]).map(groupId=>groupId.toString()).join(',') %>"
                <%= selectedTestId===test._id.toString()?'selected':'' %>><%= test.title %></option>
              <% }) %>
            </select>
          </div>
          <div class="flex gap-2">
            <button type="submit" class="bg-slate-950 text-white font-semibold px-5 py-2.5 rounded-xl hover:bg-slate-800">View Results</button>
            <a href="/admin/results" class="border border-slate-200 text-slate-600 font-semibold px-4 py-2.5 rounded-xl hover:bg-slate-50">Reset</a>
          </div>
        </div>
      </form>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
        <div class="bg-white border rounded-2xl p-5"><div class="text-xs font-semibold uppercase text-slate-400">Completed</div><div class="text-2xl font-bold mt-2"><%= summary.completed %></div></div>
        <div class="bg-white border rounded-2xl p-5"><div class="text-xs font-semibold uppercase text-slate-400">Average Score</div><div class="text-2xl font-bold mt-2"><%= summary.averagePct.toFixed(1) %>%</div></div>
        <div class="bg-white border rounded-2xl p-5"><div class="text-xs font-semibold uppercase text-slate-400">Passed (40%+)</div><div class="text-2xl font-bold mt-2 text-emerald-600"><%= summary.passCount %></div></div>
        <div class="bg-white border rounded-2xl p-5"><div class="text-xs font-semibold uppercase text-slate-400">Top Score</div><div class="text-2xl font-bold mt-2 text-blue-600"><%= summary.topPct.toFixed(1) %>%</div></div>
      </div>

      <% if (selectedTestId) { %>
      <div class="bg-slate-950 text-white rounded-2xl p-5 mb-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div><div class="text-xs uppercase tracking-wider text-blue-300 font-semibold">Advanced Report</div><div class="font-bold mt-1">Open rank list or question-wise performance for this test.</div></div>
        <div class="flex flex-wrap gap-2">
          <a href="/admin/results/leaderboard/<%= selectedTestId %>" class="bg-white text-slate-900 px-4 py-2 rounded-xl text-sm font-semibold">Leaderboard</a>
          <a href="/admin/results/question-analysis/<%= selectedTestId %>" class="bg-blue-600 text-white px-4 py-2 rounded-xl text-sm font-semibold">Question Analysis</a>
        </div>
      </div>
      <% } %>

      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h3 class="font-semibold text-gray-900">Completed Results (<%= results.length %>)</h3>
            <p class="text-xs text-slate-400 mt-0.5">Select a batch and test to view or download its complete result.</p>
          </div>
          <div class="flex gap-2">
            <input type="text" placeholder="Search..." onkeyup="filterTable(this.value,'resultsTable')"
              class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 w-40" />
            <a href="/admin/results/export?groupId=<%= encodeURIComponent(selectedGroupId) %>&testId=<%= encodeURIComponent(selectedTestId) %>"
              class="inline-flex items-center gap-1.5 bg-emerald-600 text-white font-semibold px-3.5 py-2 rounded-lg text-sm hover:bg-emerald-700 shadow-sm transition-colors whitespace-nowrap">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              <span>Excel</span>
            </a>
            <a href="/admin/results/export-pdf?groupId=<%= encodeURIComponent(selectedGroupId) %>&testId=<%= encodeURIComponent(selectedTestId) %>"
              class="inline-flex items-center gap-1.5 bg-rose-600 text-white font-semibold px-3.5 py-2 rounded-lg text-sm hover:bg-rose-700 shadow-sm transition-colors whitespace-nowrap">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              <span>PDF Report</span>
            </a>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-xs sm:text-sm" id="resultsTable">
            <thead class="bg-gray-50 text-gray-600 uppercase text-xs tracking-wider border-b border-gray-200">
              <tr>
                <th class="px-5 py-3.5 text-left font-semibold">Student</th>
                <th class="px-5 py-3.5 text-left font-semibold">Roll Number</th>
                <th class="px-5 py-3.5 text-center font-semibold">Phy</th>
                <th class="px-5 py-3.5 text-center font-semibold">Chem</th>
                <% if (typeof isPcb !== 'undefined' && isPcb && !isPcm) { %>
                <th class="px-5 py-3.5 text-center font-semibold">Bio</th>
                <% } else if (typeof isPcm !== 'undefined' && isPcm && !isPcb) { %>
                <th class="px-5 py-3.5 text-center font-semibold">Maths</th>
                <% } else { %>
                <th class="px-5 py-3.5 text-center font-semibold">Bio / Maths</th>
                <% } %>
                <th class="px-5 py-3.5 text-center font-semibold">Total</th>
                <th class="px-5 py-3.5 text-center font-semibold">Percentile</th>
                <th class="px-5 py-3.5 text-center font-semibold">Rank</th>
                <th class="px-5 py-3.5 text-center font-semibold">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              <% results.forEach(r => { %>
              <% 
                const isAbsent = Boolean(r.isAbsent || r.status === 'ABSENT');
                const physics = r.subjectScores?.Physics;
                const chemistry = r.subjectScores?.Chemistry;
                const mathematics = r.subjectScores?.Mathematics;
                const biology = r.subjectScores?.Biology;

                const formatMark = (s) => {
                  if (isAbsent || s?.status === 'ABSENT') return 'A';
                  if (!s || s.marks === undefined || s.marks === null) return '—';
                  return s.total ? `${s.marks}/${s.total}` : `${s.marks}`;
                };

                const getMarkClass = (s) => {
                  if (isAbsent || s?.status === 'ABSENT') return 'text-rose-600 font-bold';
                  return 'text-slate-800 font-semibold';
                };

                // Bio or Maths depending on student stream / batch
                const studentSub = ((r.student?.subject || '') + ' ' + (r.test?.subject || '')).toUpperCase();
                let bioMathDisplay = '—';
                let bioMathClass = 'text-slate-800 font-semibold';

                if (isAbsent) {
                  bioMathDisplay = 'A';
                  bioMathClass = 'text-rose-600 font-bold';
                } else if (typeof isPcb !== 'undefined' && isPcb && !isPcm) {
                  bioMathDisplay = formatMark(biology);
                  bioMathClass = getMarkClass(biology);
                } else if (typeof isPcm !== 'undefined' && isPcm && !isPcb) {
                  bioMathDisplay = formatMark(mathematics);
                  bioMathClass = getMarkClass(mathematics);
                } else {
                  const isStudentPcb = studentSub.includes('PCB') && !studentSub.includes('PCM');
                  const isStudentPcm = studentSub.includes('PCM') && !studentSub.includes('PCB');
                  if (isStudentPcb) {
                    bioMathDisplay = `Bio: ${formatMark(biology)}`;
                    bioMathClass = getMarkClass(biology);
                  } else if (isStudentPcm) {
                    bioMathDisplay = `Maths: ${formatMark(mathematics)}`;
                    bioMathClass = getMarkClass(mathematics);
                  } else {
                    const mathAttempted = mathematics && mathematics.status !== 'ABSENT' && (mathematics.marks !== undefined);
                    const bioAttempted = biology && biology.status !== 'ABSENT' && (biology.marks !== undefined);
                    if (mathAttempted && !bioAttempted) {
                      bioMathDisplay = `Maths: ${formatMark(mathematics)}`;
                      bioMathClass = getMarkClass(mathematics);
                    } else if (bioAttempted && !mathAttempted) {
                      bioMathDisplay = `Bio: ${formatMark(biology)}`;
                      bioMathClass = getMarkClass(biology);
                    } else if (mathAttempted && bioAttempted) {
                      bioMathDisplay = `M: ${formatMark(mathematics)} | B: ${formatMark(biology)}`;
                    } else {
                      bioMathDisplay = formatMark(mathematics || biology);
                    }
                  }
                }
              %>
              <tr class="hover:bg-gray-50 transition-colors result-row">
                <td class="px-5 py-3.5 font-medium text-gray-900"><%= r.student?.name || '—' %></td>
                <td class="px-5 py-3.5 font-mono text-gray-600 text-xs sm:text-sm"><%= r.student?.rollNo || '—' %></td>
                <td class="px-5 py-3.5 text-center <%= getMarkClass(physics) %>"><%= formatMark(physics) %></td>
                <td class="px-5 py-3.5 text-center <%= getMarkClass(chemistry) %>"><%= formatMark(chemistry) %></td>
                <td class="px-5 py-3.5 text-center <%= bioMathClass %>"><%= bioMathDisplay %></td>
                <td class="px-5 py-3.5 text-center font-bold <%= isAbsent ? 'text-rose-600' : 'text-gray-900' %>">
                  <%= isAbsent ? 'A' : (r.score + (r.totalMarks ? '/' + r.totalMarks : '')) %>
                </td>
                <td class="px-5 py-3.5 text-center font-mono font-semibold <%= isAbsent ? 'text-rose-600' : 'text-primary-700' %>">
                  <%= isAbsent ? 'A' : (r.percentile || '—') %>
                </td>
                <td class="px-5 py-3.5 text-center">
                  <% if (isAbsent || !r.rank || r.rank === '—') { %>
                    <span class="text-gray-400 font-mono">—</span>
                  <% } else { %>
                    <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-full text-xs font-bold <%= r.rank === 1 ? 'bg-amber-100 text-amber-800 ring-1 ring-amber-300' : r.rank === 2 ? 'bg-slate-200 text-slate-800' : r.rank === 3 ? 'bg-amber-50 text-amber-900' : 'bg-gray-100 text-gray-700' %>">
                      #<%= r.rank %>
                    </span>
                  <% } %>
                </td>
                <td class="px-5 py-3.5 text-center whitespace-nowrap">
                  <% if (isAbsent) { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-gray-100 text-gray-400">Absent</span>
                  <% } else { %>
                    <div class="inline-flex items-center gap-1.5 justify-center">
                      <a href="/results/<%= r.id %>" title="View Result" class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold text-primary-700 bg-primary-50 hover:bg-primary-100 rounded-md transition-colors border border-primary-200">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        <span>View</span>
                      </a>
                      <a href="/results/<%= r.id %>/pdf" title="Download PDF" class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 rounded-md transition-colors border border-rose-200">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        <span>PDF</span>
                      </a>
                    </div>
                  <% } %>
                </td>
              </tr>
              <% }) %>
              <% if (results.length === 0) { %>
              <tr><td colspan="9" class="px-6 py-12 text-center text-gray-400">No completed results for this batch/test selection.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>
<script>
function filterTable(q, id) {
  document.querySelectorAll(`#${id} .result-row`).forEach(row => {
    row.style.display = row.textContent.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
  });
}
function filterResultTests() {
  const groupId = document.getElementById('resultBatch').value;
  const testSelect = document.getElementById('resultTest');
  Array.from(testSelect.options).forEach(option => {
    if (!option.value) return;
    const groupIds = (option.dataset.groups || '').split(',').filter(Boolean);
    option.hidden = Boolean(groupId) && !groupIds.includes(groupId);
  });
  if (testSelect.selectedOptions[0]?.hidden) testSelect.value = '';
}
filterResultTests();
</script>
</body>
</html>
