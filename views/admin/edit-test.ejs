    ====================================================== */

    function handlePdfSelect(
      input,
      type
    ) {


      const prefix =
        type === 'question'
          ? 'q'
          : 's';


      const file =
        input.files[0];


      if (!file) {

        return;

      }


      if (
        file.type !==
        'application/pdf'
      ) {

        alert(
          'Please select a PDF file only.'
        );


        input.value =
          '';


        return;

      }


      if (
        file.size >
        20 *
        1024 *
        1024
      ) {

        alert(
          'File size must be under 20 MB.'
        );


        input.value =
          '';


        return;

      }


      document.getElementById(
        prefix +
        'PdfIcon'
      ).classList.add(
        'hidden'
      );


      const preview =
        document.getElementById(
          prefix +
          'PdfPreview'
        );


      preview.classList.remove(
        'hidden'
      );


      preview.classList.add(
        'flex'
      );


      document.getElementById(
        prefix +
        'PdfName'
      ).textContent =
        file.name;


      const sizeMB =
        (
          file.size /
          (
            1024 *
            1024
          )
        ).toFixed(2);


      document.getElementById(
        prefix +
        'PdfPages'
      ).textContent =
        'Size: ' +
        sizeMB +
        ' MB';


      const drop =
        document.getElementById(
          prefix +
          'PdfDrop'
        );


      drop.classList.remove(
        'border-dashed',
        'border-slate-300'
      );


      drop.classList.add(
        'border-solid',
        type === 'question'
          ? 'border-blue-400'
          : 'border-green-400'
      );

    }



    function clearPdf(
      type,
      event
    ) {


      event.stopPropagation();


      const prefix =
        type === 'question'
          ? 'q'
          : 's';


      const inputId =
        type === 'question'
          ? 'questionPdf'
          : 'solutionPdf';


      document.getElementById(
        inputId
      ).value = '';


      document.getElementById(
        prefix +
        'PdfIcon'
      ).classList.remove(
        'hidden'
      );


      const preview =
        document.getElementById(
          prefix +
          'PdfPreview'
        );


      preview.classList.add(
        'hidden'
      );


      preview.classList.remove(
        'flex'
      );


      document.getElementById(
        prefix +
        'PdfName'
      ).textContent = '';


      document.getElementById(
        prefix +
        'PdfPages'
      ).textContent = '';


      const drop =
        document.getElementById(
          prefix +
          'PdfDrop'
        );


      drop.classList.add(
        'border-dashed',
        'border-slate-300'
      );


      drop.classList.remove(
        'border-solid',
        'border-blue-400',
        'border-green-400'
      );

    }



    /* ======================================================
       DRAG / DROP
    ====================================================== */

    [
      'qPdfDrop',
      'sPdfDrop'
    ].forEach(
      function (id) {


        const el =
          document.getElementById(
            id
          );


        if (!el) {

          return;

        }


        el.addEventListener(
          'dragover',
          function (e) {

            e.preventDefault();


            el.classList.add(
              'ring-2',
              'ring-blue-300'
            );

          }
        );


        el.addEventListener(
          'dragleave',
          function () {

            el.classList.remove(
              'ring-2',
              'ring-blue-300'
            );

          }
        );


        el.addEventListener(
          'drop',
          function (e) {


            e.preventDefault();


            el.classList.remove(
              'ring-2',
              'ring-blue-300'
            );


            const type =
              id ===
                'qPdfDrop'
                ? 'question'
                : 'solution';


            const inputId =
              type ===
                'question'
                ? 'questionPdf'
                : 'solutionPdf';


            const input =
              document.getElementById(
                inputId
              );


            if (
              e.dataTransfer.files.length
            ) {


              try {


                const dt =
                  new DataTransfer();


                dt.items.add(
                  e.dataTransfer.files[0]
                );


                input.files =
                  dt.files;


              }

              catch (err) {

                console.warn(
                  err
                );

              }


              handlePdfSelect(
                input,
                type
              );

            }

          }
        );

      }
    );



    /* ======================================================
       INITIALIZE
    ====================================================== */

    document.querySelectorAll(
      '.diff-chip'
    ).forEach(
      button => {


        const text =
          button.textContent.trim();


        button.dataset.diff =
          text === 'All'
            ? ''
            : text;

      }
    );


    document.addEventListener(
      'DOMContentLoaded',
      function () {

        updCount();

        toggleAutoSubmit(
          document.getElementById(
            'autoSubmitToggle'
          )?.checked || false
        );

      }
    );

  </script>

  </body>

  </html>