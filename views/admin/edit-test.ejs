  <script>

    /* ======================================================
       DOWNLOAD WITHOUT OPENING BLANK PDF SCREEN
    ====================================================== */

    async function downloadFile(url, fallbackFileName) {

      try {

        const response = await fetch(url, {
          method: 'GET',
          credentials: 'same-origin'
        });


        if (!response.ok) {

          throw new Error(
            'Download failed with status ' + response.status
          );

        }


        const blob = await response.blob();


        let fileName = fallbackFileName;


        const disposition =
          response.headers.get('content-disposition');


        if (disposition) {

          const utf8Match =
            disposition.match(
              /filename\*=UTF-8''([^;]+)/i
            );


          const normalMatch =
            disposition.match(
              /filename="?([^"]+)"?/i
            );


          if (
            utf8Match &&
            utf8Match[1]
          ) {

            fileName =
              decodeURIComponent(
                utf8Match[1]
              );

          }

          else if (
            normalMatch &&
            normalMatch[1]
          ) {

            fileName =
              normalMatch[1].trim();

          }

        }


        const blobUrl =
          window.URL.createObjectURL(blob);


        const link =
          document.createElement('a');


        link.href =
          blobUrl;


        link.download =
          fileName;


        link.style.display =
          'none';


        document.body.appendChild(link);


        link.click();


        link.remove();


        setTimeout(() => {

          window.URL.revokeObjectURL(
            blobUrl
          );

        }, 1500);

      }

      catch (error) {

        console.error(
          'File download error:',
          error
        );


        alert(
          'Unable to download the file. Please try again.'
        );

      }

    }



    /* ======================================================
       COUNTER
    ====================================================== */

    function updCount() {

      const n =
        document.querySelectorAll(
          'input[name="questionIds"]:checked'
        ).length;


      document.getElementById(
        'selCount'
      ).textContent =
        n + ' selected';

    }



    /* ======================================================
       FILTER STATE
    ====================================================== */

    const ctState = {

      course: '',
      subject: '',
      topic: '',
      subtopic: '',
      diff: '',
      search: ''

    };



    /* ======================================================
       APPLY FILTERS
    ====================================================== */

    function applyCtFilters() {

      ctState.course =
        document.getElementById(
          'ctCourse'
        ).value;


      ctState.subject =
        document.getElementById(
          'ctSubject'
        ).value;


      ctState.topic =
        document.getElementById(
          'ctTopic'
        ).value;


      ctState.subtopic =
        document.getElementById(
          'ctSubtopic'
        ).value;


      ctState.diff =
        document.querySelector(
          '.diff-chip.active'
        )?.dataset.diff || '';


      ctState.search =
        (
          document.getElementById(
            'ctSearch'
          ).value || ''
        ).toLowerCase();



      document.querySelectorAll(
        '.q-item'
      ).forEach(row => {


        const matchSubj =
          !ctState.subject ||
          row.dataset.subj ===
          ctState.subject;


        const matchTopic =
          !ctState.topic ||
          row.dataset.topic ===
          ctState.topic;


        const matchSub =
          !ctState.subtopic ||
          row.dataset.subtopic ===
          ctState.subtopic;


        const matchDiff =
          !ctState.diff ||
          row.dataset.diff ===
          ctState.diff;


        const matchSearch =
          !ctState.search ||
          row.dataset.text.includes(
            ctState.search
          );


        row.style.display =
          (
            matchSubj &&
            matchTopic &&
            matchSub &&
            matchDiff &&
            matchSearch
          )
            ? ''
            : 'none';

      });



      document.querySelectorAll(
        '.q-group-header'
      ).forEach(header => {


        if (!header.dataset.topic) {


          const subj =
            header.dataset.subj;


          const hasVisible =
            [
              ...document.querySelectorAll(
                '.q-item'
              )
            ].some(
              r =>
                r.dataset.subj === subj &&
                r.style.display !== 'none'
            );


          header.style.display =
            hasVisible
              ? ''
              : 'none';

        }

        else {


          const subj =
            header.dataset.subj;


          const topic =
            header.dataset.topic;


          const hasVisible =
            [
              ...document.querySelectorAll(
                '.q-item'
              )
            ].some(
              r =>
                r.dataset.subj === subj &&
                r.dataset.topic === topic &&
                r.style.display !== 'none'
            );


          header.style.display =
            hasVisible
              ? ''
              : 'none';

        }

      });


      updateBreadcrumb();

    }



    /* ======================================================
       COURSE
    ====================================================== */

    async function onCtCourseChange(course) {

      const subjectSelect =
        document.getElementById(
          'ctSubject'
        );


      const topicSelect =
        document.getElementById(
          'ctTopic'
        );


      const subtopicSelect =
        document.getElementById(
          'ctSubtopic'
        );


      subjectSelect.innerHTML =
        '<option value="">All Subjects</option>';


      topicSelect.innerHTML =
        '<option value="">All Units</option>';


      subtopicSelect.innerHTML =
        '<option value="">All Subtopics</option>';


      subjectSelect.disabled =
        !course;


      topicSelect.disabled =
        true;


      subtopicSelect.disabled =
        true;


      if (course) {

        const subjects =
          await fetchSubjects(
            course
          );


        subjects.forEach(
          subject => {

            subjectSelect.innerHTML +=
              `<option value="${subject}">${subject}</option>`;

          }
        );

      }


      applyCtFilters();

    }



    /* ======================================================
       SUBJECT
    ====================================================== */

    async function onCtSubjectChange(subject) {

      const topicSelect =
        document.getElementById(
          'ctTopic'
        );


      const subtopicSelect =
        document.getElementById(
          'ctSubtopic'
        );


      topicSelect.innerHTML =
        '<option value="">All Units</option>';


      subtopicSelect.innerHTML =
        '<option value="">All Subtopics</option>';


      topicSelect.disabled =
        !subject;


      subtopicSelect.disabled =
        true;


      if (subject) {


        const topics =
          await fetchTopics(

            document.getElementById(
              'ctCourse'
            ).value,

            subject

          );


        topics.forEach(
          topic => {

            topicSelect.innerHTML +=
              `<option value="${topic.name}">${topic.name}</option>`;

          }
        );

      }


      applyCtFilters();

    }



    /* ======================================================
       TOPIC
    ====================================================== */

    async function onCtTopicChange(topic) {


      const subtopicSelect =
        document.getElementById(
          'ctSubtopic'
        );


      const course =
        document.getElementById(
          'ctCourse'
        ).value;


      const subject =
        document.getElementById(
          'ctSubject'
        ).value;


      subtopicSelect.innerHTML =
        '<option value="">All Subtopics</option>';


      subtopicSelect.disabled =
        !topic;


      if (topic) {


        const subs =
          await fetchSubtopics(
            course,
            subject,
            topic
          );


        subs.forEach(
          sub => {

            subtopicSelect.innerHTML +=
              `<option value="${sub}">${sub}</option>`;

          }
        );

      }


      applyCtFilters();

    }



    /* ======================================================
       DIFFICULTY
    ====================================================== */

    function filterDiff(event, diff) {


      document.querySelectorAll(
        '.diff-chip'
      ).forEach(button => {


        button.classList.remove(
          'active',
          'bg-slate-900',
          'text-white'
        );


        if (!button.dataset.diff) {

          button.dataset.diff =
            button.textContent.trim() === 'All'
              ? ''
              : button.textContent.trim();

        }

      });


      event.currentTarget.classList.add(
        'active',
        'bg-slate-900',
        'text-white'
      );


      ctState.diff =
        diff;


      applyCtFilters();

    }



    /* ======================================================
       RESET
    ====================================================== */

    function resetCtFilters() {


      document.getElementById(
        'ctCourse'
      ).value = '';


      document.getElementById(
        'ctSubject'
      ).innerHTML =
        '<option value="">Select course first</option>';


      document.getElementById(
        'ctTopic'
      ).innerHTML =
        '<option value="">All Units</option>';


      document.getElementById(
        'ctSubtopic'
      ).innerHTML =
        '<option value="">All Subtopics</option>';


      document.getElementById(
        'ctSubject'
      ).disabled = true;


      document.getElementById(
        'ctTopic'
      ).disabled = true;


      document.getElementById(
        'ctSubtopic'
      ).disabled = true;


      document.getElementById(
        'ctSearch'
      ).value = '';


      document.querySelectorAll(
        '.diff-chip'
      ).forEach(
        button =>
          button.classList.remove(
            'active',
            'bg-slate-900',
            'text-white'
          )
      );


      document.querySelector(
        '.diff-chip'
      ).classList.add(
        'active',
        'bg-slate-900',
        'text-white'
      );


      Object.keys(
        ctState
      ).forEach(
        key =>
          ctState[key] = ''
      );


      document.querySelectorAll(
        '.q-item,.q-group-header'
      ).forEach(
        row =>
          row.style.display = ''
      );


      updateBreadcrumb();

    }



    /* ======================================================
       BREADCRUMB
    ====================================================== */

    function updateBreadcrumb() {


      const crumb =
        document.getElementById(
          'ctBreadcrumb'
        );


      const inner =
        document.getElementById(
          'ctBreadcrumbInner'
        );


      const parts =
        [];


      if (ctState.course) {

        parts.push(
          `<span class="bg-slate-900 text-white px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.course}</span>`
        );

      }


      if (ctState.subject) {

        parts.push(
          `<span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.subject}</span>`
        );

      }


      if (ctState.topic) {

        parts.push(
          `<span class="text-slate-400 text-xs">›</span>
       <span class="bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.topic}</span>`
        );

      }


      if (ctState.subtopic) {

        parts.push(
          `<span class="text-slate-400 text-xs">›</span>
       <span class="bg-orange-100 text-orange-600 px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.subtopic}</span>`
        );

      }


      inner.innerHTML =
        parts.join('');


      crumb.style.display =
        parts.length
          ? 'flex'
          : 'none';

    }



    /* ======================================================
       SELECT
    ====================================================== */

    function selectAllVisible() {


      document.querySelectorAll(
        '.q-item'
      ).forEach(row => {


        if (
          row.style.display !==
          'none'
        ) {

          const checkbox =
            row.querySelector(
              'input[type="checkbox"]'
            );


          if (checkbox) {

            checkbox.checked =
              true;

          }

        }

      });


      updCount();

    }



    function deselectAll() {


      document.querySelectorAll(
        'input[name="questionIds"]'
      ).forEach(
        checkbox =>
          checkbox.checked = false
      );


      updCount();

    }



    /* ======================================================
       AJAX
    ====================================================== */

    async function fetchSubjects(course) {

      try {

        const response =
          await fetch(
            `/admin/ajax/subjects/${encodeURIComponent(course)}`
          );


        return await response.json();

      }

      catch {

        return [];

      }

    }



    async function fetchTopics(course, subject) {

      try {

        const response =
          await fetch(

            `/admin/ajax/topics?course=${encodeURIComponent(course)}&subject=${encodeURIComponent(subject)}`

          );


        return await response.json();

      }

      catch {

        return [];

      }

    }



    async function fetchSubtopics(
      course,
      subject,
      topic
    ) {

      try {

        const response =
          await fetch(

            `/admin/ajax/subtopics?course=${encodeURIComponent(course)}&subject=${encodeURIComponent(subject)}&topic=${encodeURIComponent(topic)}`

          );


        return await response.json();

      }

      catch {

        return [];

      }

    }



    /* ======================================================
       SORT
    ====================================================== */

    function applyCtSort() {


      const sort =
        document.getElementById(
          'ctSort'
        ).value;


      const list =
        document.getElementById(
          'ctQuestionList'
        );


      const items =
        [
          ...list.querySelectorAll(
            '.q-item'
          )
        ].map(
          el => ({

            el,

            subj:
              el.dataset.subj || '',

            topic:
              el.dataset.topic || '',

            subtopic:
              el.dataset.subtopic || '',

            diff:
              el.dataset.diff || '',

            idx:
              parseInt(
                el.dataset.idx || '0'
              )

          })
        );


      const diffOrder = {

        Easy: 0,
        Medium: 1,
        Hard: 2

      };


      items.sort(
        (a, b) => {


          if (
            sort ===
            'difficulty'
          ) {


            const diff =
              (
                diffOrder[a.diff] ??
                9
              ) -
              (
                diffOrder[b.diff] ??
                9
              );


            if (diff !== 0) {

              return diff;

            }


            return (
              a.subj.localeCompare(
                b.subj
              ) ||
              a.topic.localeCompare(
                b.topic
              )
            );

          }


          else if (
            sort ===
            'newest'
          ) {

            return (
              b.idx -
              a.idx
            );

          }


          else {

            return (
              a.subj.localeCompare(
                b.subj
              ) ||
              a.topic.localeCompare(
                b.topic
              ) ||
              a.subtopic.localeCompare(
                b.subtopic
              )
            );

          }

        }
      );


      list.querySelectorAll(
        '.q-item, .q-group-header'
      ).forEach(
        element =>
          element.remove()
      );


      let lastSubj =
        null;


      let lastTopic =
        null;


      items.forEach(
        ({
          el,
          subj,
          topic,
          subtopic,
          diff
        }) => {


          if (
            sort ===
            'subject'
          ) {


            if (
              subj !==
              lastSubj
            ) {


              lastSubj =
                subj;


              lastTopic =
                null;


              const header =
                document.createElement(
                  'div'
                );


              header.className =
                'q-group-header px-4 py-2 bg-blue-50 border-b border-blue-100 sticky top-0 z-[1]';


              header.dataset.subj =
                subj;


              header.dataset.topic =
                '';


              header.dataset.subtopic =
                '';


              header.innerHTML =
                '<span class="text-xs font-bold text-blue-700 uppercase tracking-wider">📚 ' +
                (
                  subj ||
                  'No Subject'
                ) +
                '</span>';


              list.appendChild(
                header
              );

            }



            if (
              topic &&
              topic !==
              lastTopic
            ) {


              lastTopic =
                topic;


              const topicHeader =
                document.createElement(
                  'div'
                );


              topicHeader.className =
                'q-group-header px-5 py-1.5 bg-purple-50 border-b border-purple-100';


              topicHeader.dataset.subj =
                subj;


              topicHeader.dataset.topic =
                topic;


              topicHeader.dataset.subtopic =
                '';


              topicHeader.innerHTML =
                '<span class="text-xs font-semibold text-purple-600">📌 ' +
                topic +
                '</span>' +
                (
                  subtopic
                    ?
                    '<span class="text-purple-400 mx-1">›</span><span class="text-xs text-purple-500">' +
                    subtopic +
                    '</span>'
                    :
                    ''
                );


              list.appendChild(
                topicHeader
              );

            }

          }


          else if (
            sort ===
            'difficulty'
          ) {


            if (
              diff !==
              lastSubj
            ) {


              lastSubj =
                diff;


              const difficultyHeader =
                document.createElement(
                  'div'
                );


              const colors = {

                Easy:
                  'bg-green-50 border-green-100 text-green-700',

                Medium:
                  'bg-yellow-50 border-yellow-100 text-yellow-700',

                Hard:
                  'bg-red-50 border-red-100 text-red-700'

              };


              const className =
                colors[diff] ||
                'bg-slate-50 border-slate-100 text-slate-600';


              difficultyHeader.className =
                'q-group-header px-4 py-2 border-b sticky top-0 z-[1] ' +
                className;


              difficultyHeader.dataset.subj =
                '';


              difficultyHeader.dataset.topic =
                '';


              difficultyHeader.dataset.subtopic =
                '';


              difficultyHeader.innerHTML =
                '<span class="text-xs font-bold uppercase tracking-wider">' +
                (
                  diff ||
                  'No Difficulty'
                ) +
                '</span>';


              list.appendChild(
                difficultyHeader
              );

            }

          }


          list.appendChild(
            el
          );

        }
      );


      applyCtFilters();

    }



