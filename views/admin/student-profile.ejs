<%- include('../partials/head') %>
  <div class="flex min-h-screen">
    <%- include('../partials/sidebar-admin') %>
      <main class="lg:ml-64 flex-1 min-h-screen">
        <header
          class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4 flex items-center gap-4">
          <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <a href="/admin/students" class="text-slate-400 hover:text-slate-600">&larr;</a>
          <div class="flex-1">
            <h1 class="text-lg font-bold text-slate-900">
              <%= student.name %>
            </h1>
            <p class="text-xs text-slate-400">Roll No: <%= student.rollNo %>
            </p>
          </div>
          <button onclick="document.getElementById('deleteStudentModal').classList.remove('hidden')"
            class="flex items-center gap-1.5 text-xs font-semibold text-rose-600 border border-rose-200 px-3 py-2 rounded-lg hover:bg-rose-50 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            Delete Student
          </button>
        </header>

        <div class="p-5 lg:p-8 space-y-6 max-w-4xl mx-auto">
          <%- include('../partials/flash') %>

            <!-- Profile card -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6">
              <div class="flex items-start gap-5">
                <div
                  class="w-16 h-16 rounded-2xl bg-navy-100 flex items-center justify-center text-navy-700 font-bold text-2xl shrink-0">
                  <%= student.name.charAt(0).toUpperCase() %>
                </div>
                <div class="flex-1 grid grid-cols-2 sm:grid-cols-3 gap-4">
                  <div>
                    <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-0.5">Full Name</p>
                    <p class="text-sm font-semibold text-slate-900">
                      <%= student.name %>
                    </p>
                  </div>
                  <div>
                    <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-0.5">Roll No</p>
                    <p class="text-sm font-mono font-semibold text-slate-700">
                      <%= student.rollNo || '—' %>
                    </p>
                  </div>
                  <div>
                    <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-0.5">Email</p>
                    <p class="text-sm text-slate-600">
                      <%= student.email || '—' %>
                    </p>
                  </div>
                  <div>
                    <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-0.5">Phone</p>
                    <p class="text-sm text-slate-600">
                      <%= student.phone || '—' %>
                    </p>
                  </div>
                  <div>
                    <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-0.5">Parent Contact</p>
                    <p class="text-sm text-slate-600">
                      <%= student.parentContact || '—' %>
                    </p>
                  </div>
                  <div>
                    <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-0.5">
                      Password Status
                    </p>

                    <% if (student.isFirstLogin) { %>

                      <span class="bg-amber-100 text-amber-700
             text-[11px] font-semibold
             px-2.5 py-1 rounded-full">
                        Temporary Password
                      </span>

                      <% } else { %>

                        <span class="bg-emerald-100 text-emerald-700
             text-[11px] font-semibold
             px-2.5 py-1 rounded-full">
                          Password Updated
                        </span>

                        <% } %>
                  </div>
                  <div>
                    <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-0.5">Joined</p>
                    <p class="text-sm text-slate-600">
                      <%= new Date(student.createdAt).toLocaleDateString('en-IN') %>
                    </p>
                  </div>
                  <div>
                    <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-0.5">Last Login</p>
                    <p class="text-sm text-slate-600">
                      <%= student.lastLogin ? new Date(student.lastLogin).toLocaleDateString('en-IN') : '—' %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
            <!-- PASSWORD MANAGEMENT -->
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

              <div class="flex items-start justify-between gap-4">

                <div>
                  <p class="text-xs font-bold uppercase tracking-wider text-slate-500">
                    Password Management
                  </p>

                  <h3 class="mt-1 text-lg font-black text-slate-900">
                    Login Security
                  </h3>
                </div>

                <% if (student.isFirstLogin) { %>
                  <span class="inline-flex items-center rounded-full
                   bg-amber-100 px-3 py-1
                   text-xs font-bold text-amber-700">
                    Temporary Password
                  </span>
                  <% } else { %>
                    <span class="inline-flex items-center rounded-full
                   bg-emerald-100 px-3 py-1
                   text-xs font-bold text-emerald-700">
                      Password Updated
                    </span>
                    <% } %>

              </div>


              <div class="mt-5 grid gap-4 sm:grid-cols-2">

                <!-- LAST PASSWORD CHANGE -->
                <div class="rounded-xl bg-slate-50 p-4">
                  <p class="text-xs font-semibold text-slate-500">
                    Last Password Change
                  </p>

                  <p class="mt-1 text-sm font-bold text-slate-900">
                    <% if (student.passwordChangedAt) { %>
                      <%= new Date(student.passwordChangedAt).toLocaleString('en-IN') %>
                        <% } else { %>
                          Not changed yet
                          <% } %>
                  </p>
                </div>


                <!-- LAST ADMIN RESET -->
                <div class="rounded-xl bg-slate-50 p-4">
                  <p class="text-xs font-semibold text-slate-500">
                    Last Admin Reset
                  </p>

                  <p class="mt-1 text-sm font-bold text-slate-900">
                    <% if (student.passwordResetAt) { %>
                      <%= new Date(student.passwordResetAt).toLocaleString('en-IN') %>
                        <% } else { %>
                          Never
                          <% } %>
                  </p>
                </div>

              </div>


              <div class="mt-5 border-t border-slate-200 pt-5">

                <form method="POST" action="/admin/students/<%= student._id %>/reset-password"
                  onsubmit="return confirm('Reset password for this student?');">

                  <button type="submit" class="inline-flex items-center justify-center
               rounded-xl bg-indigo-600
               px-4 py-2.5
               text-sm font-bold text-white
               hover:bg-indigo-700 transition">
                    Reset Student Password
                  </button>

                </form>

                <p class="mt-2 text-xs text-slate-500">
                  Resetting the password does not delete the student's tests, results, profile, or previous history.
                </p>

              </div>

            </div>

            <!-- Admission / Student Information -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6">
              <div class="flex items-center justify-between gap-3 mb-4">
                <div>
                  <h3 class="font-bold text-slate-800">Student Information</h3>
                  <p class="text-xs text-slate-400 mt-0.5">Admission details imported from the SPVN student information
                    sheet.</p>
                </div>
                <span class="text-xs font-semibold bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-full">
                  <%= student.classLevel || '—' %>
                    <%= student.division ? '· Div ' + student.division : '' %>
                </span>
              </div>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-x-5 gap-y-4 text-sm">
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">CET Exam No</p>
                  <p class="font-mono text-slate-700">
                    <%= student.cetExamNo || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">G.R. No</p>
                  <p class="font-mono text-slate-700">
                    <%= student.grNo || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Gender</p>
                  <p class="text-slate-700">
                    <%= student.gender || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Hostel</p>
                  <p class="text-slate-700">
                    <%= student.hostel || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Date of Birth</p>
                  <p class="text-slate-700">
                    <%= student.dateOfBirth ? new Date(student.dateOfBirth).toLocaleDateString('en-IN') : '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Category</p>
                  <p class="text-slate-700">
                    <%= student.category || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Blood Group</p>
                  <p class="text-slate-700">
                    <%= student.bloodGroup || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Subject Group</p>
                  <p class="text-slate-700">
                    <%= student.subjectGroup || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Academy</p>
                  <p class="text-slate-700">
                    <%= student.academy || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Parent Mobile 1</p>
                  <p class="font-mono text-slate-700">
                    <%= student.parentContact || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Parent Mobile 2</p>
                  <p class="font-mono text-slate-700">
                    <%= student.parentContact2 || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Pin Code</p>
                  <p class="font-mono text-slate-700">
                    <%= student.pinCode || '—' %>
                  </p>
                </div>
                <div class="col-span-2">
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Address</p>
                  <p class="text-slate-700">
                    <%= student.address || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">Taluka</p>
                  <p class="text-slate-700">
                    <%= student.taluka || '—' %>
                  </p>
                </div>
                <div>
                  <p class="text-[11px] uppercase font-semibold text-slate-400">District</p>
                  <p class="text-slate-700">
                    <%= student.district || '—' %>
                  </p>
                </div>
              </div>
            </div>

            <!-- Batches -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6">
              <h3 class="font-bold text-slate-800 mb-4">Batch Memberships</h3>
              <% if (memberships.length) { %>
                <div class="flex flex-wrap gap-2">
                  <% memberships.forEach(m=> { if (m.groupId) { %>
                    <span
                      class="bg-navy-50 text-navy-700 text-xs font-semibold px-3 py-1.5 rounded-full border border-navy-100">
                      <%= m.groupId.name %> &middot; <%= m.groupId.academicYear %>
                    </span>
                    <% } }) %>
                </div>
                <% } else { %>
                  <p class="text-sm text-slate-400">Not assigned to any batch.</p>
                  <% } %>
            </div>

            <!-- Submitted Documents -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6">
              <h3 class="font-bold text-slate-800 mb-4">Submitted Documents</h3>
              <% if (documents.length) { %>
                <div class="divide-y divide-slate-50">
                  <% documents.forEach(doc=> { %>
                    <div class="py-3 flex items-center gap-3">
                      <svg class="w-8 h-8 text-slate-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-slate-800 truncate">
                          <%= doc.originalName %>
                        </p>
                        <p class="text-xs text-slate-400">
                          <%= doc.description || '' %> &middot; <%= new Date(doc.createdAt).toLocaleDateString('en-IN')
                              %>
                        </p>
                      </div>
                      <a href="<%= doc.filePath %>" target="_blank"
                        class="text-xs font-semibold text-navy-600 hover:text-navy-800 shrink-0">View</a>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                  <p class="text-sm text-slate-400">No documents submitted.</p>
                  <% } %>
            </div>

            <!-- Recent Results -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6">
              <h3 class="font-bold text-slate-800 mb-4">Recent Exam Results</h3>
              <% if (results.length) { %>
                <div class="divide-y divide-slate-50">
                  <% results.forEach(r=> { %>
                    <div class="py-3 flex items-center gap-3">
                      <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-slate-800 truncate">
                          <%= r.testId?.title || 'Unknown Test' %>
                        </p>
                        <p class="text-xs text-slate-400">
                          <%= new Date(r.createdAt).toLocaleDateString('en-IN') %>
                        </p>
                      </div>
                      <div class="text-right">
                        <p class="text-sm font-bold text-slate-800">
                          <%= r.score %> / <%= r.totalMarks %>
                        </p>
                        <p class="text-xs text-slate-400">
                          <%= r.totalMarks> 0 ? ((r.score/r.totalMarks)*100).toFixed(1) : 0 %>%
                        </p>
                      </div>
                      <span
                        class="text-[11px] font-semibold px-2 py-1 rounded-full <%= r.status === 'auto_submitted' ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-700' %>">
                        <%= r.status==='auto_submitted' ? 'Auto' : 'Done' %>
                      </span>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                  <p class="text-sm text-slate-400">No exam results yet.</p>
                  <% } %>
            </div>
        </div>
      </main>
  </div>

  <!-- Delete Student Modal -->
  <div id="deleteStudentModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 text-center">
      <div class="w-14 h-14 bg-rose-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>
      <h3 class="font-bold text-slate-900 mb-1.5">Delete Student?</h3>
      <p class="text-sm text-slate-500 mb-5">This will deactivate <strong>
          <%= student.name %>
        </strong>. They will be removed from all batches and unable to log in.</p>
      <form action="/admin/students/<%= student._id || student.id %>/delete" method="POST" class="flex gap-3">
        <button type="submit"
          class="flex-1 bg-rose-600 text-white font-semibold py-3 rounded-xl hover:bg-rose-700 transition-colors">Yes,
          Delete</button>
        <button type="button" onclick="document.getElementById('deleteStudentModal').classList.add('hidden')"
          class="flex-1 border border-slate-200 text-slate-700 font-semibold py-3 rounded-xl hover:bg-slate-50">Cancel</button>
      </form>
    </div>
  </div>
  </body>

  </html>