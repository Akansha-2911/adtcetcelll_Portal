<%- include('../partials/head') %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 min-w-0 bg-[#f7f9fb]">
    <header class="spvn-ui-topbar sticky top-0 z-10 px-5 lg:px-8">
      <div class="flex items-center gap-4">
        <button onclick="openSidebar()" class="lg:hidden text-slate-500"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        <nav class="spvn-ui-topnav flex-1"><a href="/admin/groups">Organization</a><a href="/admin/tests" class="active">Test Management</a><a href="/admin/results">Reports</a><a href="/admin/results">Analytics</a><a href="/admin/tests?view=online">Monitor</a><a href="/admin/questions" class="active">Question Bank</a></nav>
      </div>
    </header>
    <div class="p-5 lg:p-8 max-w-6xl mx-auto">
      <%- include('../partials/flash') %>

      <div class="spvn-ui-panel p-5 lg:p-6 mb-6">

        <div class="relative max-w-3xl">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <a href="/admin/questions" class="inline-flex items-center gap-1 text-xs font-bold text-sky-700 hover:text-sky-900">← Question Bank</a>
            <span class="text-slate-300">/</span>
            <span class="inline-flex items-center gap-1.5 bg-sky-50 border border-sky-100 text-sky-700 rounded px-2.5 py-1 text-xs font-semibold">Upload Questions</span>
          </div>
          <h2 class="spvn-ui-heading mb-2">Upload Question Paper — Smart Scan</h2>
          <p class="text-slate-500 text-sm leading-relaxed">Upload the question paper first and optionally the answer/solution file. SPVN extracts questions, opens Review and saves approved questions into Question Bank.</p>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-5 text-xs">
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-3"><strong class="block text-slate-700 mb-1">1–100+ per page</strong><span class="text-slate-500">Block-based detection</span></div>
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-3"><strong class="block text-slate-700 mb-1">Handwriting</strong><span class="text-slate-500">High-detail vision</span></div>
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-3"><strong class="block text-slate-700 mb-1">Answer keys</strong><span class="text-slate-500">Cross-file matching</span></div>
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-3"><strong class="block text-slate-700 mb-1">Question Bank next</strong><span class="text-slate-500">review before save</span></div>
          </div>
        </div>
      </div>

      <% if (!aiEnabled) { %>
      <div class="mb-6 bg-amber-50 border border-amber-300 rounded-xl p-4 flex items-start gap-3">
        <span class="text-xl">⚠️</span>
        <div>
          <p class="text-sm font-bold text-amber-900">AI scanner is not configured</p>
          <p class="text-xs text-amber-800 mt-1">Standard CSV/Excel imports work now. Add <code class="bg-amber-100 px-1.5 py-0.5 rounded">GEMINI_API_KEY</code> or <code class="bg-amber-100 px-1.5 py-0.5 rounded">OPENAI_API_KEY</code> to <code class="bg-amber-100 px-1.5 py-0.5 rounded">.env</code> and restart the server to scan PDF, Word and handwritten images.</p>
        </div>
      </div>
      <% } %>

      <form action="/admin/questions/smart-import/scan" method="POST" enctype="multipart/form-data" id="scanForm" class="grid grid-cols-1 lg:grid-cols-3 gap-6" onsubmit="return beginScan()">
        <section class="lg:col-span-2 bg-white border border-slate-200 rounded-2xl shadow-sm p-5 lg:p-6">
          <div class="flex items-center justify-between gap-3 mb-4">
            <div>
              <h3 class="font-bold text-slate-900">1. Upload question paper / solution</h3>
              <p class="text-xs text-slate-500 mt-1">Question paper, answer key, or both together</p>
            </div>
            <span class="text-[11px] text-slate-500 bg-slate-100 rounded-full px-3 py-1">Max <%= maxFiles %> files / <%= maxTotalSizeMb %> MB</span>
          </div>

          <label id="dropZone" class="block border-2 border-dashed border-slate-300 hover:border-indigo-400 hover:bg-indigo-50/50 rounded-2xl p-8 lg:p-12 text-center cursor-pointer transition-colors">
            <span class="mx-auto w-14 h-14 rounded-2xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-2xl mb-4">↑</span>
            <span class="block font-bold text-slate-900">Drop files here or click to browse</span>
            <span class="block text-xs text-slate-500 mt-2">PDF · DOC/DOCX · CSV/XLS/XLSX · JPG/PNG/WEBP/HEIC · TXT/RTF/ODT</span>
            <input id="questionFiles" type="file" name="questionFiles" multiple required
              accept=".pdf,.doc,.docx,.rtf,.odt,.txt,.md,.csv,.xls,.xlsx,.jpg,.jpeg,.png,.webp,.gif,.heic,.heif,.tif,.tiff,.bmp"
              class="sr-only" onchange="showFiles(this.files)"/>
          </label>

          <div id="fileList" class="hidden mt-4 space-y-2"></div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-5">
            <div class="rounded-xl border border-slate-200 p-3">
              <p class="text-sm font-semibold text-slate-800">📄 Typed documents</p>
              <p class="text-xs text-slate-500 mt-1">PDF and Word text, including multi-page papers.</p>
            </div>
            <div class="rounded-xl border border-slate-200 p-3">
              <p class="text-sm font-semibold text-slate-800">✍️ Handwritten photos</p>
              <p class="text-xs text-slate-500 mt-1">Use a sharp, straight photo with good lighting.</p>
            </div>
            <div class="rounded-xl border border-slate-200 p-3">
              <p class="text-sm font-semibold text-slate-800">📊 Structured sheets</p>
              <p class="text-xs text-slate-500 mt-1">CSV/Excel uses fast deterministic parsing.</p>
            </div>
          </div>
        </section>

        <aside class="bg-white border border-slate-200 rounded-2xl shadow-sm p-5 lg:p-6 h-fit">
          <div class="mb-5">
            <h3 class="font-bold text-slate-900">2. Question classification</h3>
            <p class="text-xs text-slate-500 mt-1">Choose the default course, subject and marks before scanning. Topic and subtopic are optional and can be corrected again on Review.</p>
          </div>

          <div class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1.5">Course <span class="text-rose-500">*</span></label>
              <select id="scanCourse" name="course" required class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm">
                <% COURSES.forEach(course => { %>
                  <option value="<%= course %>" <%= course === 'CET' ? 'selected' : '' %>><%= course %></option>
                <% }) %>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1.5">Subject <span class="text-rose-500">*</span></label>
              <select id="scanSubject" name="subject" required class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"></select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Topic <span class="font-normal text-slate-400">(optional)</span></label>
                <input name="topic" type="text" placeholder="e.g. Algebra" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Subtopic <span class="font-normal text-slate-400">(optional)</span></label>
                <input name="subtopic" type="text" placeholder="e.g. Quadratic Equations" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Difficulty</label>
                <select name="difficulty" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm">
                  <option>Easy</option>
                  <option selected>Medium</option>
                  <option>Hard</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Marks <span class="text-rose-500">*</span></label>
                <input name="marks" type="number" value="1" min="0.25" max="100" step="0.25" required class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
              </div>
            </div>
          </div>

          <button id="scanButton" type="submit" class="w-full mt-6 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition-colors flex items-center justify-center gap-2">
            <span>✨</span> Scan Paper &amp; Review
          </button>
          <p class="text-[11px] leading-relaxed text-slate-400 mt-3 text-center">After scanning, review Course, Subject, Topic/Subtopic, Marks and answers before saving to Question Bank.</p>
        </aside>
      </form>
    </div>
  </main>
</div>

<div id="scanOverlay" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-6">
  <div class="bg-white rounded-2xl p-7 max-w-sm w-full text-center shadow-2xl">
    <div class="w-14 h-14 border-4 border-indigo-100 border-t-indigo-600 rounded-full animate-spin mx-auto mb-5"></div>
    <h3 class="font-bold text-slate-900 text-lg">Scanning every question…</h3>
    <p class="text-sm text-slate-500 mt-2">Large PDFs and handwriting can take a few minutes. Keep this page open.</p>
    <div class="mt-5 bg-slate-100 rounded-full h-1.5 overflow-hidden"><div class="h-full bg-indigo-600 animate-pulse w-2/3 rounded-full"></div></div>
  </div>
</div>

<script>
const input = document.getElementById('questionFiles');
const dropZone = document.getElementById('dropZone');
const scanCourse = document.getElementById('scanCourse');
const scanSubject = document.getElementById('scanSubject');
const subjectsByCourse = {
  JEE: ['Physics','Chemistry','Mathematics'],
  CET: ['Physics','Chemistry','Mathematics','Biology'],
  NEET: ['Physics','Chemistry','Biology']
};

function refreshScanSubjects() {
  const subjects = subjectsByCourse[scanCourse.value] || [];
  const previous = scanSubject.value;
  scanSubject.innerHTML = '';
  subjects.forEach(subject => {
    const option = document.createElement('option');
    option.value = subject;
    option.textContent = subject;
    scanSubject.appendChild(option);
  });
  if (subjects.includes(previous)) scanSubject.value = previous;
}

scanCourse.addEventListener('change', refreshScanSubjects);
refreshScanSubjects();

function formatBytes(bytes) {
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

function showFiles(files) {
  const list = document.getElementById('fileList');
  if (!files.length) {
    list.classList.add('hidden');
    list.innerHTML = '';
    return;
  }
  list.classList.remove('hidden');
  list.innerHTML = Array.from(files).map((file, index) => `
    <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5">
      <span class="w-7 h-7 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-xs font-bold text-indigo-600">${index + 1}</span>
      <span class="text-sm text-slate-700 truncate flex-1">${escapeHtml(file.name)}</span>
      <span class="text-xs text-slate-400">${formatBytes(file.size)}</span>
    </div>`).join('');
}

function escapeHtml(value) {
  const node = document.createElement('div');
  node.textContent = value;
  return node.innerHTML;
}

['dragenter','dragover'].forEach(eventName => dropZone.addEventListener(eventName, event => {
  event.preventDefault();
  dropZone.classList.add('border-indigo-500','bg-indigo-50');
}));
['dragleave','drop'].forEach(eventName => dropZone.addEventListener(eventName, event => {
  event.preventDefault();
  dropZone.classList.remove('border-indigo-500','bg-indigo-50');
}));
dropZone.addEventListener('drop', event => {
  input.files = event.dataTransfer.files;
  showFiles(input.files);
});

function beginScan() {
  const files = Array.from(input.files);
  if (!files.length) return false;
  if (files.length > <%= maxFiles %>) {
    alert('Choose a maximum of <%= maxFiles %> files.');
    return false;
  }
  const total = files.reduce((sum, file) => sum + file.size, 0);
  if (total > <%= maxTotalSizeMb %> * 1024 * 1024) {
    alert('Combined file size must be below <%= maxTotalSizeMb %> MB.');
    return false;
  }
  document.getElementById('scanButton').disabled = true;
  document.getElementById('scanOverlay').classList.remove('hidden');
  return true;
}
</script>
