<!DOCTYPE html><html lang="en"><head><%- include('../partials/head',{title}) %></head><body class="bg-slate-50"><div class="min-h-screen flex"><%- include('../partials/sidebar-admin') %><main class="lg:ml-64 flex-1 min-w-0"><header class="spvn-ui-topbar sticky top-0 z-10 px-5 lg:px-8"><nav class="spvn-ui-topnav"><a href="/admin/tests" class="active">Test Management</a><a href="/admin/results">Reports</a><a href="/admin/analytics">Analytics</a><a href="/admin/monitor">Monitor</a></nav></header><%- include('../partials/test-management-tabs',{activeTab:'upload'}) %><div class="p-5 lg:p-8 max-w-5xl mx-auto"><%- include('../partials/flash') %><div class="mb-5"><p class="spvn-kicker">UPLOAD TEST</p><h1 class="spvn-ui-heading">Draft Details</h1><p class="text-sm text-slate-700 mt-1">Add only the basic identity of this Draft. Final duration, schedule, password and batch assignment are entered later from Test Details before publishing.</p></div><div class="grid md:grid-cols-3 gap-3 mb-5"><div class="spvn-ui-panel p-4"><p class="text-xs text-slate-600">Questions</p><p class="text-2xl font-bold text-slate-950"><%= questionCount %></p></div><div class="spvn-ui-panel p-4"><p class="text-xs text-slate-600">Current Marks</p><p class="text-2xl font-bold text-slate-950"><%= totalMarks %></p></div><div class="spvn-ui-panel p-4"><p class="text-xs text-slate-600">Duplicates Reused</p><p class="text-2xl font-bold text-amber-700"><%= uploadSession.duplicateCount %></p></div></div><form method="POST" action="/admin/tests/upload-test/<%= uploadSession._id %>/create" class="spvn-ui-panel p-6 space-y-5"><div class="grid md:grid-cols-2 gap-4"><div class="md:col-span-2"><label class="spvn-ui-form-label">Draft Test Name *</label><input name="title" required class="spvn-ui-filter text-slate-950" placeholder="e.g. Physics Uploaded Test Draft"></div><div><label class="spvn-ui-form-label">Course</label><select name="course" class="spvn-ui-filter"><option value="">Select Course</option><% (COURSES||[]).forEach(c=>{ %><option value="<%= c %>"><%= c %></option><% }) %></select></div><div><label class="spvn-ui-form-label">Subject</label><select name="subject" class="spvn-ui-filter"><option value="">Select Subject</option><% ['Physics','Chemistry','Mathematics','Biology'].forEach(s=>{ %><option value="<%= s %>" <%= uploadSession.defaultSubject===s?'selected':'' %>><%= s %></option><% }) %></select></div><div><label class="spvn-ui-form-label">Test Type</label><select name="testType" class="spvn-ui-filter"><option>Mock Test</option><option>Chapter Test</option><option>Unit Test</option><option>Practice Test</option><option>Subject Test</option></select></div><div><label class="spvn-ui-form-label">Topic <span class="font-normal text-slate-500">(optional)</span></label><input name="topic" value="<%= uploadSession.defaultTopic||'' %>" class="spvn-ui-filter"></div><div class="md:col-span-2"><label class="spvn-ui-form-label">Description <span class="font-normal text-slate-500">(optional)</span></label><textarea name="description" rows="3" class="spvn-ui-filter"></textarea></div></div><input type="hidden" name="duration" value="180"><input type="hidden" name="negativeMarking" value="0"><input type="hidden" name="testPattern" value="BASIC"><input type="hidden" name="rankSchema" value="Scheme 1"><div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-950"><strong>Next:</strong> set the marking scheme. After that, the test returns to the Tests list as <strong>Draft</strong>. It is not visible to students until you explicitly publish it.</div><div class="flex justify-between gap-3"><a href="/admin/tests/upload-test/review/<%= uploadSession._id %>" class="spvn-ui-btn spvn-ui-btn-soft">← Back to Review</a><button class="spvn-ui-btn spvn-ui-btn-primary">Next: Marking Scheme →</button></div></form></div></main></div></body></html>