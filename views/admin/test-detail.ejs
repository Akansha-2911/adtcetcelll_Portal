<%- include('../partials/head') %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 min-h-screen">
    <header class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4">
      <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800 mr-3 shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/admin/tests" class="text-slate-400 hover:text-slate-600">←</a>
          <div>
            <h1 class="text-lg font-bold text-slate-900"><%= test.title %></h1>
            <p class="text-sm text-slate-500"><%= test.duration %> mins · <%= test.totalMarks %> marks<% if(test.course){%> · <%= test.course %><% } %><% if(test.subject){%> / <%= test.subject %><% } %></p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xs px-3 py-1.5 rounded-full font-semibold
            <%= test.status==='published'?'bg-green-100 text-green-700':test.status==='draft'?'bg-slate-100 text-slate-600':'bg-blue-100 text-blue-700' %>">
            <%= test.status.toUpperCase() %>
          </span>
          <% if(test.status==='draft') { %>
            <a href="/admin/tests/<%= test.id %>/publish-setup" class="inline-flex items-center gap-1.5 bg-emerald-600 text-white px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold hover:bg-emerald-700 shadow-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <span>Test Details &amp; Publish</span>
            </a>
          <% } %>
          <a href="/admin/tests/<%= test.id %>/pdf-answers" target="_blank" class="inline-flex items-center gap-1.5 bg-emerald-600 text-white px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold hover:bg-emerald-700 shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>PDF with Answers</span>
          </a>
          <a href="/admin/tests/<%= test.id %>/pdf-answers?format=word" target="_blank" class="inline-flex items-center gap-1.5 bg-blue-600 text-white px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold hover:bg-blue-700 shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Word with Answers</span>
          </a>
          <a href="/admin/tests/<%= test.id %>/marking-template" class="inline-flex items-center gap-1.5 bg-sky-50 text-sky-700 border border-sky-200 px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold hover:bg-sky-100 shadow-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            <span>Marking Scheme</span>
          </a>
          <% if(test.status!=='draft') { %>
            <button type="button" onclick="document.getElementById('assignBatchModal').classList.remove('hidden')" class="inline-flex items-center gap-1.5 bg-indigo-50 text-indigo-700 border border-indigo-200 px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold hover:bg-indigo-100 shadow-xs">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              <span>Assign Batches</span>
            </button>
          <% } %>
          <a href="/admin/tests/<%= test.id %>/edit" class="inline-flex items-center gap-1.5 border border-slate-200 text-slate-700 px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold hover:bg-slate-50 shadow-xs">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            <span>Edit</span>
          </a>
          <button onclick="document.getElementById('deleteTestModal').classList.remove('hidden')" class="inline-flex items-center gap-1.5 bg-rose-50 text-rose-600 border border-rose-200 px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold hover:bg-rose-100 shadow-xs">
            <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            <span>Delete</span>
          </button>
          <a href="/results/leaderboard/<%= test.id %>" class="inline-flex items-center gap-1.5 bg-slate-950 text-white px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold hover:bg-slate-800 shadow-sm">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span>Leaderboard</span>
          </a>
        </div>
      </div>
    </header>
    <div class="p-5 lg:p-8">
      <%- include('../partials/flash') %>
      <!-- Stats -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <% [{icon:'❓',label:'Questions',val:test.questions.length},{icon:'⏱',label:'Duration',val:test.duration+' min'},{icon:'👨‍🎓',label:'Attempts',val:results.length},{icon:'📊',label:'Avg Score',val:results.length?(results.reduce((s,r)=>s+r.score,0)/results.length).toFixed(1)+'/'+test.totalMarks:'N/A'}].forEach(c=>{ %>
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
          <p class="text-xl mb-2"><%= c.icon %></p>
          <p class="text-xl font-bold text-slate-900"><%= c.val %></p>
          <p class="text-xs text-slate-500 mt-0.5"><%= c.label %></p>
        </div>
        <% }) %>
      </div>

      <!-- Anti-cheat settings badge row -->
      <div class="flex flex-wrap gap-3 mb-6">
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm">
          <span class="text-base">🔒</span>
          <span class="text-slate-600 font-medium">Auto-Submit on Violation:</span>
          <% if (test.autoSubmitOnViolation) { %>
          <span class="bg-red-100 text-red-700 font-semibold px-2 py-0.5 rounded-full text-xs">ON — after <%= test.maxTabSwitches || 3 %> tab switches</span>
          <% } else { %>
          <span class="bg-slate-100 text-slate-500 font-semibold px-2 py-0.5 rounded-full text-xs">OFF (log only)</span>
          <% } %>
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm">
          <span class="text-base"><%= test.blockCopyPaste !== false ? '🚫' : '✅' %></span>
          <span class="text-slate-600"><%= test.blockCopyPaste !== false ? 'Copy/Paste Blocked' : 'Copy/Paste Allowed' %></span>
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm">
          <span class="text-base"><%= test.requireFullscreen ? '🖥' : '📱' %></span>
          <span class="text-slate-600"><%= test.requireFullscreen ? 'Fullscreen Required' : 'Fullscreen Optional' %></span>
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm">
          <span class="text-base">⚠</span>
          <span class="text-slate-600">Max Tab Switches: <strong class="text-red-600"><%= test.maxTabSwitches || 3 %></strong></span>
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm">
          <span class="text-base">👁</span>
          <span class="text-slate-600">Max Focus Losses: <strong class="text-orange-600"><%= test.maxFocusLosses || 5 %></strong></span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Questions list -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="px-5 py-4 border-b bg-slate-50"><h3 class="font-semibold text-slate-900 text-sm">Questions (<%= test.questions.length %>)</h3></div>
          <div class="divide-y divide-slate-100 max-h-96 overflow-y-auto">
            <% test.questions.forEach((q,i) => { %>
            <div class="px-5 py-3 hover:bg-slate-50">
              <p class="math-clamp-2 text-xs text-slate-800 leading-snug"><span><%= i+1 %>.</span> <span class="math-content"><%= q.question %></span></p>
              <div class="flex gap-2 mt-1">
                <span class="text-xs bg-green-100 text-green-700 px-1.5 py-0.5 rounded">Ans: <%= q.correctAnswer %></span>
                <span class="text-xs text-slate-400"><%= q.subject %></span>
              </div>
            </div>
            <% }) %>
          </div>
        </div>

        <!-- Results -->
        <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b flex items-center justify-between">
            <h3 class="font-semibold text-slate-900">Student Results</h3>
            <a href="/admin/results/export?testId=<%= test.id %>" class="text-xs text-navy-600 hover:underline font-medium">Export This Test to Excel</a>
          </div>
          <% if (!results.length) { %>
          <p class="px-6 py-12 text-center text-slate-400">No submissions yet.</p>
          <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-xs sm:text-sm">
              <thead class="bg-slate-50 text-xs text-slate-500 uppercase tracking-wider">
                <tr><th class="px-5 py-3 text-left">Rank</th><th class="px-5 py-3 text-left">Student</th><th class="px-5 py-3 text-left">Physics</th><th class="px-5 py-3 text-left">Chemistry</th><th class="px-5 py-3 text-left">Mathematics</th><th class="px-5 py-3 text-left">Total</th><th class="px-5 py-3 text-left">%</th><th class="px-5 py-3 text-left">Action</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% results.forEach((r,i) => { const pct=r.totalMarks>0?((r.score/r.totalMarks)*100).toFixed(1):0 %>
                <tr class="hover:bg-slate-50">
                  <td class="px-5 py-3"><%= i===0?'🥇':i===1?'🥈':i===2?'🥉':'#'+(i+1) %></td>
                  <td class="px-5 py-3"><p class="font-medium"><%= r.student?.name %></p><p class="text-xs text-slate-400"><%= r.student?.rollNo %></p></td>
                  <% ['Physics','Chemistry','Mathematics'].forEach(subject => { const subjectResult=r.subjectScores?.[subject]; %>
                  <td class="px-5 py-3 text-xs font-semibold <%= subjectResult?.status==='ABSENT'?'text-rose-600':'text-slate-600' %>"><%= subjectResult?.status==='ABSENT'?'ABSENT':subjectResult?`${subjectResult.marks||0}/${subjectResult.total||0}`:'—' %></td>
                  <% }) %>
                  <td class="px-5 py-3 font-bold"><%= r.score %>/<%= r.totalMarks %></td>
                  <td class="px-5 py-3 font-semibold <%= pct>=60?'text-green-600':pct>=40?'text-yellow-600':'text-red-500' %>"><%= pct %>%</td>
                  <td class="px-5 py-3"><a href="/results/<%= r.id %>" class="text-navy-600 hover:underline text-xs font-medium">View</a></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>

<div id="assignBatchModal" class="hidden fixed inset-0 bg-slate-950/60 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden">
    <div class="px-6 py-5 border-b flex items-center justify-between"><div><h3 class="font-bold text-slate-900">Assign test to batches</h3><p class="text-xs text-slate-500 mt-1">Test Name: <%= test.title %></p></div><button type="button" onclick="document.getElementById('assignBatchModal').classList.add('hidden')" class="text-slate-400 text-xl">×</button></div>
    <form action="/admin/tests/<%= test.id %>/assign-batches" method="POST" class="p-6">
      <label class="block text-sm font-semibold text-slate-700 mb-2">Select Batch</label>
      <div class="border rounded-xl max-h-64 overflow-y-auto divide-y"><% const assignedIds=(test.groups||[]).map(g=>String(g._id||g)); groups.forEach(g=>{ %><label class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50 cursor-pointer"><input type="checkbox" name="groupIds" value="<%= g._id %>" <%= assignedIds.includes(String(g._id))?'checked':'' %> class="rounded"/><div><p class="text-sm font-medium text-slate-800"><%= g.name %></p><p class="text-xs text-slate-400"><%= g.course || 'CET' %></p></div></label><% }) %></div>
      <label class="flex items-center gap-2 mt-4 text-sm text-slate-700"><input type="checkbox" name="notifyStudents" checked class="rounded"/> Notify students in assigned batches</label>
      <div class="flex justify-end gap-3 mt-6"><button type="button" onclick="document.getElementById('assignBatchModal').classList.add('hidden')" class="px-5 py-2.5 border rounded-lg font-semibold text-sm">Cancel</button><button class="px-5 py-2.5 bg-sky-600 text-white rounded-lg font-semibold text-sm">Assign Test</button></div>
    </form>
  </div>
</div>
<!-- Delete Test Modal -->
<div id="deleteTestModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 text-center">
    <div class="w-14 h-14 bg-rose-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    </div>
    <h3 class="font-bold text-slate-900 mb-1.5">Delete this test?</h3>
    <p class="text-sm text-slate-500 mb-5">This cannot be undone. Existing results will remain.</p>
    <form action="/admin/tests/<%= test.id %>/delete" method="POST" class="flex gap-3">
      <button type="submit" class="flex-1 bg-rose-600 text-white font-semibold py-3 rounded-xl hover:bg-rose-700">Yes, Delete</button>
      <button type="button" onclick="document.getElementById('deleteTestModal').classList.add('hidden')" class="flex-1 border border-slate-200 text-slate-700 font-semibold py-3 rounded-xl hover:bg-slate-50">Cancel</button>
    </form>
  </div>
</div>
</body></html>
