<%- include('../partials/head') %>
<div class="flex min-h-screen"><%- include('../partials/sidebar-admin') %><main class="lg:ml-64 flex-1 min-h-screen bg-slate-50">
<header class="sticky top-0 z-20 bg-white border-b px-8 py-4 flex justify-between items-center"><div><p class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Analytics</p><h1 class="text-xl font-bold">Question-wise Analysis</h1></div><a href="/admin/results?testId=<%= test._id %>" class="border rounded-xl px-4 py-2 text-sm font-semibold">Back</a></header>
<div class="p-8"><div class="mb-5"><h2 class="text-xl font-bold"><%= test.title %></h2><p class="text-sm text-slate-500">Difficulty, attempt rate, answer distribution and accuracy for every question.</p></div>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6"><% [['Student Attempts',summary.totalAttempts],['Questions',summary.totalQuestions],['Average Accuracy',summary.avgAccuracy.toFixed(1)+'%'],['Toughest Question',summary.toughest?'Q'+summary.toughest.number:'—']].forEach(c=>{ %><div class="bg-white border rounded-2xl p-5"><div class="text-xs uppercase font-semibold text-slate-400"><%= c[0] %></div><div class="text-2xl font-bold mt-2"><%= c[1] %></div></div><% }) %></div>
<div class="space-y-4"><% rows.forEach(q=>{ %><div class="bg-white border rounded-2xl p-5 shadow-sm"><div class="flex flex-col lg:flex-row lg:justify-between gap-4"><div class="max-w-3xl"><div class="flex gap-2 items-center mb-2"><span class="bg-slate-900 text-white text-xs font-bold px-2.5 py-1 rounded-lg">Q<%= q.number %></span><span class="text-xs font-semibold text-slate-500"><%= q.subject %> · <%= q.topic || 'General' %> · <%= q.difficulty %></span></div><p class="math-content font-semibold text-slate-800"><%= q.question %></p></div><div class="grid grid-cols-3 gap-3 min-w-[330px]"><div class="bg-blue-50 rounded-xl p-3"><div class="text-xs text-blue-500">Attempt Rate</div><b><%= q.attemptRate.toFixed(1) %>%</b></div><div class="bg-emerald-50 rounded-xl p-3"><div class="text-xs text-emerald-600">Accuracy</div><b><%= q.accuracy.toFixed(1) %>%</b></div><div class="bg-rose-50 rounded-xl p-3"><div class="text-xs text-rose-500">Wrong</div><b><%= q.wrong %></b></div></div></div><div class="grid grid-cols-2 md:grid-cols-4 gap-2 mt-4"><% ['A','B','C','D'].forEach(o=>{ const n=q.optionCounts[o]||0; const pct=q.attempted?(n/q.attempted)*100:0; %><div class="border rounded-xl p-3 <%= o===q.correctAnswer?'border-emerald-300 bg-emerald-50':'' %>"><div class="flex justify-between text-xs"><b><%= o %> <%= o===q.correctAnswer?'✓':'' %></b><span><%= n %> (<%= pct.toFixed(0) %>%)</span></div><div class="h-1.5 bg-slate-100 rounded mt-2 overflow-hidden"><div class="h-full bg-slate-700" style="width:<%= pct %>%"></div></div></div><% }) %></div></div><% }) %>
<% if(!rows.length){ %><div class="bg-white border rounded-2xl p-12 text-center text-slate-400">No questions found in this test.</div><% } %></div></div></main></div></body></html>
