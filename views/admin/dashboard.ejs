<%- include('../partials/head') %>

<div class="flex min-h-screen">

  <%- include('../partials/sidebar-admin') %>

  <main class="lg:ml-64 flex-1 min-w-0 min-h-screen bg-slate-50">

    <!-- TOP BAR -->
    <header class="spvn-topbar sticky top-0 z-10 px-5 lg:px-8 py-4 flex items-center gap-4">

      <button
        onclick="openSidebar()"
        class="lg:hidden text-slate-500 hover:text-slate-800"
        type="button"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>

      <div class="flex-1 min-w-0">

        <h1 class="spvn-page-title leading-tight">
          Admin Dashboard
        </h1>

        <p class="text-xs text-slate-500 hidden sm:block">
          <%= collegeName %>
          &middot;
          AY <%= academicYear %>
        </p>

      </div>

      <span class="text-xs text-slate-500 hidden md:block">
        <%= new Date().toLocaleDateString(
          'en-IN',
          {
            weekday:'long',
            day:'numeric',
            month:'short',
            year:'numeric'
          }
        ) %>
      </span>

    </header>


    <div class="p-5 lg:p-8 spvn-page">

      <%- include('../partials/flash') %>


      <!-- =================================================
           HERO
      ================================================== -->

      <section
        class="mb-6 overflow-hidden rounded-2xl border border-sky-100 bg-white shadow-card"
      >

        <div class="grid lg:grid-cols-[1.4fr_.6fr]">

          <div class="p-5 lg:p-7">

            <p class="spvn-kicker mb-2">
              SPVN CET Control Center
            </p>

            <h2
              class="text-xl lg:text-2xl font-extrabold text-slate-950 tracking-tight"
            >
              Manage tests, students and performance from one workspace.
            </h2>

            <p
              class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed"
            >
              Manage exam operations, students, question banks,
              test publishing, live monitoring and analytics.
            </p>


            <!-- FIXED BUTTONS -->

            <div class="spvn-action-row mt-5">

              <a
                href="/admin/tests/create"
                class="spvn-action-btn spvn-action-green"
              >
                <span class="text-lg leading-none">+</span>
                Create Test
              </a>


              <a
                href="/admin/questions"
                class="spvn-action-btn spvn-action-soft-blue"
              >
                Question Bank
              </a>


              <a
                href="/admin/monitor"
                class="spvn-action-btn spvn-action-soft-blue"
              >
                Live Monitor
              </a>


              <a
                href="/admin/analytics"
                class="spvn-action-btn spvn-action-soft-blue"
              >
                Analytics
              </a>

            </div>

          </div>


          <!-- ACADEMIC YEAR -->

          <div
            class="hidden lg:flex items-center justify-center p-6
                   bg-gradient-to-br from-sky-50 to-blue-100/60
                   border-l border-sky-100"
          >

            <div
              class="w-full max-w-[230px] rounded-2xl
                     bg-white border border-slate-200
                     p-5 shadow-sm"
            >

              <p class="text-xs font-bold text-slate-600">
                Academic Year
              </p>

              <p class="mt-1 text-3xl font-black text-slate-900">
                <%= academicYear %>
              </p>

              <p class="mt-3 text-xs text-slate-600">
                <%= collegeShort %> Examination Portal
              </p>

            </div>

          </div>

        </div>

      </section>


      <!-- =================================================
           STATS
      ================================================== -->

      <div
        class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-8"
      >


        <!-- STUDENTS -->

        <a
          href="/admin/students"
          class="card-lift spvn-stat p-5 block group"
        >

          <div class="flex items-start justify-between mb-4">

            <div
              class="w-11 h-11 rounded-xl bg-blue-50
                     text-blue-700 flex items-center justify-center"
            >

              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17 20H3v-1a6 6 0 0114 0v1zm7 0h-3v-1a4.5 4.5 0 00-3.21-4.3M15 7a4 4 0 11-8 0 4 4 0 018 0z"
                />
              </svg>

            </div>

            <span class="text-slate-300 group-hover:text-slate-500">
              →
            </span>

          </div>

          <p class="text-3xl font-black text-slate-900">
            <%= stats && stats.studentCount != null
              ? stats.studentCount
              : 0
            %>
          </p>

          <p class="text-sm text-slate-600 mt-1 font-semibold">
            Total Students
          </p>

        </a>


        <!-- TESTS -->

        <a
          href="/admin/tests"
          class="card-lift spvn-stat p-5 block group"
        >

          <div class="flex items-start justify-between mb-4">

            <div
              class="w-11 h-11 rounded-xl bg-indigo-50
                     text-indigo-700 flex items-center justify-center"
            >

              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2"
                />
              </svg>

            </div>

            <span class="text-slate-300 group-hover:text-slate-500">
              →
            </span>

          </div>

          <p class="text-3xl font-black text-slate-900">
            <%= stats && stats.testCount != null
              ? stats.testCount
              : 0
            %>
          </p>

          <p class="text-sm text-slate-600 mt-1 font-semibold">
            Tests
          </p>

        </a>


        <!-- QUESTIONS -->

        <a
          href="/admin/questions"
          class="card-lift spvn-stat p-5 block group"
        >

          <div class="flex items-start justify-between mb-4">

            <div
              class="w-11 h-11 rounded-xl bg-violet-50
                     text-violet-700 flex items-center justify-center"
            >

              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907M12 17h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>

            </div>

            <span class="text-slate-300 group-hover:text-slate-500">
              →
            </span>

          </div>

          <p class="text-3xl font-black text-slate-900">
            <%= stats && stats.questionCount != null
              ? stats.questionCount
              : 0
            %>
          </p>

          <p class="text-sm text-slate-600 mt-1 font-semibold">
            Question Bank
          </p>

        </a>


        <!-- GROUPS -->

        <a
          href="/admin/groups"
          class="card-lift spvn-stat p-5 block group"
        >

          <div class="flex items-start justify-between mb-4">

            <div
              class="w-11 h-11 rounded-xl bg-emerald-50
                     text-emerald-700 flex items-center justify-center"
            >

              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2"
                />
              </svg>

            </div>

            <span class="text-slate-300 group-hover:text-slate-500">
              →
            </span>

          </div>

          <p class="text-3xl font-black text-slate-900">
            <%= stats && stats.groupCount != null
              ? stats.groupCount
              : 0
            %>
          </p>

          <p class="text-sm text-slate-600 mt-1 font-semibold">
            Groups &amp; Batches
          </p>

        </a>


      </div>


      <!-- =================================================
           RECENT DATA
      ================================================== -->

      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6"
      >


        <!-- RESULTS -->

        <section
          class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden"
        >

          <div
            class="flex items-center justify-between px-6 py-4 border-b border-slate-200"
          >

            <h3 class="font-extrabold text-slate-900 text-sm">
              Recent Results
            </h3>

            <a
              href="/admin/results"
              class="text-xs text-sky-700 hover:text-sky-900 font-bold"
            >
              View all →
            </a>

          </div>


          <% if (!recentResults || recentResults.length === 0) { %>

            <div class="py-12 text-center">

              <p class="text-sm text-slate-500">
                No results yet.
              </p>

            </div>

          <% } else { %>

            <ul class="divide-y divide-slate-100">

              <% recentResults.slice(0,6).forEach(function(result){ %>

                <%
                  var resultTotal =
                    Number(result.totalMarks || 0);

                  var resultScore =
                    Number(result.score || 0);

                  var resultPercentage =
                    resultTotal > 0
                      ? Math.round(
                          resultScore /
                          resultTotal *
                          100
                        )
                      : 0;
                %>

                <li
                  class="flex items-center gap-3 px-6 py-3.5 hover:bg-slate-50"
                >

                  <div
                    class="w-9 h-9 rounded-full bg-slate-100
                           flex items-center justify-center
                           text-slate-700 font-bold text-xs shrink-0"
                  >

                    <% if (result.student && result.student.name) { %>

                      <%= result.student.name.charAt(0).toUpperCase() %>

                    <% } else { %>

                      ?

                    <% } %>

                  </div>


                  <div class="flex-1 min-w-0">

                    <p
                      class="text-sm font-bold text-slate-900 truncate"
                    >

                      <%= result.student && result.student.name
                        ? result.student.name
                        : 'Student'
                      %>

                    </p>


                    <p
                      class="text-xs text-slate-500 truncate"
                    >

                      <%= result.test && result.test.title
                        ? result.test.title
                        : 'Test'
                      %>

                    </p>

                  </div>


                  <div class="text-right shrink-0">

                    <p
                      class="text-sm font-black text-sky-700"
                    >
                      <%= resultPercentage %>%
                    </p>

                    <p class="text-xs text-slate-500">

                      <%= resultScore %>/<%= resultTotal %>

                    </p>

                  </div>

                </li>

              <% }); %>

            </ul>

          <% } %>

        </section>


        <!-- STUDENTS -->

        <section
          class="bg-white rounded-2xl border border-slate-200 shadow-card overflow-hidden"
        >

          <div
            class="flex items-center justify-between px-6 py-4 border-b border-slate-200"
          >

            <h3 class="font-extrabold text-slate-900 text-sm">
              Recent Students
            </h3>

            <a
              href="/admin/students"
              class="text-xs text-sky-700 hover:text-sky-900 font-bold"
            >
              View all →
            </a>

          </div>


          <% if (!recentUsers || recentUsers.length === 0) { %>

            <div class="py-12 text-center">

              <p class="text-sm text-slate-500">
                No students yet.
              </p>

            </div>

          <% } else { %>

            <ul class="divide-y divide-slate-100">

              <% recentUsers.slice(0,6).forEach(function(user){ %>

                <li
                  class="flex items-center gap-3 px-6 py-3.5 hover:bg-slate-50"
                >

                  <div
                    class="w-9 h-9 rounded-full
                           bg-sky-100
                           text-sky-800
                           flex items-center justify-center
                           font-bold text-xs shrink-0"
                  >

                    <%= user && user.name
                      ? user.name.charAt(0).toUpperCase()
                      : '?'
                    %>

                  </div>


                  <div class="flex-1 min-w-0">

                    <p
                      class="text-sm font-bold text-slate-900 truncate"
                    >

                      <%= user && user.name
                        ? user.name
                        : 'Student'
                      %>

                    </p>

                    <p
                      class="text-xs text-slate-500 font-mono"
                    >

                      <%= user && user.rollNo
                        ? user.rollNo
                        : ''
                      %>

                    </p>

                  </div>


                  <% if (user && user.isFirstLogin) { %>

                    <span
                      class="bg-amber-100 text-amber-800
                             text-[11px] font-bold px-2.5 py-1 rounded-full"
                    >
                      First Login
                    </span>

                  <% } else { %>

                    <span
                      class="bg-emerald-100 text-emerald-800
                             text-[11px] font-bold px-2.5 py-1 rounded-full"
                    >
                      Active
                    </span>

                  <% } %>

                </li>

              <% }); %>

            </ul>

          <% } %>

        </section>


      </div>


      <!-- =================================================
           QUICK ACTIONS
      ================================================== -->

      <section
        class="bg-white border border-slate-200 rounded-2xl p-6 shadow-card"
      >

        <div class="mb-4">

          <h3 class="font-extrabold text-slate-900">
            Quick Actions
          </h3>

          <p class="text-xs text-slate-500 mt-1">
            Frequently used administration actions.
          </p>

        </div>


        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3"
        >


          <a
            href="/admin/topics"
            class="rounded-xl border border-slate-200 bg-white
                   p-4 hover:bg-slate-50 transition"
          >
            <p class="font-bold text-slate-900 text-sm">
              Manage Syllabus
            </p>

            <p class="text-xs text-slate-500 mt-1">
              Courses, subjects and units
            </p>
          </a>


          <a
            href="/admin/students"
            class="rounded-xl border border-slate-200 bg-white
                   p-4 hover:bg-slate-50 transition"
          >
            <p class="font-bold text-slate-900 text-sm">
              Add Student
            </p>

            <p class="text-xs text-slate-500 mt-1">
              Student registration
            </p>
          </a>


          <a
            href="/admin/tests/create"
            class="rounded-xl border border-emerald-200
                   bg-emerald-50 p-4
                   hover:bg-emerald-100 transition"
          >
            <p class="font-bold text-emerald-800 text-sm">
              Create Test
            </p>

            <p class="text-xs text-emerald-700 mt-1">
              Create Draft from Question Bank
            </p>
          </a>


          <a
            href="/admin/results"
            class="rounded-xl border border-sky-200
                   bg-sky-50 p-4
                   hover:bg-sky-100 transition"
          >
            <p class="font-bold text-sky-800 text-sm">
              View Reports
            </p>

            <p class="text-xs text-sky-700 mt-1">
              Results and analytics
            </p>
          </a>


        </div>

      </section>


    </div>

  </main>

</div>

</body>
</html>