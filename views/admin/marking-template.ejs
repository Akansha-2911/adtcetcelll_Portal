<%- include('../partials/head') %>
<div class="flex min-h-screen"><%- include('../partials/sidebar-admin') %>
<main class="lg:ml-64 flex-1 min-h-screen bg-[#f7f9fb]">
<header class="spvn-ui-topbar sticky top-0 z-20 px-5 lg:px-8"><div class="flex items-center gap-4"><button onclick="openSidebar()" class="lg:hidden text-slate-500">☰</button><nav class="spvn-ui-topnav flex-1"><a href="/admin/groups">Organization</a><a href="/admin/tests" class="active">Test Management</a><a href="/admin/results">Reports</a><a href="/admin/results">Analytics</a><a href="/admin/tests?view=online">Monitor</a><a href="/admin/content">Content</a></nav></div></header>
<%- include('../partials/test-management-tabs', { activeTab: 'tests' }) %>
<div class="p-5 lg:p-8 max-w-[1500px] mx-auto"><%- include('../partials/flash') %>
<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 mb-5"><div><a href="/admin/tests" class="text-xs text-sky-700 font-semibold">← Back to Tests</a><h1 class="spvn-ui-heading mt-2">Marking Scheme</h1><p class="text-sm text-slate-500 mt-1">Test Name: <strong><%= test.title %></strong></p></div><div class="text-sm text-slate-500">Number of Questions: <strong class="text-slate-800"><%= test.questions.length %></strong></div></div>
<form method="POST" action="/admin/tests/<%= test.id %>/marking-template" id="markingForm">
<div class="spvn-ui-panel spvn-accent-card gold p-4 mb-4"><div class="flex flex-wrap items-center gap-2"><span class="text-sm font-semibold text-slate-700 mr-2">Mark For All Questions</span><input id="allPositive" type="number" step="0.25" value="1" class="w-20 border rounded-lg px-2 py-2 text-sm" placeholder="+ marks"><input id="allNegative" type="number" step="0.25" value="0" class="w-20 border rounded-lg px-2 py-2 text-sm" placeholder="- marks"><input id="allPartial" type="number" step="0.25" value="0" class="w-20 border rounded-lg px-2 py-2 text-sm" placeholder="Partial"><button type="button" onclick="applyAll()" class="bg-emerald-600 text-white text-sm font-semibold px-4 py-2 rounded-lg">Apply To All</button><input id="markSearch" oninput="filterRows()" class="ml-auto border rounded-lg px-3 py-2 text-sm min-w-56" placeholder="Search question..."/></div></div>
<div class="spvn-ui-panel spvn-accent-card green overflow-hidden"><div class="overflow-x-auto"><table class="w-full min-w-[1120px] text-sm"><thead class="bg-[#607f99] text-white"><tr><th class="px-3 py-3 text-left">Question Id</th><th class="px-3 py-3 text-left min-w-[330px]">Details</th><th class="px-3 py-3">Subject</th><th class="px-3 py-3">Complexity</th><th class="px-3 py-3">Positive marks</th><th class="px-3 py-3">Negative marks</th><th class="px-3 py-3">Question sub type</th><th class="px-3 py-3">Partial marks</th><th class="px-3 py-3">Answer Key</th><th class="px-3 py-3">Bonus mark</th></tr></thead><tbody class="divide-y divide-slate-100">
<% test.questions.forEach((q,i)=>{ const st=settingMap.get(String(q._id)); %><tr class="mark-row hover:bg-slate-50" data-search="<%= (q.question+' '+q.subject+' '+q.difficulty).toLowerCase() %>"><td class="px-3 py-4 text-slate-500"><%= String(q._id).slice(-7) %></td><td class="px-3 py-4"><div class="math-content text-slate-700 leading-relaxed"><%= q.question %></div><div class="grid grid-cols-2 gap-1 mt-2 text-xs text-slate-500"><span>(a) <%= q.optionA %></span><span>(b) <%= q.optionB %></span><span>(c) <%= q.optionC %></span><span>(d) <%= q.optionD %></span></div></td><td class="px-3 py-4 text-center"><%= q.subject %></td><td class="px-3 py-4 text-center"><%= q.difficulty %></td><td class="px-3 py-4"><input class="positive-field w-20 border rounded px-2 py-1.5" type="number" step="0.25" name="positive_<%= q._id %>" value="<%= st?.positiveMarks ?? q.marks ?? 1 %>"/></td><td class="px-3 py-4"><input class="negative-field w-20 border rounded px-2 py-1.5" type="number" step="0.25" name="negative_<%= q._id %>" value="<%= st?.negativeMarks ?? q.negativeMarks ?? test.negativeMarking ?? 0 %>"/></td><td class="px-3 py-4"><select name="subtype_<%= q._id %>" class="border rounded px-2 py-1.5"><option>Single Selection</option><option>Multi Selection</option><option>Numerical</option></select></td><td class="px-3 py-4"><input class="partial-field w-20 border rounded px-2 py-1.5" type="number" step="0.25" name="partial_<%= q._id %>" value="<%= st?.partialMarks ?? 0 %>"/></td><td class="px-3 py-4"><select name="answer_<%= q._id %>" class="border rounded px-2 py-1.5"><% ['A','B','C','D'].forEach(a=>{ %><option value="<%= a %>" <%= (st?.answerKey || q.correctAnswer)===a?'selected':'' %>><%= a %></option><% }) %></select></td><td class="px-3 py-4"><input class="w-20 border rounded px-2 py-1.5" type="number" step="0.25" name="bonus_<%= q._id %>" value="<%= st?.bonusMark ?? 0 %>"/></td></tr><% }) %>
</tbody></table></div><div class="px-4 py-4 bg-white border-t flex justify-end gap-3"><a href="/admin/tests" class="px-5 py-2.5 rounded-lg border text-sm font-semibold">Cancel</a><button class="bg-emerald-600 text-white px-5 py-2.5 rounded-lg text-sm font-semibold">Save as Draft</button></div></div>
</form></div></main></div>
<script>function applyAll(){const p=document.getElementById('allPositive').value,n=document.getElementById('allNegative').value,pa=document.getElementById('allPartial').value;document.querySelectorAll('.positive-field').forEach(x=>x.value=p);document.querySelectorAll('.negative-field').forEach(x=>x.value=n);document.querySelectorAll('.partial-field').forEach(x=>x.value=pa)}function filterRows(){const q=document.getElementById('markSearch').value.toLowerCase();document.querySelectorAll('.mark-row').forEach(r=>r.style.display=r.dataset.search.includes(q)?'':'none')}</script></body></html>