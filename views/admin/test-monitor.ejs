<%- include('../partials/head') %>
<div class="flex min-h-screen bg-[#f7f9fb]"><%- include('../partials/sidebar-admin') %><main class="lg:ml-64 flex-1 min-w-0"><header class="spvn-ui-topbar sticky top-0 z-10 px-5 lg:px-8"><div class="flex items-center gap-4"><a href="/admin/monitor" class="text-slate-500">← Back</a><div><h1 class="font-bold text-slate-900"><%= test.title %></h1><p class="text-xs text-slate-400">Live candidate activity</p></div><button onclick="location.reload()" class="ml-auto spvn-ui-btn spvn-ui-btn-soft">↻ Refresh</button></div></header><div class="p-5 lg:p-8"><%- include('../partials/flash') %>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6"><% [['Total Attempts',stats.total],['Live Now',stats.live],['Completed',stats.completed],['Flagged',stats.flagged]].forEach(([l,v])=>{ %><div class="spvn-ui-panel p-5"><p class="text-2xl font-bold text-slate-900"><%= v %></p><p class="text-xs text-slate-500 mt-1"><%= l %></p></div><% }) %></div>
<div class="spvn-ui-panel overflow-hidden"><div class="px-5 py-4 border-b"><h2 class="font-bold text-slate-800">Candidates</h2></div><div class="overflow-x-auto"><table class="spvn-ui-table"><thead><tr><th>Student</th><th>Status</th><th>Started</th><th>Last Activity</th><th>Answered</th><th>Violations</th><th>Tab Switches</th><th>Focus Loss</th><th>Score</th></tr></thead><tbody><% if(!attempts.length){ %><tr><td colspan="9" class="text-center py-12 text-slate-400">No candidates have started this test.</td></tr><% } %><% attempts.forEach(r=>{ const a=r.answers||{}; %><tr><td><p class="font-medium"><%= r.studentId?.name||'Student' %></p><p class="text-[10px] text-slate-400"><%= r.studentId?.rollNo||'' %></p></td><td><span class="text-[10px] px-2 py-1 rounded-full font-semibold <%= r.status==='in_progress'?'bg-sky-100 text-sky-700':r.status==='auto_submitted'?'bg-rose-100 text-rose-700':'bg-emerald-100 text-emerald-700' %>"><%= r.status %></span></td><td><%= r.startedAt?new Date(r.startedAt).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}):'—' %></td><td><%= r.updatedAt?new Date(r.updatedAt).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}):'—' %></td><td><%= Object.keys(a).length %></td><td class="font-semibold <%= r.violationCount>0?'text-rose-600':'text-slate-500' %>"><%= r.violationCount||0 %></td><td><%= r.cheatingFlags?.tabSwitches||0 %></td><td><%= r.cheatingFlags?.focusLosses||0 %></td><td><%= ['submitted','auto_submitted'].includes(r.status)?`${r.score}/${r.totalMarks}`:'—' %></td></tr><% }) %></tbody></table></div></div>
</div></main></div></body></html>
