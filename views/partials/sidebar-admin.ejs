<script>

  function initSidebar(){

    const sidebar =
      document.getElementById(
        'mainSidebar'
      );

    if(
      window.innerWidth>=1024
    ){

      sidebar.style.transform =
        'translateX(0)';

    }else{

      sidebar.style.transform =
        'translateX(-100%)';

    }

  }


  function closeSidebar(){

    document
      .getElementById(
        'mainSidebar'
      )
      .style.transform =
        'translateX(-100%)';

    document
      .getElementById(
        'sidebarOverlay'
      )
      .classList
      .add(
        'hidden'
      );

  }


  function openSidebar(){

    document
      .getElementById(
        'mainSidebar'
      )
      .style.transform =
        'translateX(0)';

    document
      .getElementById(
        'sidebarOverlay'
      )
      .classList
      .remove(
        'hidden'
      );

  }


  window.addEventListener(
    'resize',
    initSidebar
  );


  initSidebar();


  /*
    Longest matching route wins.

    Example:
    /admin/tests/upload-test

    activates Upload Test,
    not the main Tests link.
  */

  const currentPath =
    window.location.pathname;


  const sidebarLinks =
    [
      ...document.querySelectorAll(
        '.sidebar-link'
      )
    ];


  const matchingLinks =
    sidebarLinks

      .filter(
        link=>{

          const href =
            link.getAttribute(
              'href'
            );

          return (
            currentPath===href ||
            currentPath.startsWith(
              href+'/'
            )
          );

        }
      )

      .sort(
        (
          a,
          b
        )=>
          b.getAttribute(
            'href'
          ).length -
          a.getAttribute(
            'href'
          ).length
      );


  if(
    matchingLinks[0]
  ){

    matchingLinks[0]
      .classList
      .add(
        'active'
      );

  }

</script>