<div
  id="sidebarOverlay"
  class="hidden fixed inset-0 bg-black/50 z-20 lg:hidden"
  onclick="closeSidebar()"
></div>


<aside
  id="mainSidebar"
  class="fixed inset-y-0 left-0
         w-64
         bg-[#123a5a]
         text-white
         flex flex-col
         z-30
         shadow-2xl
         transform
         -translate-x-full
         lg:translate-x-0
         transition-transform
         duration-300
         ease-in-out
         overflow-hidden"
>


  <!-- =====================================================
       COLLEGE / PORTAL HEADER
  ====================================================== -->

  <div
    class="px-5 py-4
           border-b
           border-white/10"
  >

    <div
      class="flex
             items-center
             gap-3"
    >


      <% if (collegeLogo) { %>

        <img
          src="/adt-baramati-mark.png"
          alt="Agricultural Development Trust Baramati Logo"
          class="w-9 h-9
                 rounded-lg
                 object-contain
                 bg-white
                 p-0.5
                 shrink-0"
        >

      <% } else { %>

        <div
          class="w-9 h-9
                 bg-navy-700
                 rounded-lg
                 flex
                 items-center
                 justify-center
                 font-bold
                 text-white
                 text-base
                 leading-none
                 shrink-0"
        >
          <%= (collegeShort || 'C').charAt(0) %>
        </div>

      <% } %>


      <div class="min-w-0">

        <p
          class="font-semibold
                 text-sm
                 leading-tight
                 truncate"
        >
          <%= collegeShort %>
        </p>

        <p
          class="text-[11px]
                 text-white/40
                 mt-0.5"
        >
          Student Portal
        </p>

      </div>


      <button
        type="button"
        onclick="closeSidebar()"
        class="ml-auto
               lg:hidden
               text-white/40
               hover:text-white"
      >

        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>

      </button>


    </div>

  </div>


  <!-- =====================================================
       NAVIGATION
  ====================================================== -->

  <nav
    class="flex-1
           px-3 py-4
           overflow-y-auto
           space-y-0.5"
  >


    <!-- ===================================================
         DASHBOARD
    ==================================================== -->

    <a
      href="/student/dashboard"
      data-sidebar-path="/student/dashboard"
      class="sidebar-link
             flex
             items-center
             gap-3
             px-3 py-2.5
             rounded-lg
             text-sm
             text-white/70
             hover:text-white
             hover:bg-white/10
             transition-colors"
    >

      <svg
        class="w-5 h-5 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.8"
      >
        <rect
          x="3"
          y="3"
          width="7"
          height="7"
          rx="1.5"
        />
        <rect
          x="14"
          y="3"
          width="7"
          height="7"
          rx="1.5"
        />
        <rect
          x="3"
          y="14"
          width="7"
          height="7"
          rx="1.5"
        />
        <rect
          x="14"
          y="14"
          width="7"
          height="7"
          rx="1.5"
        />
      </svg>

      Dashboard

    </a>


    <!-- ===================================================
         TEST SECTION LABEL
    ==================================================== -->

    <div
      class="px-3
             pt-5
             pb-1.5
             text-[10px]
             uppercase
             tracking-[0.16em]
             font-bold
             text-white/30"
    >
      Tests
    </div>


    <!-- ===================================================
         NEW TEST
    ==================================================== -->

    <a
      href="/student/tests?tab=new"
      data-sidebar-test-tab="new"
      class="sidebar-link
             flex
             items-center
             gap-3
             px-3 py-2.5
             rounded-lg
             text-sm
             text-white/70
             hover:text-white
             hover:bg-white/10
             transition-colors"
    >

      <svg
        class="w-5 h-5 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 4v16m8-8H4"
        />
      </svg>

      New Test

    </a>


    <!-- ===================================================
         UNSOLVED TEST
    ==================================================== -->

    <a
      href="/student/tests?tab=unsolved"
      data-sidebar-test-tab="unsolved"
      class="sidebar-link
             flex
             items-center
             gap-3
             px-3 py-2.5
             rounded-lg
             text-sm
             text-white/70
             hover:text-white
             hover:bg-white/10
             transition-colors"
    >

      <svg
        class="w-5 h-5 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 8v4l3 3"
        />

        <circle
          cx="12"
          cy="12"
          r="9"
        />
      </svg>

      Unsolved Test

    </a>


    <!-- ===================================================
         SOLVED TEST
    ==================================================== -->

    <a
      href="/student/tests?tab=solved"
      data-sidebar-test-tab="solved"
      class="sidebar-link
             flex
             items-center
             gap-3
             px-3 py-2.5
             rounded-lg
             text-sm
             text-white/70
             hover:text-white
             hover:bg-white/10
             transition-colors"
    >

      <svg
        class="w-5 h-5 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 12l2 2 4-4"
        />

        <circle
          cx="12"
          cy="12"
          r="9"
        />
      </svg>

      Solved Test

    </a>


    <!-- ===================================================
         RESULT
    ==================================================== -->

    <a
      href="/student/results"
      data-sidebar-path="/student/results"
      class="sidebar-link
             flex
             items-center
             gap-3
             px-3 py-2.5
             rounded-lg
             text-sm
             text-white/70
             hover:text-white
             hover:bg-white/10
             transition-colors"
    >

      <svg
        class="w-5 h-5 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
        />
      </svg>

      Result

    </a>


    <!-- ===================================================
         PRACTICE TEST
    ==================================================== -->

    <a
      href="/student/practice"
      data-sidebar-path="/student/practice"
      class="sidebar-link
             flex
             items-center
             gap-3
             px-3 py-2.5
             rounded-lg
             text-sm
             text-white/70
             hover:text-white
             hover:bg-white/10
             transition-colors"
    >

      <svg
        class="w-5 h-5 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 6v12m6-6H6"
        />

        <circle
          cx="12"
          cy="12"
          r="9"
        />
      </svg>

      Practice Test

    </a>


    <!-- ===================================================
         OTHER SECTION
    ==================================================== -->

    <div
      class="px-3
             pt-5
             pb-1.5
             text-[10px]
             uppercase
             tracking-[0.16em]
             font-bold
             text-white/30"
    >
      Student
    </div>


    <!-- ===================================================
         NOTIFICATIONS
    ==================================================== -->

    <a
      href="/student/notifications"
      data-sidebar-path="/student/notifications"
      class="sidebar-link
             flex
             items-center
             gap-3
             px-3 py-2.5
             rounded-lg
             text-sm
             text-white/70
             hover:text-white
             hover:bg-white/10
             transition-colors"
    >

      <svg
        class="w-5 h-5 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
        />
      </svg>

      Notifications

    </a>


    <!-- ===================================================
         DOCUMENTS
    ==================================================== -->

    <a
      href="/student/documents"
      data-sidebar-path="/student/documents"
      class="sidebar-link
             flex
             items-center
             gap-3
             px-3 py-2.5
             rounded-lg
             text-sm
             text-white/70
             hover:text-white
             hover:bg-white/10
             transition-colors"
    >

      <svg
        class="w-5 h-5 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
        />
      </svg>

      My Documents

    </a>


    <!-- ===================================================
         CHANGE PASSWORD
    ==================================================== -->

    <a
      href="/auth/change-password"
      data-sidebar-path="/auth/change-password"
      class="sidebar-link
             flex
             items-center
             gap-3
             px-3 py-2.5
             rounded-lg
             text-sm
             text-white/70
             hover:text-white
             hover:bg-white/10
             transition-colors"
    >

      <svg
        class="w-5 h-5 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
        />
      </svg>

      Change Password

    </a>


  </nav>


  <!-- =====================================================
       STUDENT ACCOUNT
  ====================================================== -->

  <div
    class="px-4 py-4
           border-t
           border-white/10"
  >


    <div
      class="flex
             items-center
             gap-3
             mb-3.5"
    >


      <div
        class="w-8 h-8
               rounded-full
               bg-navy-600
               flex
               items-center
               justify-center
               font-semibold
               text-white
               text-sm
               shrink-0"
      >
        <%= currentUser.name.charAt(0).toUpperCase() %>
      </div>


      <div
        class="min-w-0
               flex-1"
      >

        <p
          class="text-sm
                 font-medium
                 truncate
                 leading-tight"
        >
          <%= currentUser.name %>
        </p>


        <p
          class="text-[11px]
                 text-white/40
                 font-mono"
        >
          Roll: <%= currentUser.rollNo %>
        </p>

      </div>


    </div>


    <a
      href="/auth/logout"
      class="flex
             items-center
             gap-2
             text-[13px]
             text-white/50
             hover:text-white
             transition-colors
             group"
    >

      <svg
        class="w-4 h-4
               group-hover:translate-x-0.5
               transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
        />
      </svg>

      Sign out

    </a>


  </div>


</aside>


<style>

  .sidebar-link.active {

    background-color:
      rgba(255,255,255,0.14);

    color:
      white;

    font-weight:
      600;

  }


  .sidebar-link.active svg {

    color:
      white;

  }

</style>


<script>

(function () {

  function closeSidebar() {

    const sidebar =
      document.getElementById(
        'mainSidebar'
      );


    const overlay =
      document.getElementById(
        'sidebarOverlay'
      );


    if (sidebar) {

      sidebar.classList.add(
        '-translate-x-full'
      );

    }


    if (overlay) {

      overlay.classList.add(
        'hidden'
      );

    }

  }


  function openSidebar() {

    const sidebar =
      document.getElementById(
        'mainSidebar'
      );


    const overlay =
      document.getElementById(
        'sidebarOverlay'
      );


    if (sidebar) {

      sidebar.classList.remove(
        '-translate-x-full'
      );

    }


    if (overlay) {

      overlay.classList.remove(
        'hidden'
      );

    }

  }


  /*
   * Make functions available to buttons
   * in other student views.
   */

  window.closeSidebar =
    closeSidebar;


  window.openSidebar =
    openSidebar;


  /* =========================================================
     ACTIVE NAVIGATION
  ========================================================= */

  const currentPath =
    window.location.pathname;


  const params =
    new URLSearchParams(
      window.location.search
    );


  const currentTestTab =
    params.get('tab') ||
    'new';


  const links =
    document.querySelectorAll(
      '.sidebar-link'
    );


  /*
   * Remove any accidental active classes first.
   */

  links.forEach(
    function (link) {

      link.classList.remove(
        'active'
      );

    }
  );


  /*
   * Test page requires query-string-aware highlighting.
   */

  if (
    currentPath ===
    '/student/tests'
  ) {

    const tabLink =
      document.querySelector(
        '[data-sidebar-test-tab="' +
        currentTestTab +
        '"]'
      );


    if (tabLink) {

      tabLink.classList.add(
        'active'
      );

    }

    return;

  }


  /*
   * Practice child pages:
   *
   * /student/practice
   * /student/practice/:attemptId
   * /student/practice/:attemptId/result
   */

  if (
    currentPath ===
      '/student/practice' ||
    currentPath.startsWith(
      '/student/practice/'
    )
  ) {

    const practiceLink =
      document.querySelector(
        '[data-sidebar-path="/student/practice"]'
      );


    if (practiceLink) {

      practiceLink.classList.add(
        'active'
      );

    }

    return;

  }


  /*
   * Result pages can include:
   *
   * /student/results
   */

  if (
    currentPath.startsWith(
      '/student/results'
    )
  ) {

    const resultLink =
      document.querySelector(
        '[data-sidebar-path="/student/results"]'
      );


    if (resultLink) {

      resultLink.classList.add(
        'active'
      );

    }

    return;

  }


  /*
   * Standard student routes.
   */

  const pathLinks =
    Array.from(
      document.querySelectorAll(
        '[data-sidebar-path]'
      )
    );


  let bestMatch =
    null;


  pathLinks.forEach(
    function (link) {

      const target =
        link.getAttribute(
          'data-sidebar-path'
        );


      if (!target) {
        return;
      }


      if (
        currentPath === target ||
        currentPath.startsWith(
          target + '/'
        )
      ) {

        if (
          !bestMatch ||
          target.length >
          bestMatch.target.length
        ) {

          bestMatch = {
            link,
            target
          };

        }

      }

    }
  );


  if (bestMatch) {

    bestMatch.link.classList.add(
      'active'
    );

  }


})();

</script>