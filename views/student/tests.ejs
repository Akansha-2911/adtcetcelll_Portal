<%- include('../partials/head') %>


<div class="flex min-h-screen">

  <%- include('../partials/sidebar-student') %>


  <main
    class="lg:ml-64
           flex-1
           min-w-0
           min-h-screen
           bg-slate-50"
  >


    <!-- =====================================================
         TOP HEADER
    ====================================================== -->

    <header
      class="sticky
             top-0
             z-30
             bg-white/95
             backdrop-blur
             border-b
             border-slate-200"
    >

      <div
        class="px-5 lg:px-8
               py-4
               flex
               items-center
               gap-4"
      >

        <button
          type="button"
          onclick="openSidebar()"
          class="lg:hidden
                 text-slate-500
                 hover:text-slate-800"
        >

          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>

        </button>


        <div class="flex-1 min-w-0">

          <h1
            class="text-lg
                   font-bold
                   text-slate-900"
          >
            My Tests
          </h1>


          <p
            class="text-xs
                   text-slate-400
                   mt-0.5"
          >

            <%= newTests.length %> new

            ·

            <%= pendingTests.length %> unsolved

            ·

            <%= solvedTests.length %> solved

          </p>

        </div>

      </div>


      <!-- ===================================================
           STUDENT TEST NAVIGATION
      ==================================================== -->

      <div
        class="px-5 lg:px-8
               border-t
               border-slate-100
               overflow-x-auto"
      >

        <nav
          class="flex
                 items-center
                 gap-7
                 whitespace-nowrap
                 min-w-max"
        >


          <a
            href="/student/tests?tab=new"
            class="student-test-tab
                   <%= queryTab === 'new' ? 'active' : '' %>"
          >
            New Test

            <span
              class="ml-1
                     text-[10px]
                     px-1.5 py-0.5
                     rounded-full
                     bg-blue-100
                     text-blue-700"
            >
              <%= newTests.length %>
            </span>
          </a>


          <a
            href="/student/tests?tab=unsolved"
            class="student-test-tab
                   <%= queryTab === 'unsolved' ? 'active' : '' %>"
          >
            Unsolved Test

            <span
              class="ml-1
                     text-[10px]
                     px-1.5 py-0.5
                     rounded-full
                     bg-amber-100
                     text-amber-700"
            >
              <%= pendingTests.length + expiredTests.length %>
            </span>
          </a>


          <a
            href="/student/tests?tab=solved"
            class="student-test-tab
                   <%= queryTab === 'solved' ? 'active' : '' %>"
          >
            Solved Test

            <span
              class="ml-1
                     text-[10px]
                     px-1.5 py-0.5
                     rounded-full
                     bg-emerald-100
                     text-emerald-700"
            >
              <%= solvedTests.length %>
            </span>
          </a>


          <a
            href="/student/results"
            class="student-test-tab"
          >
            Result
          </a>


          <a
            href="/student/practice"
            class="student-test-tab"
          >
            Practice Test
          </a>


        </nav>

      </div>

    </header>


    <!-- =====================================================
         BODY
    ====================================================== -->

    <div
      class="p-5 lg:p-8"
    >

      <%- include('../partials/flash') %>


      <%
        function fmtDate(value) {

          if (!value) {
            return '—';
          }

          try {

            return new Date(value)
              .toLocaleString(
                'en-IN',
                {
                  timeZone:
                    typeof appTimeZone !== 'undefined'
                      ? appTimeZone
                      : 'Asia/Kolkata',

                  day:
                    '2-digit',

                  month:
                    'short',

                  year:
                    'numeric',

                  hour:
                    '2-digit',

                  minute:
                    '2-digit'
                }
              );

          } catch (error) {

            return new Date(value)
              .toLocaleString('en-IN');

          }

        }


        function subjectsText(test) {

          if (!test) {
            return '—';
          }

          const subjects =
            Array.isArray(test.subject)
              ? test.subject
              : [test.subject].filter(Boolean);


          return subjects.length
            ? subjects.join(', ')
            : 'Mixed';

        }
      %>


      <!-- ===================================================
           NEW TEST TAB
      ==================================================== -->

      <% if (queryTab === 'new') { %>


        <div
          class="flex
                 flex-col
                 md:flex-row
                 md:items-end
                 justify-between
                 gap-3
                 mb-5"
        >

          <div>

            <p
              class="text-xs
                     font-bold
                     uppercase
                     tracking-wide
                     text-blue-600"
            >
              Available Tests
            </p>

            <h2
              class="text-xl
                     font-bold
                     text-slate-900
                     mt-1"
            >
              New Test
            </h2>

            <p
              class="text-sm
                     text-slate-500
                     mt-1"
            >
              Tests currently available for you to start.
            </p>

          </div>

        </div>


        <!-- TABLE -->

        <div
          class="bg-white
                 border border-slate-200
                 rounded-2xl
                 shadow-sm
                 overflow-hidden"
        >

          <div class="overflow-x-auto">

            <table
              class="w-full
                     min-w-[900px]
                     text-sm"
            >

              <thead
                class="bg-slate-50
                       border-b
                       border-slate-200"
              >

                <tr>

                  <th
                    class="px-5 py-3
                           text-left
                           text-[11px]
                           uppercase
                           tracking-wide
                           font-bold
                           text-slate-500"
                  >
                    Test
                  </th>

                  <th
                    class="px-4 py-3
                           text-left
                           text-[11px]
                           uppercase
                           font-bold
                           text-slate-500"
                  >
                    Subjects
                  </th>

                  <th
                    class="px-4 py-3
                           text-left
                           text-[11px]
                           uppercase
                           font-bold
                           text-slate-500"
                  >
                    Duration
                  </th>

                  <th
                    class="px-4 py-3
                           text-left
                           text-[11px]
                           uppercase
                           font-bold
                           text-slate-500"
                  >
                    Marks
                  </th>

                  <th
                    class="px-4 py-3
                           text-left
                           text-[11px]
                           uppercase
                           font-bold
                           text-slate-500"
                  >
                    End Time
                  </th>

                  <th
                    class="px-4 py-3
                           text-left
                           text-[11px]
                           uppercase
                           font-bold
                           text-slate-500"
                  >
                    Status
                  </th>

                  <th
                    class="px-5 py-3
                           text-right
                           text-[11px]
                           uppercase
                           font-bold
                           text-slate-500"
                  >
                    Action
                  </th>

                </tr>

              </thead>


              <tbody
                class="divide-y
                       divide-slate-100"
              >


                <% if (!newTests.length) { %>

                  <tr>

                    <td
                      colspan="7"
                      class="px-5 py-16
                             text-center"
                    >

                      <div
                        class="w-12 h-12
                               rounded-full
                               bg-blue-50
                               flex
                               items-center
                               justify-center
                               mx-auto
                               mb-3"
                      >
                        <span class="text-xl">
                          📝
                        </span>
                      </div>

                      <p
                        class="font-semibold
                               text-slate-500"
                      >
                        No new tests right now
                      </p>

                      <p
                        class="text-xs
                               text-slate-400
                               mt-1"
                      >
                        New tests assigned by the administrator will appear here.
                      </p>

                    </td>

                  </tr>

                <% } %>


                <% newTests.forEach(function(row) {

                  const test =
                    row.test;

                %>

                  <tr
                    class="hover:bg-slate-50
                           transition-colors"
                  >

                    <td
                      class="px-5 py-4"
                    >

                      <p
                        class="font-bold
                               text-slate-900"
                      >
                        <%= test.title %>
                      </p>

                      <p
                        class="text-xs
                               text-slate-400
                               mt-1"
                      >
                        Ready to start
                      </p>

                    </td>


                    <td
                      class="px-4 py-4
                             text-slate-600"
                    >
                      <%= subjectsText(test) %>
                    </td>


                    <td
                      class="px-4 py-4
                             text-slate-600"
                    >
                      <%= test.duration %> min
                    </td>


                    <td
                      class="px-4 py-4
                             font-semibold
                             text-slate-700"
                    >
                      <%= test.totalMarks %>
                    </td>


                    <td
                      class="px-4 py-4
                             text-xs
                             text-slate-500"
                    >
                      <%= fmtDate(test.endTime) %>
                    </td>


                    <td
                      class="px-4 py-4"
                    >

                      <span
                        class="inline-flex
                               px-2.5 py-1
                               rounded-full
                               text-[11px]
                               font-bold
                               bg-blue-50
                               text-blue-700"
                      >
                        New
                      </span>

                    </td>


                    <td
                      class="px-5 py-4
                             text-right"
                    >

                      <a
                        href="/exam/<%= test.id %>/instructions"
                        class="inline-flex
                               items-center
                               justify-center
                               bg-slate-900
                               text-white
                               px-4 py-2
                               rounded-lg
                               text-xs
                               font-bold
                               hover:bg-slate-800"
                      >
                        Start Test
                      </a>

                    </td>

                  </tr>

                <% }); %>


              </tbody>

            </table>

          </div>

        </div>


        <!-- =================================================
             UPCOMING TESTS
        ================================================== -->

        <% if (
          typeof upcomingTests !== 'undefined' &&
          upcomingTests.length
        ) { %>


          <div class="mt-8 mb-4">

            <h3
              class="font-bold
                     text-slate-900"
            >
              Upcoming Tests
            </h3>

            <p
              class="text-xs
                     text-slate-500
                     mt-1"
            >
              These tests are assigned but not open yet.
            </p>

          </div>


          <div
            class="bg-white
                   border border-slate-200
                   rounded-2xl
                   overflow-hidden"
          >

            <div class="overflow-x-auto">

              <table
                class="w-full
                       min-w-[800px]
                       text-sm"
              >

                <thead class="bg-slate-50">

                  <tr>

                    <th class="px-5 py-3 text-left text-xs text-slate-500">
                      Test
                    </th>

                    <th class="px-4 py-3 text-left text-xs text-slate-500">
                      Subjects
                    </th>

                    <th class="px-4 py-3 text-left text-xs text-slate-500">
                      Opens
                    </th>

                    <th class="px-4 py-3 text-left text-xs text-slate-500">
                      Ends
                    </th>

                    <th class="px-5 py-3 text-right text-xs text-slate-500">
                      Status
                    </th>

                  </tr>

                </thead>


                <tbody class="divide-y divide-slate-100">

                  <% upcomingTests.forEach(function(row) {

                    const test =
                      row.test;

                  %>

                    <tr>

                      <td
                        class="px-5 py-4
                               font-semibold
                               text-slate-800"
                      >
                        <%= test.title %>
                      </td>

                      <td
                        class="px-4 py-4
                               text-slate-600"
                      >
                        <%= subjectsText(test) %>
                      </td>

                      <td
                        class="px-4 py-4
                               text-xs
                               text-slate-500"
                      >
                        <%= fmtDate(test.startTime) %>
                      </td>

                      <td
                        class="px-4 py-4
                               text-xs
                               text-slate-500"
                      >
                        <%= fmtDate(test.endTime) %>
                      </td>

                      <td
                        class="px-5 py-4
                               text-right"
                      >

                        <span
                          class="inline-flex
                                 bg-slate-100
                                 text-slate-500
                                 px-3 py-1.5
                                 rounded-lg
                                 text-xs
                                 font-semibold"
                        >
                          Not Open Yet
                        </span>

                      </td>

                    </tr>

                  <% }); %>

                </tbody>

              </table>

            </div>

          </div>


        <% } %>


      <% } %>


      <!-- ===================================================
           UNSOLVED TEST TAB
      ==================================================== -->

      <% if (queryTab === 'unsolved') { %>


        <div class="mb-5">

          <p
            class="text-xs
                   font-bold
                   uppercase
                   tracking-wide
                   text-amber-600"
          >
            Pending Work
          </p>

          <h2
            class="text-xl
                   font-bold
                   text-slate-900
                   mt-1"
          >
            Unsolved Test
          </h2>

          <p
            class="text-sm
                   text-slate-500
                   mt-1"
          >
            Resume tests that you have already started.
          </p>

        </div>


        <div
          class="bg-white
                 border border-slate-200
                 rounded-2xl
                 shadow-sm
                 overflow-hidden"
        >

          <div class="overflow-x-auto">

            <table
              class="w-full
                     min-w-[900px]
                     text-sm"
            >

              <thead
                class="bg-slate-50
                       border-b
                       border-slate-200"
              >

                <tr>

                  <th class="px-5 py-3 text-left text-xs font-bold text-slate-500">
                    Test
                  </th>

                  <th class="px-4 py-3 text-left text-xs font-bold text-slate-500">
                    Subjects
                  </th>

                  <th class="px-4 py-3 text-left text-xs font-bold text-slate-500">
                    Duration
                  </th>

                  <th class="px-4 py-3 text-left text-xs font-bold text-slate-500">
                    End Time
                  </th>

                  <th class="px-4 py-3 text-left text-xs font-bold text-slate-500">
                    Status
                  </th>

                  <th class="px-5 py-3 text-right text-xs font-bold text-slate-500">
                    Action
                  </th>

                </tr>

              </thead>


              <tbody class="divide-y divide-slate-100">


                <% if (
                  !pendingTests.length &&
                  !expiredTests.length
                ) { %>

                  <tr>

                    <td
                      colspan="6"
                      class="py-16
                             text-center"
                    >

                      <p
                        class="font-semibold
                               text-slate-500"
                      >
                        No unsolved tests
                      </p>

                      <p
                        class="text-xs
                               text-slate-400
                               mt-1"
                      >
                        Tests you start but do not submit will appear here.
                      </p>

                    </td>

                  </tr>

                <% } %>


                <% pendingTests.forEach(function(row) {

                  const test =
                    row.test;

                %>

                  <tr class="hover:bg-slate-50">

                    <td class="px-5 py-4">

                      <p
                        class="font-bold
                               text-slate-900"
                      >
                        <%= test.title %>
                      </p>

                      <p
                        class="text-xs
                               text-amber-600
                               mt-1"
                      >
                        Continue your attempt
                      </p>

                    </td>


                    <td class="px-4 py-4 text-slate-600">
                      <%= subjectsText(test) %>
                    </td>


                    <td class="px-4 py-4 text-slate-600">
                      <%= test.duration %> min
                    </td>


                    <td class="px-4 py-4 text-xs text-slate-500">
                      <%= fmtDate(test.endTime) %>
                    </td>


                    <td class="px-4 py-4">

                      <span
                        class="inline-flex
                               px-2.5 py-1
                               rounded-full
                               text-xs
                               font-bold
                               bg-amber-100
                               text-amber-700"
                      >
                        In Progress
                      </span>

                    </td>


                    <td class="px-5 py-4 text-right">

                      <a
                        href="/exam/<%= test.id %>/instructions"
                        class="inline-flex
                               bg-amber-600
                               text-white
                               px-4 py-2
                               rounded-lg
                               text-xs
                               font-bold
                               hover:bg-amber-700"
                      >
                        Resume Test
                      </a>

                    </td>

                  </tr>

                <% }); %>


                <% expiredTests.forEach(function(row) {

                  const test =
                    row.test;

                %>

                  <tr class="bg-slate-50/50">

                    <td class="px-5 py-4">

                      <p class="font-semibold text-slate-600">
                        <%= test.title %>
                      </p>

                    </td>


                    <td class="px-4 py-4 text-slate-500">
                      <%= subjectsText(test) %>
                    </td>


                    <td class="px-4 py-4 text-slate-500">
                      <%= test.duration %> min
                    </td>


                    <td class="px-4 py-4 text-xs text-rose-500">
                      <%= fmtDate(test.endTime) %>
                    </td>


                    <td class="px-4 py-4">

                      <span
                        class="inline-flex
                               bg-slate-200
                               text-slate-600
                               px-2.5 py-1
                               rounded-full
                               text-xs
                               font-bold"
                      >
                        Expired
                      </span>

                    </td>


                    <td class="px-5 py-4 text-right">

                      <button
                        type="button"
                        disabled
                        class="bg-slate-100
                               text-slate-400
                               px-4 py-2
                               rounded-lg
                               text-xs
                               font-semibold
                               cursor-not-allowed"
                      >
                        Closed
                      </button>

                    </td>

                  </tr>

                <% }); %>


              </tbody>

            </table>

          </div>

        </div>


      <% } %>


      <!-- ===================================================
           SOLVED TEST TAB
      ==================================================== -->

      <% if (queryTab === 'solved') { %>


        <div class="mb-5">

          <p
            class="text-xs
                   font-bold
                   uppercase
                   tracking-wide
                   text-emerald-600"
          >
            Completed Tests
          </p>

          <h2
            class="text-xl
                   font-bold
                   text-slate-900
                   mt-1"
          >
            Solved Test
          </h2>

          <p
            class="text-sm
                   text-slate-500
                   mt-1"
          >
            View your completed tests and results.
          </p>

        </div>


        <div
          class="bg-white
                 border border-slate-200
                 rounded-2xl
                 shadow-sm
                 overflow-hidden"
        >

          <div class="overflow-x-auto">

            <table
              class="w-full
                     min-w-[950px]
                     text-sm"
            >

              <thead
                class="bg-slate-50
                       border-b
                       border-slate-200"
              >

                <tr>

                  <th class="px-5 py-3 text-left text-xs font-bold text-slate-500">
                    Test
                  </th>

                  <th class="px-4 py-3 text-left text-xs font-bold text-slate-500">
                    Subjects
                  </th>

                  <th class="px-4 py-3 text-left text-xs font-bold text-slate-500">
                    Submitted
                  </th>

                  <th class="px-4 py-3 text-left text-xs font-bold text-slate-500">
                    Score
                  </th>

                  <th class="px-4 py-3 text-left text-xs font-bold text-slate-500">
                    Rank
                  </th>

                  <th class="px-4 py-3 text-left text-xs font-bold text-slate-500">
                    Status
                  </th>

                  <th class="px-5 py-3 text-right text-xs font-bold text-slate-500">
                    Action
                  </th>

                </tr>

              </thead>


              <tbody class="divide-y divide-slate-100">


                <% if (!solvedTests.length) { %>

                  <tr>

                    <td
                      colspan="7"
                      class="py-16
                             text-center"
                    >

                      <p
                        class="font-semibold
                               text-slate-500"
                      >
                        No solved tests yet
                      </p>

                      <p
                        class="text-xs
                               text-slate-400
                               mt-1"
                      >
                        Submitted tests will appear here.
                      </p>

                    </td>

                  </tr>

                <% } %>


                <% solvedTests.forEach(function(row) {

                  const test =
                    row.test;

                  const result =
                    row.result;

                  const percentage =
                    result &&
                    Number(result.totalMarks || 0) > 0
                      ? (
                          Number(result.score || 0) /
                          Number(result.totalMarks)
                          *
                          100
                        ).toFixed(1)
                      : '0.0';

                %>

                  <tr class="hover:bg-slate-50">

                    <td class="px-5 py-4">

                      <p
                        class="font-bold
                               text-slate-900"
                      >
                        <%= test.title %>
                      </p>

                    </td>


                    <td class="px-4 py-4 text-slate-600">
                      <%= subjectsText(test) %>
                    </td>


                    <td class="px-4 py-4 text-xs text-slate-500">
                      <%= fmtDate(result?.submittedAt) %>
                    </td>


                    <td class="px-4 py-4">

                      <p
                        class="font-bold
                               text-slate-800"
                      >
                        <%= result?.score || 0 %>
                        /
                        <%= result?.totalMarks || test.totalMarks %>
                      </p>

                      <p
                        class="text-xs
                               text-emerald-600"
                      >
                        <%= percentage %>%
                      </p>

                    </td>


                    <td class="px-4 py-4">

                      <span class="font-bold text-slate-700">

                        <%= result?.rank
                          ? '#' + result.rank
                          : '—'
                        %>

                      </span>

                    </td>


                    <td class="px-4 py-4">

                      <span
                        class="inline-flex
                               px-2.5 py-1
                               rounded-full
                               text-xs
                               font-bold
                               bg-emerald-100
                               text-emerald-700"
                      >
                        Solved
                      </span>

                    </td>


                    <td class="px-5 py-4 text-right">

                      <% if (result) { %>

                        <a
                          href="/results/<%= result._id || result.id %>"
                          class="inline-flex
                                 bg-slate-900
                                 text-white
                                 px-4 py-2
                                 rounded-lg
                                 text-xs
                                 font-bold
                                 hover:bg-slate-800"
                        >
                          View Result
                        </a>

                      <% } %>

                    </td>

                  </tr>

                <% }); %>


              </tbody>

            </table>

          </div>

        </div>


      <% } %>


    </div>

  </main>

</div>


<style>

  .student-test-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 54px;

    padding:
      0 2px;

    color:
      #64748b;

    font-size:
      13px;

    font-weight:
      700;

    border-bottom:
      3px solid transparent;

    transition:
      color .15s ease,
      border-color .15s ease;
  }


  .student-test-tab:hover {
    color:
      #0f172a;
  }


  .student-test-tab.active {

    color:
      #2563eb;

    border-bottom-color:
      #2563eb;

  }

</style>


</body>
</html>