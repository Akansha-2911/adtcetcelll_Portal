<%- include('../partials/head') %>

  <%- include('../partials/navbar-student') %>


    <%
function safeImageUrl(value) {
  if (!value) {
    return '';
  }

  let src = String(value).trim();

  if (!src) {
    return '';
  }

  if (
    src.indexOf('/uploads/') === 0 ||
    src.indexOf('http://') === 0 ||
    src.indexOf('https://') === 0 ||
    src.indexOf('data:image/') === 0
  ) {
    return src;
  }

  src = src.split('\\').join('/');

  const lower = src.toLowerCase();
  const uploadsIndex = lower.indexOf('/uploads/');

  if (uploadsIndex >= 0) {
    return src.substring(uploadsIndex);
  }

  if (lower.indexOf('uploads/') === 0) {
    return '/' + src;
  }

  return src;
}

function isVisualDescription(value) {
  const text = String(value || '').trim();

  if (!text) {
    return false;
  }

  if (
    text.charAt(0) === '[' &&
    text.charAt(text.length - 1) === ']'
  ) {
    return true;
  }

  const clean = text
    .toLowerCase()
    .split('[').join('')
    .split(']').join('')
    .trim();

  const visualPrefixes = [
    'venn diagram:',
    'diagram:',
    'graph:',
    'figure:',
    'image:',
    'circuit:',
    'chart:',
    'visual table:'
  ];

  return visualPrefixes.some(function (prefix) {
    return clean.indexOf(prefix) === 0;
  });
}
%>


      <style>
        .practice-question,
        .practice-option {
          font-family:
            "Times New Roman",
            Times,
            serif;
        }

        .practice-question p,
        .practice-option p {
          margin: 0 !important;
        }

        .practice-question-card {
          display: none;
        }

        .practice-question-card.active {
          display: block;
        }

        .palette-btn {
          width: 42px;
          height: 42px;
          border-radius: 10px;
          font-size: 13px;
          font-weight: 700;
          transition: .15s ease;
        }

        .palette-not-visited {
          background: #e2e8f0;
          color: #475569;
        }

        .palette-visited {
          background: #fee2e2;
          color: #be123c;
        }

        .palette-answered {
          background: #10b981;
          color: white;
        }

        .palette-current {
          box-shadow:
            0 0 0 3px rgba(79, 70, 229, .22);
          border: 2px solid #4f46e5;
        }
      </style>


      <main class="min-h-screen bg-slate-50">

        <form id="practiceTestForm" action="/student/practice/<%= attempt._id %>/submit" method="POST">


          <div class="max-w-7xl mx-auto
             px-4 lg:px-6 py-6">


            <!-- =====================================================
           HEADER
      ====================================================== -->

            <div class="sticky top-16 z-30
               bg-white
               border border-slate-200
               rounded-xl
               p-4
               shadow-sm
               mb-5
               flex flex-wrap
               items-center
               justify-between
               gap-3">


              <div>

                <p class="text-xs
                   font-bold
                   uppercase
                   tracking-wide
                   text-indigo-600">
                  Practice Test
                </p>


                <h1 class="font-bold
                   text-slate-900
                   mt-0.5">
                  <%= attempt.subject %>
                </h1>


                <p class="text-xs
                   text-slate-500
                   mt-1">

                  <%= attempt.topic || 'All Topics' %>

                    <% if (attempt.subtopic) { %>

                      · <%= attempt.subtopic %>

                        <% } %>

                          · <%= questions.length %> questions

                            · <%= attempt.difficulty || 'All' %>

                </p>

              </div>


              <div class="flex items-center gap-2">

                <span id="practiceProgress" class="text-sm
                   font-bold
                   text-slate-700
                   bg-slate-100
                   rounded-lg
                   px-3 py-2">
                  Question 1 / <%= questions.length %>
                </span>

              </div>

            </div>


            <!-- =====================================================
           MAIN GRID
      ====================================================== -->

            <div class="grid
               lg:grid-cols-[minmax(0,1fr)_300px]
               gap-5">


              <!-- ===================================================
             QUESTION AREA
        ==================================================== -->

              <div class="bg-white
                 border border-slate-200
                 rounded-2xl
                 shadow-sm
                 min-h-[620px]
                 overflow-hidden">


                <!-- QUESTION TOPBAR -->

                <div class="px-5 py-3
                   border-b border-slate-200
                   bg-slate-50
                   flex flex-wrap
                   justify-between
                   items-center
                   gap-3">

                  <div class="flex items-center gap-2">

                    <span id="questionBadge" class="inline-flex
                       items-center
                       rounded-full
                       bg-slate-900
                       text-white
                       px-3 py-1
                       text-xs
                       font-bold">
                      Q 1 / <%= questions.length %>
                    </span>


                    <span class="text-xs
                       text-slate-500">
                      <%= attempt.subject %>
                    </span>

                  </div>


                  <button type="button" id="clearAnswerButton" class="border
                     border-slate-300
                     bg-white
                     text-slate-600
                     px-3 py-2
                     rounded-lg
                     text-xs
                     font-semibold
                     hover:bg-slate-50">
                    Clear Answer
                  </button>

                </div>


                <!-- =================================================
               QUESTIONS
          ================================================== -->

                <div class="p-5 lg:p-7">


                  <% (questions || []).forEach(function(q, i) { const questionImage=safeImageUrl( q.questionImage );
                    const options=[ { key: 'A' , text: q.optionA, image: safeImageUrl(q.optionAImage) }, { key: 'B' ,
                    text: q.optionB, image: safeImageUrl(q.optionBImage) }, { key: 'C' , text: q.optionC, image:
                    safeImageUrl(q.optionCImage) }, { key: 'D' , text: q.optionD, image: safeImageUrl(q.optionDImage) }
                    ]; %>


                    <section class="practice-question-card <%= i === 0 ? 'active' : '' %>"
                      data-question-index="<%= i %>" data-question-id="<%= q._id %>">


                      <!-- QUESTION -->

                      <div class="practice-question math-content
                         text-[18px]
                         leading-8
                         font-semibold
                         text-slate-900
                         mb-5"
                         data-math-source="<%= (q.question || '').replace(/"/g, '&quot;') %>">
                        <%= q.question %>
                      </div>


                      <!-- QUESTION IMAGE -->

                      <% if (questionImage) { %>

                        <div class="mb-5
                           border border-slate-200
                           rounded-xl
                           bg-slate-50
                           p-3
                           overflow-auto">

                          <img src="<%= questionImage %>" alt="Question image" class="block
                             max-h-80
                             max-w-full
                             w-auto
                             h-auto
                             mx-auto
                             object-contain
                             bg-white
                             rounded-lg">

                        </div>

                        <% } %>


                          <!-- OPTIONS -->

                          <div class="space-y-3">


                            <% options.forEach(function(option) { const hasText=String( option.text || '' ).trim();
                              const showText=hasText && !( option.image && isVisualDescription( option.text ) ); if (
                              !showText && !option.image ) { return; } %>


                              <label class="practice-option-label
                             flex
                             items-start
                             gap-3
                             p-4
                             rounded-xl
                             border border-slate-200
                             bg-white
                             hover:bg-indigo-50
                             hover:border-indigo-200
                             cursor-pointer
                             transition-colors">


                                <input type="radio" name="answer_<%= q._id %>" value="<%= option.key %>" class="practice-radio
                               mt-1
                               w-4 h-4">


                                <span class="w-7 h-7
                               rounded-full
                               border border-slate-300
                               flex
                               items-center
                               justify-center
                               shrink-0
                               text-xs
                               font-bold
                               text-slate-600">
                                  <%= option.key %>
                                </span>


                                <div class="flex-1
                               min-w-0">


                                  <% if (showText) { %>

                                    <div class="practice-option math-content
                                   text-[16px]
                                   leading-6
                                   text-slate-800"
                                   data-math-source="<%= (option.text || '').replace(/"/g, '&quot;') %>">
                                      <%= option.text %>
                                    </div>

                                    <% } %>


                                      <% if (option.image) { %>

                                        <div class="<%= showText ? 'mt-3' : '' %>
                                   bg-white
                                   rounded-lg
                                   overflow-hidden">

                                          <img src="<%= option.image %>" alt="Option <%= option.key %>" class="block
                                     max-h-64
                                     max-w-full
                                     w-auto
                                     h-auto
                                     object-contain">

                                        </div>

                                        <% } %>


                                </div>


                              </label>


                              <% }); %>


                          </div>


                    </section>


                    <% }); %>


                </div>


                <!-- =================================================
               BOTTOM NAVIGATION
          ================================================== -->

                <div class="mt-auto
                   border-t
                   border-slate-200
                   bg-white
                   px-5 py-4
                   flex
                   flex-wrap
                   items-center
                   justify-between
                   gap-3">


                  <button type="button" id="previousQuestionButton" class="inline-flex
                     items-center gap-2
                     border border-slate-300
                     bg-white
                     text-slate-700
                     px-4 py-2.5
                     rounded-xl
                     font-semibold
                     text-sm
                     hover:bg-slate-50
                     disabled:opacity-40
                     disabled:cursor-not-allowed">
                    ← Previous
                  </button>


                  <div class="flex
                     flex-wrap
                     items-center
                     gap-2">


                    <button type="button" id="saveNextButton" class="bg-indigo-600
                       text-white
                       px-5 py-2.5
                       rounded-xl
                       text-sm
                       font-bold
                       hover:bg-indigo-700">
                      Save & Next
                    </button>


                    <button type="button" id="reviewButton" class="hidden
                       bg-purple-600
                       text-white
                       px-5 py-2.5
                       rounded-xl
                       text-sm
                       font-bold
                       hover:bg-purple-700">
                      Save & Review
                    </button>


                  </div>


                </div>


              </div>


              <!-- ===================================================
             QUESTION PALETTE
        ==================================================== -->

              <aside class="bg-white
                 border border-slate-200
                 rounded-2xl
                 shadow-sm
                 overflow-hidden
                 h-fit
                 lg:sticky
                 lg:top-36">


                <div class="px-4 py-4
                   border-b
                   border-slate-200">

                  <h3 class="font-bold
                     text-slate-900
                     text-sm">
                    Question Palette
                  </h3>


                  <div class="grid
                     grid-cols-2
                     gap-x-3 gap-y-2
                     mt-4
                     text-[11px]
                     text-slate-500">


                    <div class="flex
                       items-center
                       gap-2">

                      <span class="w-3 h-3
                         rounded
                         bg-emerald-500"></span>

                      Answered

                    </div>


                    <div class="flex
                       items-center
                       gap-2">

                      <span class="w-3 h-3
                         rounded
                         bg-rose-200"></span>

                      Visited

                    </div>


                    <div class="flex
                       items-center
                       gap-2">

                      <span class="w-3 h-3
                         rounded
                         bg-slate-200"></span>

                      Not Visited

                    </div>


                    <div class="flex
                       items-center
                       gap-2">

                      <span class="w-3 h-3
                         rounded
                         border-2
                         border-indigo-500"></span>

                      Current

                    </div>


                  </div>

                </div>


                <div class="p-4">


                  <div id="practicePalette" class="grid grid-cols-5 gap-2">


                    <% (questions || []).forEach(function(q, i) { %>

                      <button type="button" class="palette-btn
                         palette-not-visited
                         <%= i === 0 ? 'palette-current' : '' %>" data-palette-index="<%= i %>">
                        <%= i + 1 %>
                      </button>

                      <% }); %>


                  </div>


                  <!-- COUNTERS -->

                  <div class="mt-5
                     pt-4
                     border-t
                     border-slate-200
                     space-y-2
                     text-sm">


                    <div class="flex
                       justify-between">

                      <span class="text-slate-500">
                        Answered
                      </span>

                      <strong id="answeredCount" class="text-emerald-600">
                        0
                      </strong>

                    </div>


                    <div class="flex
                       justify-between">

                      <span class="text-slate-500">
                        Unanswered
                      </span>

                      <strong id="unansweredCount" class="text-rose-600">
                        <%= questions.length %>
                      </strong>

                    </div>


                    <div class="flex
                       justify-between">

                      <span class="text-slate-500">
                        Total
                      </span>

                      <strong>
                        <%= questions.length %>
                      </strong>

                    </div>


                  </div>


                </div>

              </aside>


            </div>


            <!-- =====================================================
           REVIEW PANEL
      ====================================================== -->

            <section id="practiceReviewPanel" class="hidden
               mt-5
               bg-white
               border border-slate-200
               rounded-2xl
               shadow-sm
               overflow-hidden">


              <div class="px-5 py-4
                 border-b
                 border-slate-200">

                <h2 class="font-bold
                   text-slate-900">
                  Review Practice Test
                </h2>


                <p class="text-xs
                   text-slate-500
                   mt-1">
                  Review your answers before final submission.
                  You can go back to any question.
                </p>

              </div>


              <div class="p-5">


                <div class="grid
                   sm:grid-cols-3
                   gap-3
                   mb-5">


                  <div class="rounded-xl
                     bg-emerald-50
                     border
                     border-emerald-100
                     p-4">

                    <p class="text-xs
                       text-emerald-700">
                      Answered
                    </p>

                    <p id="reviewAnsweredCount" class="text-2xl
                       font-bold
                       text-emerald-700
                       mt-1">
                      0
                    </p>

                  </div>


                  <div class="rounded-xl
                     bg-rose-50
                     border
                     border-rose-100
                     p-4">

                    <p class="text-xs
                       text-rose-700">
                      Unanswered
                    </p>

                    <p id="reviewUnansweredCount" class="text-2xl
                       font-bold
                       text-rose-700
                       mt-1">
                      <%= questions.length %>
                    </p>

                  </div>


                  <div class="rounded-xl
                     bg-slate-50
                     border
                     border-slate-200
                     p-4">

                    <p class="text-xs
                       text-slate-600">
                      Total
                    </p>

                    <p class="text-2xl
                       font-bold
                       text-slate-800
                       mt-1">
                      <%= questions.length %>
                    </p>

                  </div>


                </div>


                <div id="reviewPalette" class="flex flex-wrap gap-2"></div>


                <div class="mt-6
                   flex
                   flex-wrap
                   items-center
                   justify-between
                   gap-3">


                  <button type="button" id="backToQuestionsButton" class="border
                     border-slate-300
                     bg-white
                     text-slate-700
                     px-5 py-2.5
                     rounded-xl
                     font-semibold
                     text-sm
                     hover:bg-slate-50">
                    ← Back to Questions
                  </button>


                  <button type="submit" id="submitPracticeButton" class="bg-emerald-600
                     text-white
                     px-6 py-3
                     rounded-xl
                     font-bold
                     hover:bg-emerald-700">
                    Submit Practice Test
                  </button>


                </div>


              </div>


            </section>


          </div>


        </form>

      </main>

      <input type="hidden" id="practiceTotalQuestions" value="<%= questions.length %>">
      <script>

        (function () {

          const totalQuestions =
            Number(
              document
                .getElementById(
                  'practiceTotalQuestions'
                )
                .value || 0
            );


          let currentIndex =
            0;


          const visited =
            new Set([0]);


          const cards =
            Array.from(
              document.querySelectorAll(
                '.practice-question-card'
              )
            );


          const paletteButtons =
            Array.from(
              document.querySelectorAll(
                '[data-palette-index]'
              )
            );


          const previousButton =
            document.getElementById(
              'previousQuestionButton'
            );


          const saveNextButton =
            document.getElementById(
              'saveNextButton'
            );


          const reviewButton =
            document.getElementById(
              'reviewButton'
            );


          const clearButton =
            document.getElementById(
              'clearAnswerButton'
            );


          const progress =
            document.getElementById(
              'practiceProgress'
            );


          const questionBadge =
            document.getElementById(
              'questionBadge'
            );


          const reviewPanel =
            document.getElementById(
              'practiceReviewPanel'
            );


          const backToQuestionsButton =
            document.getElementById(
              'backToQuestionsButton'
            );


          const answeredCount =
            document.getElementById(
              'answeredCount'
            );


          const unansweredCount =
            document.getElementById(
              'unansweredCount'
            );


          const reviewAnsweredCount =
            document.getElementById(
              'reviewAnsweredCount'
            );


          const reviewUnansweredCount =
            document.getElementById(
              'reviewUnansweredCount'
            );


          const reviewPalette =
            document.getElementById(
              'reviewPalette'
            );


          function getAnswer(index) {

            const card =
              cards[index];


            if (!card) {
              return null;
            }


            const selected =
              card.querySelector(
                '.practice-radio:checked'
              );


            return selected
              ? selected.value
              : null;

          }


          function getAnsweredCount() {

            return cards.filter(
              function (_, index) {

                return Boolean(
                  getAnswer(index)
                );

              }
            ).length;

          }


          function updateCounts() {

            const answered =
              getAnsweredCount();


            const unanswered =
              totalQuestions -
              answered;


            if (answeredCount) {
              answeredCount.textContent =
                answered;
            }


            if (unansweredCount) {
              unansweredCount.textContent =
                unanswered;
            }


            if (reviewAnsweredCount) {
              reviewAnsweredCount.textContent =
                answered;
            }


            if (reviewUnansweredCount) {
              reviewUnansweredCount.textContent =
                unanswered;
            }

          }


          function updatePalette() {

            paletteButtons.forEach(
              function (button, index) {

                button.classList.remove(
                  'palette-not-visited',
                  'palette-visited',
                  'palette-answered',
                  'palette-current'
                );


                if (
                  getAnswer(index)
                ) {

                  button.classList.add(
                    'palette-answered'
                  );

                } else if (
                  visited.has(index)
                ) {

                  button.classList.add(
                    'palette-visited'
                  );

                } else {

                  button.classList.add(
                    'palette-not-visited'
                  );

                }


                if (
                  index === currentIndex
                ) {

                  button.classList.add(
                    'palette-current'
                  );

                }

              }
            );


            updateCounts();

          }


          function showQuestion(index) {

            if (
              index < 0 ||
              index >= totalQuestions
            ) {
              return;
            }


            if (reviewPanel) {
              reviewPanel.classList.add(
                'hidden'
              );
            }


            cards.forEach(
              function (card, cardIndex) {

                card.classList.toggle(
                  'active',
                  cardIndex === index
                );

              }
            );

            if (cards[index] && window.SPVNMath && typeof window.SPVNMath.renderStaticMath === 'function') {
              window.SPVNMath.renderStaticMath(cards[index]);
            }


            currentIndex =
              index;


            visited.add(
              index
            );


            if (progress) {

              progress.textContent =
                'Question ' +
                (index + 1) +
                ' / ' +
                totalQuestions;

            }


            if (questionBadge) {

              questionBadge.textContent =
                'Q ' +
                (index + 1) +
                ' / ' +
                totalQuestions;

            }


            if (previousButton) {

              previousButton.disabled =
                index === 0;

            }


            if (
              index ===
              totalQuestions - 1
            ) {

              if (saveNextButton) {
                saveNextButton.classList.add(
                  'hidden'
                );
              }


              if (reviewButton) {
                reviewButton.classList.remove(
                  'hidden'
                );
              }

            } else {

              if (saveNextButton) {
                saveNextButton.classList.remove(
                  'hidden'
                );
              }


              if (reviewButton) {
                reviewButton.classList.add(
                  'hidden'
                );
              }

            }


            updatePalette();


            window.scrollTo({
              top: 0,
              behavior: 'smooth'
            });

          }


          if (saveNextButton) {

            saveNextButton.addEventListener(
              'click',
              function () {

                visited.add(
                  currentIndex
                );


                if (
                  currentIndex <
                  totalQuestions - 1
                ) {

                  showQuestion(
                    currentIndex + 1
                  );

                }

              }
            );

          }


          if (previousButton) {

            previousButton.addEventListener(
              'click',
              function () {

                if (
                  currentIndex > 0
                ) {

                  showQuestion(
                    currentIndex - 1
                  );

                }

              }
            );

          }


          paletteButtons.forEach(
            function (button) {

              button.addEventListener(
                'click',
                function () {

                  const index =
                    Number(
                      button.dataset
                        .paletteIndex
                    );


                  showQuestion(
                    index
                  );

                }
              );

            }
          );


          if (clearButton) {

            clearButton.addEventListener(
              'click',
              function () {

                const card =
                  cards[currentIndex];


                if (!card) {
                  return;
                }


                card
                  .querySelectorAll(
                    '.practice-radio'
                  )
                  .forEach(
                    function (radio) {

                      radio.checked =
                        false;

                    }
                  );


                updatePalette();

              }
            );

          }


          document
            .querySelectorAll(
              '.practice-radio'
            )
            .forEach(
              function (radio) {

                radio.addEventListener(
                  'change',
                  updatePalette
                );

              }
            );


          function openReview() {

            cards.forEach(
              function (card) {

                card.classList.remove(
                  'active'
                );

              }
            );


            if (!reviewPanel) {
              return;
            }


            reviewPanel.classList.remove(
              'hidden'
            );


            reviewPalette.innerHTML =
              '';


            cards.forEach(
              function (_, index) {

                const button =
                  document.createElement(
                    'button'
                  );


                button.type =
                  'button';


                button.textContent =
                  index + 1;


                button.className =
                  'w-11 h-11 rounded-lg font-bold text-sm ' +
                  (
                    getAnswer(index)
                      ? 'bg-emerald-500 text-white'
                      : 'bg-rose-100 text-rose-700'
                  );


                button.addEventListener(
                  'click',
                  function () {

                    showQuestion(
                      index
                    );

                  }
                );


                reviewPalette.appendChild(
                  button
                );

              }
            );


            updateCounts();


            reviewPanel.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });

          }


          if (reviewButton) {

            reviewButton.addEventListener(
              'click',
              openReview
            );

          }


          if (backToQuestionsButton) {

            backToQuestionsButton.addEventListener(
              'click',
              function () {

                showQuestion(
                  currentIndex
                );

              }
            );

          }


          const form =
            document.getElementById(
              'practiceTestForm'
            );


          if (form) {

            form.addEventListener(
              'submit',
              function (event) {

                const answered =
                  getAnsweredCount();


                const unanswered =
                  totalQuestions -
                  answered;


                let message =
                  'Submit this Practice Test?';


                if (
                  unanswered > 0
                ) {

                  message =
                    'You still have ' +
                    unanswered +
                    ' unanswered question(s). Submit anyway?';

                }


                if (
                  !window.confirm(
                    message
                  )
                ) {

                  event.preventDefault();

                }

              }
            );

          }


          if (
            totalQuestions > 0
          ) {

            showQuestion(0);

          }

          document.addEventListener('DOMContentLoaded', function () {
            if (window.SPVNMath && typeof window.SPVNMath.renderStaticMath === 'function') {
              window.SPVNMath.renderStaticMath();
            }
          });

        })();

      </script>


      </body>

      </html>