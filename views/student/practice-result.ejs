<%- include('../partials/head') %>

<%- include('../partials/navbar-student') %>


<%
function safeImageUrl(value) {

  if (!value) {
    return '';
  }

  let src =
    String(value).trim();

  if (!src) {
    return '';
  }

  if (
    src.startsWith('/uploads/') ||
    src.startsWith('http://') ||
    src.startsWith('https://') ||
    src.startsWith('data:image/')
  ) {
    return src;
  }

  src =
    src.replace(/\\/g, '/');

  const uploadsIndex =
    src.toLowerCase()
      .indexOf('/uploads/');

  if (uploadsIndex !== -1) {
    return src.substring(
      uploadsIndex
    );
  }

  if (
    src.toLowerCase()
      .startsWith('uploads/')
  ) {
    return '/' + src;
  }

  return src;
}


function isVisualDescription(value) {

  const text =
    String(value || '')
      .trim();

  if (!text) {
    return false;
  }

  if (
    /^\[[\s\S]*\]$/.test(text)
  ) {
    return true;
  }

  return /^(venn diagram|diagram|graph|figure|image|circuit|chart|visual table)\s*:/i
    .test(
      text
        .replace(/^\[|\]$/g, '')
        .trim()
    );
}


const totalQuestions =
  Number(
    attempt.questionCount || 0
  );


const correctCount =
  Number(
    attempt.correct || 0
  );


const wrongCount =
  Number(
    attempt.wrong || 0
  );


const unattemptedCount =
  Number(
    attempt.unattempted || 0
  );


const accuracy =
  totalQuestions > 0
    ? (
        (
          correctCount /
          totalQuestions
        ) *
        100
      ).toFixed(1)
    : '0.0';


const score =
  Number(
    attempt.score || 0
  );
%>


<main class="min-h-screen bg-slate-50">

  <div
    class="max-w-6xl
           mx-auto
           px-4 lg:px-6
           py-8"
  >


    <!-- =====================================================
         RESULT HEADER
    ====================================================== -->

    <div
      class="bg-white
             border border-slate-200
             rounded-2xl
             shadow-sm
             overflow-hidden
             mb-6"
    >


      <div
        class="p-6
               flex flex-col
               md:flex-row
               md:items-center
               justify-between
               gap-5"
      >


        <div class="min-w-0">


          <p
            class="text-xs
                   font-bold
                   text-indigo-600
                   uppercase
                   tracking-wide"
          >
            Practice Completed
          </p>


          <h1
            class="text-2xl
                   font-bold
                   text-slate-900
                   mt-1"
          >

            <%= attempt.subject %>


            <% if (attempt.topic) { %>

              <span class="text-slate-400">
                ·
              </span>

              <%= attempt.topic %>

            <% } %>

          </h1>


          <% if (attempt.subtopic) { %>

            <p
              class="text-sm
                     text-slate-600
                     mt-1"
            >
              <%= attempt.subtopic %>
            </p>

          <% } %>


          <p
            class="text-sm
                   text-slate-500
                   mt-2"
          >
            This practice result does not affect your official rank,
            percentile or official exam result.
          </p>


          <div
            class="flex
                   flex-wrap
                   items-center
                   gap-2
                   mt-3
                   text-xs
                   text-slate-500"
          >

            <span
              class="px-2.5 py-1
                     rounded-full
                     bg-slate-100"
            >
              <%= totalQuestions %> Questions
            </span>


            <span
              class="px-2.5 py-1
                     rounded-full
                     bg-slate-100"
            >
              <%= attempt.difficulty || 'All' %> Difficulty
            </span>


            <% if (attempt.submittedAt) { %>

              <span
                class="px-2.5 py-1
                       rounded-full
                       bg-slate-100"
              >

                <%= new Date(
                  attempt.submittedAt
                ).toLocaleString(
                  'en-IN'
                ) %>

              </span>

            <% } %>

          </div>


        </div>


        <!-- ACCURACY -->

        <div
          class="shrink-0
                 text-center
                 bg-emerald-50
                 border border-emerald-100
                 rounded-2xl
                 px-8 py-5"
        >

          <p
            class="text-4xl
                   font-extrabold
                   text-emerald-600"
          >
            <%= accuracy %>%
          </p>


          <p
            class="text-xs
                   font-semibold
                   text-emerald-700
                   mt-1"
          >
            Accuracy
          </p>

        </div>


      </div>


      <!-- ===================================================
           STATS
      ==================================================== -->

      <div
        class="grid
               grid-cols-2
               lg:grid-cols-5
               border-t
               border-slate-100"
      >


        <div
          class="p-4
                 text-center
                 border-r
                 border-slate-100"
        >

          <p
            class="text-xs
                   text-slate-400"
          >
            Questions
          </p>

          <p
            class="text-xl
                   font-bold
                   text-slate-900
                   mt-1"
          >
            <%= totalQuestions %>
          </p>

        </div>


        <div
          class="p-4
                 text-center
                 border-r
                 border-slate-100"
        >

          <p
            class="text-xs
                   text-emerald-600"
          >
            Correct
          </p>

          <p
            class="text-xl
                   font-bold
                   text-emerald-700
                   mt-1"
          >
            <%= correctCount %>
          </p>

        </div>


        <div
          class="p-4
                 text-center
                 border-r
                 border-slate-100"
        >

          <p
            class="text-xs
                   text-rose-500"
          >
            Wrong
          </p>

          <p
            class="text-xl
                   font-bold
                   text-rose-600
                   mt-1"
          >
            <%= wrongCount %>
          </p>

        </div>


        <div
          class="p-4
                 text-center
                 border-r
                 border-slate-100"
        >

          <p
            class="text-xs
                   text-amber-600"
          >
            Unattempted
          </p>

          <p
            class="text-xl
                   font-bold
                   text-amber-700
                   mt-1"
          >
            <%= unattemptedCount %>
          </p>

        </div>


        <div
          class="p-4
                 text-center
                 col-span-2
                 lg:col-span-1"
        >

          <p
            class="text-xs
                   text-indigo-600"
          >
            Score
          </p>

          <p
            class="text-xl
                   font-bold
                   text-indigo-700
                   mt-1"
          >
            <%= score %>
          </p>

        </div>


      </div>


      <!-- ===================================================
           ACTIONS
      ==================================================== -->

      <div
        class="px-6 py-4
               border-t
               border-slate-100
               flex
               flex-wrap
               gap-3"
      >


        <a
          href="/student/practice"
          class="inline-flex
                 items-center
                 justify-center
                 gap-2
                 bg-slate-900
                 text-white
                 px-5 py-2.5
                 rounded-xl
                 text-sm
                 font-semibold
                 hover:bg-slate-800"
        >
          ↻ Practice Again
        </a>


        <a
          href="/student/tests"
          class="inline-flex
                 items-center
                 justify-center
                 gap-2
                 bg-white
                 border border-slate-300
                 text-slate-700
                 px-5 py-2.5
                 rounded-xl
                 text-sm
                 font-semibold
                 hover:bg-slate-50"
        >
          ← Back to Tests
        </a>


      </div>


    </div>


    <!-- =====================================================
         ANSWER REVIEW HEADER
    ====================================================== -->

    <div
      class="flex
             flex-wrap
             items-end
             justify-between
             gap-3
             mb-4"
    >

      <div>

        <h2
          class="font-bold
                 text-lg
                 text-slate-900"
        >
          Review Answers
        </h2>


        <p
          class="text-xs
                 text-slate-500
                 mt-1"
        >
          Check your answer, correct answer and solution for every question.
        </p>

      </div>


      <div
        class="flex
               items-center
               gap-3
               text-xs"
      >

        <span
          class="flex
                 items-center
                 gap-1.5"
        >
          <span
            class="w-3 h-3
                   rounded
                   bg-emerald-500"
          ></span>

          Correct
        </span>


        <span
          class="flex
                 items-center
                 gap-1.5"
        >
          <span
            class="w-3 h-3
                   rounded
                   bg-rose-500"
          ></span>

          Wrong
        </span>


        <span
          class="flex
                 items-center
                 gap-1.5"
        >
          <span
            class="w-3 h-3
                   rounded
                   bg-amber-400"
          ></span>

          Unattempted
        </span>

      </div>


    </div>


    <!-- =====================================================
         QUESTION REVIEW
    ====================================================== -->

    <div class="space-y-4">


      <% (questions || []).forEach(function(q, i) {

        const questionId =
          String(q._id);


        const given =
          attempt.answers &&
          attempt.answers[questionId]
            ? String(
                attempt.answers[questionId]
              )
                .trim()
                .toUpperCase()
            : null;


        const correctAnswer =
          String(
            q.correctAnswer || ''
          )
            .trim()
            .toUpperCase();


        const isCorrect =
          Boolean(
            given &&
            given === correctAnswer
          );


        const isUnattempted =
          !given;


        const borderClass =
          isUnattempted
            ? 'border-amber-200'
            : isCorrect
              ? 'border-emerald-200'
              : 'border-rose-200';


        const statusClass =
          isUnattempted
            ? 'bg-amber-100 text-amber-700'
            : isCorrect
              ? 'bg-emerald-100 text-emerald-700'
              : 'bg-rose-100 text-rose-700';


        const statusText =
          isUnattempted
            ? 'Unattempted'
            : isCorrect
              ? 'Correct'
              : 'Wrong';


        const questionImage =
          safeImageUrl(
            q.questionImage
          );


        const options = [

          {
            key: 'A',
            text: q.optionA,
            image:
              safeImageUrl(
                q.optionAImage
              )
          },

          {
            key: 'B',
            text: q.optionB,
            image:
              safeImageUrl(
                q.optionBImage
              )
          },

          {
            key: 'C',
            text: q.optionC,
            image:
              safeImageUrl(
                q.optionCImage
              )
          },

          {
            key: 'D',
            text: q.optionD,
            image:
              safeImageUrl(
                q.optionDImage
              )
          }

        ];

      %>


        <section
          class="bg-white
                 border
                 <%= borderClass %>
                 rounded-2xl
                 overflow-hidden
                 shadow-sm"
        >


          <!-- QUESTION STATUS HEADER -->

          <div
            class="px-5 py-3
                   border-b
                   border-slate-100
                   bg-slate-50
                   flex
                   items-center
                   justify-between
                   gap-3"
          >


            <div
              class="flex
                     items-center
                     gap-3"
            >

              <div
                class="w-8 h-8
                       shrink-0
                       rounded-lg
                       bg-white
                       border
                       border-slate-200
                       flex
                       items-center
                       justify-center
                       text-xs
                       font-bold
                       text-slate-700"
              >
                <%= i + 1 %>
              </div>


              <span
                class="text-xs
                       font-semibold
                       text-slate-500"
              >
                Question <%= i + 1 %>
              </span>

            </div>


            <span
              class="px-2.5 py-1
                     rounded-full
                     text-xs
                     font-bold
                     <%= statusClass %>"
            >
              <%= statusText %>
            </span>


          </div>


          <div class="p-5">


            <!-- QUESTION -->

            <div
              class="font-serif math-content
                     text-[17px]
                     leading-7
                     font-semibold
                     text-slate-900"
              data-math-source="<%= (q.question || '').replace(/"/g, '&quot;') %>"
            >
              <%= q.question %>
            </div>


            <!-- QUESTION IMAGE -->

            <% if (questionImage) { %>

              <div
                class="mt-4
                       border
                       border-slate-200
                       bg-slate-50
                       rounded-xl
                       p-3
                       overflow-auto"
              >

                <img
                  src="<%= questionImage %>"
                  alt="Question <%= i + 1 %> image"
                  class="block
                         max-h-80
                         max-w-full
                         w-auto
                         h-auto
                         mx-auto
                         object-contain
                         bg-white
                         rounded-lg"
                >

              </div>

            <% } %>


            <!-- =================================================
                 OPTIONS
            ================================================== -->

            <div
              class="grid
                     grid-cols-1
                     md:grid-cols-2
                     gap-3
                     mt-5"
            >


              <% options.forEach(function(option) {

                const optionHasText =
                  String(
                    option.text || ''
                  ).trim();


                const showText =
                  optionHasText &&
                  !(
                    option.image &&
                    isVisualDescription(
                      option.text
                    )
                  );


                if (
                  !showText &&
                  !option.image
                ) {
                  return;
                }


                const isCorrectOption =
                  option.key ===
                  correctAnswer;


                const isStudentOption =
                  option.key ===
                  given;


                let optionClass =
                  'border-slate-200 bg-slate-50 text-slate-700';


                if (isCorrectOption) {

                  optionClass =
                    'border-emerald-400 bg-emerald-50 text-emerald-800';

                }


                if (
                  isStudentOption &&
                  !isCorrectOption
                ) {

                  optionClass =
                    'border-rose-400 bg-rose-50 text-rose-800';

                }

              %>


                <div
                  class="border
                         rounded-xl
                         p-3
                         <%= optionClass %>"
                >


                  <div
                    class="flex
                           items-start
                           gap-3"
                  >


                    <span
                      class="w-7 h-7
                             shrink-0
                             rounded-full
                             flex
                             items-center
                             justify-center
                             text-xs
                             font-bold
                             border
                             <%=
                               isCorrectOption
                                 ? 'bg-emerald-500 text-white border-emerald-500'
                                 : isStudentOption
                                   ? 'bg-rose-500 text-white border-rose-500'
                                   : 'bg-white text-slate-600 border-slate-300'
                             %>"
                    >
                      <%= option.key %>
                    </span>


                    <div class="flex-1 min-w-0">


                      <% if (showText) { %>

                        <div
                          class="font-serif math-content
                                 text-[15px]
                                 leading-6"
                          data-math-source="<%= (option.text || '').replace(/"/g, '&quot;') %>"
                        >
                          <%= option.text %>
                        </div>

                      <% } %>


                      <% if (option.image) { %>

                        <div
                          class="<%= showText ? 'mt-3' : '' %>
                                 bg-white
                                 rounded-lg
                                 p-1"
                        >

                          <img
                            src="<%= option.image %>"
                            alt="Option <%= option.key %>"
                            class="block
                                   max-h-56
                                   max-w-full
                                   w-auto
                                   h-auto
                                   object-contain"
                          >

                        </div>

                      <% } %>


                      <% if (isCorrectOption) { %>

                        <p
                          class="text-[11px]
                                 font-bold
                                 text-emerald-600
                                 mt-2"
                        >
                          ✓ Correct Answer
                        </p>

                      <% } %>


                      <% if (
                        isStudentOption &&
                        !isCorrectOption
                      ) { %>

                        <p
                          class="text-[11px]
                                 font-bold
                                 text-rose-600
                                 mt-2"
                        >
                          ✗ Your Answer
                        </p>

                      <% } %>


                    </div>


                  </div>


                </div>


              <% }); %>


            </div>


            <!-- =================================================
                 ANSWER SUMMARY
            ================================================== -->

            <div
              class="flex
                     flex-wrap
                     gap-2
                     mt-4
                     text-xs"
            >


              <span
                class="px-3 py-1.5
                       rounded-lg
                       bg-slate-100
                       text-slate-700"
              >

                Your Answer:

                <strong>
                  <%= given || 'Not answered' %>
                </strong>

              </span>


              <span
                class="px-3 py-1.5
                       rounded-lg
                       bg-emerald-100
                       text-emerald-700"
              >

                Correct Answer:

                <strong>
                  <%= correctAnswer || '—' %>
                </strong>

              </span>


              <% if (q.marks) { %>

                <span
                  class="px-3 py-1.5
                         rounded-lg
                         bg-indigo-50
                         text-indigo-700"
                >
                  <strong>
                    <%= q.marks %>
                  </strong>
                  mark<%= Number(q.marks) === 1 ? '' : 's' %>
                </span>

              <% } %>


            </div>


            <!-- =================================================
                 SOLUTION IMAGE
            ================================================== -->

            <% if (safeImageUrl(q.solutionImage)) { %>

              <div
                class="mt-4
                       rounded-xl
                       border border-blue-100
                       bg-blue-50
                       p-3"
              >

                <p
                  class="text-xs
                         font-bold
                         text-blue-700
                         mb-2"
                >
                  Solution Figure
                </p>


                <img
                  src="<%= safeImageUrl(q.solutionImage) %>"
                  alt="Solution image"
                  class="block
                         max-h-72
                         max-w-full
                         w-auto
                         h-auto
                         object-contain
                         bg-white
                         rounded-lg"
                >

              </div>

            <% } %>


            <!-- =================================================
                 SOLUTION
            ================================================== -->

            <% if (
              q.detailedSolution ||
              q.explanation
            ) { %>

              <div
                class="mt-4
                       bg-blue-50
                       border border-blue-100
                       text-blue-900
                       rounded-xl
                       p-4
                       text-sm
                       leading-6"
              >

                <p
                  class="font-bold
                         text-xs
                         uppercase
                         tracking-wide
                         text-blue-700
                         mb-1"
                >
                  Solution
                </p>


                <div class="font-serif math-content" data-math-source="<%= ((q.detailedSolution || q.explanation) || '').replace(/"/g, '&quot;') %>">

                  <%= q.detailedSolution ||
                      q.explanation %>

                </div>


              </div>

            <% } %>


            <!-- =================================================
                 META
            ================================================== -->

            <div
              class="flex
                     flex-wrap
                     gap-2
                     mt-4
                     text-[11px]"
            >


              <% if (q.subject) { %>

                <span
                  class="bg-slate-100
                         text-slate-600
                         px-2 py-1
                         rounded-full"
                >
                  <%= q.subject %>
                </span>

              <% } %>


              <% if (q.topic) { %>

                <span
                  class="bg-slate-100
                         text-slate-600
                         px-2 py-1
                         rounded-full"
                >
                  <%= q.topic %>
                </span>

              <% } %>


              <% if (q.subtopic) { %>

                <span
                  class="bg-slate-100
                         text-slate-600
                         px-2 py-1
                         rounded-full"
                >
                  <%= q.subtopic %>
                </span>

              <% } %>


              <% if (q.difficulty) { %>

                <span
                  class="bg-slate-100
                         text-slate-600
                         px-2 py-1
                         rounded-full"
                >
                  <%= q.difficulty %>
                </span>

              <% } %>


            </div>


          </div>


        </section>


      <% }); %>


    </div>


    <!-- =====================================================
         BOTTOM ACTION
    ====================================================== -->

    <div
      class="mt-7
             flex
             flex-wrap
             justify-center
             gap-3"
    >


      <a
        href="/student/practice"
        class="bg-slate-900
               text-white
               px-6 py-3
               rounded-xl
               text-sm
               font-bold
               hover:bg-slate-800"
      >
        Start Another Practice Test
      </a>


      <a
        href="/student/dashboard"
        class="bg-white
               border border-slate-300
               text-slate-700
               px-6 py-3
               rounded-xl
               text-sm
               font-bold
               hover:bg-slate-50"
      >
        Back to Dashboard
      </a>


    </div>


  </div>

</main>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.SPVNMath && typeof window.SPVNMath.renderStaticMath === 'function') {
      window.SPVNMath.renderStaticMath();
    }
  });
</script>
</body>
</html>