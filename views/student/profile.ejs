<%- include('../partials/head') %>

<div class="flex min-h-screen">
  <%- include('../partials/sidebar-student') %>

  <main class="lg:ml-64 flex-1 min-w-0 min-h-screen bg-slate-50">
    <!-- Top Bar -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200">
      <div class="px-5 lg:px-8 py-3.5 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
          <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800 p-1.5 rounded-lg hover:bg-slate-100" type="button" aria-label="Open sidebar">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <div>
            <h1 class="text-xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
              <span>My Profile</span>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800">Student</span>
            </h1>
            <p class="text-xs text-slate-500">View and verify your personal, academic, and exam records</p>
          </div>
        </div>

        <div class="flex items-center gap-2.5">
          <button type="button" onclick="openEditModal()"
            class="flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3.5 py-2 rounded-xl transition shadow-xs">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
            <span>Edit Contact Info</span>
          </button>
          <a href="/auth/change-password"
            class="hidden sm:flex items-center gap-1.5 border border-slate-200 hover:border-slate-300 text-slate-700 text-xs font-semibold px-3.5 py-2 rounded-xl transition bg-white shadow-xs">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Password</span>
          </a>
        </div>
      </div>
    </header>

    <div class="p-5 lg:p-8 space-y-6 max-w-6xl mx-auto">
      <%- include('../partials/flash') %>

      <!-- ── Hero Profile Card ──────────────────────────────────────── -->
      <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="h-28 bg-gradient-to-r from-sky-700 via-indigo-700 to-navy-900 relative"></div>
        <div class="px-6 pb-6 pt-0 relative">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 -mt-12 mb-4">
            <div class="flex items-end gap-4">
              <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-indigo-500 to-sky-600 ring-4 ring-white shadow-md flex items-center justify-center text-white font-extrabold text-3xl shrink-0">
                <% if (student.profilePhoto) { %>
                  <img src="<%= student.profilePhoto %>" alt="<%= student.name %>" class="w-full h-full object-cover rounded-2xl" />
                <% } else { %>
                  <%= (student.name || 'S').charAt(0).toUpperCase() %>
                <% } %>
              </div>
              <div class="min-w-0">
                <h2 class="text-2xl font-black text-slate-900 leading-tight truncate"><%= student.name %></h2>
                <div class="flex flex-wrap items-center gap-2 mt-1">
                  <span class="font-mono text-xs font-bold text-sky-700 bg-sky-50 border border-sky-200 px-2 py-0.5 rounded-md">
                    Roll: <%= student.rollNo || '—' %>
                  </span>
                  <% if (student.classLevel) { %>
                    <span class="text-xs font-semibold text-indigo-700 bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded-md">
                      Class: <%= student.classLevel %><% if (student.division) { %> (<%= student.division %>)<% } %>
                    </span>
                  <% } %>
                  <span class="text-xs font-bold px-2 py-0.5 rounded-md <%= student.isActive !== false ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200' %>">
                    <%= student.isActive !== false ? '● Active' : '● Inactive' %>
                  </span>
                </div>
              </div>
            </div>
            <div class="flex flex-wrap gap-2 shrink-0">
              <a href="/student/tests" class="text-xs font-bold px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                Tests
              </a>
              <a href="/student/results" class="text-xs font-bold px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                Results
              </a>
              <a href="/student/documents" class="text-xs font-bold px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                Documents
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Exam Stats Row ─────────────────────────────────────────── -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Tests Attempted</span>
            <div class="w-8 h-8 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center font-bold text-sm">📝</div>
          </div>
          <p class="text-2xl font-black text-slate-900"><%= stats.totalTests %></p>
          <p class="text-[11px] text-slate-500 mt-0.5">Submitted attempts</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Average Score</span>
            <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-sm">📊</div>
          </div>
          <p class="text-2xl font-black text-indigo-700"><%= stats.averageScore %></p>
          <p class="text-[11px] text-slate-500 mt-0.5">Avg <%= stats.averagePercentage %>% marks</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Best Score</span>
            <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm">🏆</div>
          </div>
          <p class="text-2xl font-black text-emerald-600"><%= stats.highestScore %></p>
          <p class="text-[11px] text-slate-500 mt-0.5">Peak performance</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Overall Accuracy</span>
            <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-sm">🎯</div>
          </div>
          <p class="text-2xl font-black text-amber-600"><%= stats.accuracy %>%</p>
          <p class="text-[11px] text-slate-500 mt-0.5"><%= stats.totalCorrect %> correct / <%= stats.totalWrong %> wrong</p>
        </div>
      </div>

      <!-- ── Detailed Info Sections ─────────────────────────────────── -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- 1. Personal Information -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-xs space-y-4">
          <div class="flex items-center gap-2.5 pb-3 border-b border-slate-100">
            <div class="w-8 h-8 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-sm">Personal Information</h3>
              <p class="text-[11px] text-slate-400">Identity and personal verification</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-y-4 gap-x-6 text-xs">
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Full Name</p>
              <p class="font-bold text-slate-900"><%= student.name %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Roll Number</p>
              <p class="font-mono font-bold text-slate-900"><%= student.rollNo || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">GR Number</p>
              <p class="font-semibold text-slate-800"><%= student.grNo || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">CET Exam Number</p>
              <p class="font-semibold text-slate-800"><%= student.cetExamNo || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Gender</p>
              <p class="font-semibold text-slate-800"><%= student.gender || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Date of Birth</p>
              <p class="font-semibold text-slate-800">
                <%= student.dateOfBirth ? new Date(student.dateOfBirth).toLocaleDateString('en-IN') : '—' %>
              </p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Category</p>
              <p class="font-semibold text-slate-800"><%= student.category || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Blood Group</p>
              <p class="font-semibold text-slate-800"><%= student.bloodGroup || '—' %></p>
            </div>
            <div class="col-span-2">
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Aadhaar Number</p>
              <p class="font-mono font-semibold text-slate-800">
                <% if (student.aadhaarNo) { %>
                  •••• •••• <%= String(student.aadhaarNo).slice(-4) %>
                <% } else { %>
                  —
                <% } %>
              </p>
            </div>
          </div>
        </div>

        <!-- 2. Academic Information -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-xs space-y-4">
          <div class="flex items-center gap-2.5 pb-3 border-b border-slate-100">
            <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-sm">Academic &amp; Batch Details</h3>
              <p class="text-[11px] text-slate-400">Class, course and batch enrollment</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-y-4 gap-x-6 text-xs">
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Class</p>
              <p class="font-bold text-slate-900"><%= student.classLevel || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Division</p>
              <p class="font-bold text-slate-900"><%= student.division || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Subject Group</p>
              <p class="font-semibold text-slate-800"><%= student.subjectGroup || student.subject || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Hostel Status</p>
              <p class="font-semibold text-slate-800"><%= student.hostel || '—' %></p>
            </div>
            <div class="col-span-2">
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Academy / Institute</p>
              <p class="font-semibold text-slate-800"><%= student.academy || collegeName || '—' %></p>
            </div>
            <div class="col-span-2">
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-1">Enrolled Batches / Groups</p>
              <% if (memberships && memberships.length > 0) { %>
                <div class="flex flex-wrap gap-1.5">
                  <% memberships.forEach(m => { %>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 border border-indigo-200">
                      <span>🏷</span>
                      <span><%= (m.groupId && m.groupId.name) || 'Batch' %></span>
                      <% if (m.groupId && m.groupId.academicYear) { %>
                        <span class="text-[10px] text-indigo-400">(<%= m.groupId.academicYear %>)</span>
                      <% } %>
                    </span>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="text-slate-400 italic">No assigned batches</p>
              <% } %>
            </div>
          </div>
        </div>

        <!-- 3. Contact Details -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-xs space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-sm">Contact &amp; Address</h3>
                <p class="text-[11px] text-slate-400">Communication and location details</p>
              </div>
            </div>
            <button type="button" onclick="openEditModal()" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">
              Edit
            </button>
          </div>

          <div class="grid grid-cols-2 gap-y-4 gap-x-6 text-xs">
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Email</p>
              <p class="font-semibold text-slate-800 truncate"><%= student.email || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Student Mobile</p>
              <p class="font-mono font-semibold text-slate-800"><%= student.phone || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Primary Parent Contact</p>
              <p class="font-mono font-semibold text-slate-800"><%= student.parentContact || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Secondary Parent Contact</p>
              <p class="font-mono font-semibold text-slate-800"><%= student.parentContact2 || '—' %></p>
            </div>
            <div class="col-span-2">
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Address</p>
              <p class="font-semibold text-slate-800"><%= student.address || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Taluka</p>
              <p class="font-semibold text-slate-800"><%= student.taluka || '—' %></p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">District / PIN</p>
              <p class="font-semibold text-slate-800"><%= student.district || '—' %> <% if (student.pinCode) { %>- <%= student.pinCode %><% } %></p>
            </div>
          </div>
        </div>

        <!-- 4. Security & Account Details -->
        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-xs space-y-4">
          <div class="flex items-center gap-2.5 pb-3 border-b border-slate-100">
            <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-sm">Security &amp; Account</h3>
              <p class="text-[11px] text-slate-400">Account status and login info</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-y-4 gap-x-6 text-xs">
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Account Status</p>
              <p class="font-semibold text-emerald-700">Active &amp; Verified</p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Password Status</p>
              <p class="font-semibold <%= student.isFirstLogin ? 'text-amber-700' : 'text-emerald-700' %>">
                <%= student.isFirstLogin ? 'Temporary (Change Recommended)' : 'Updated by Student' %>
              </p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Enrolled Since</p>
              <p class="font-semibold text-slate-800">
                <%= student.createdAt ? new Date(student.createdAt).toLocaleDateString('en-IN') : '—' %>
              </p>
            </div>
            <div>
              <p class="text-slate-400 uppercase tracking-wider text-[10px] font-bold mb-0.5">Last Login</p>
              <p class="font-semibold text-slate-800">
                <%= student.lastLogin ? new Date(student.lastLogin).toLocaleString('en-IN') : 'Active now' %>
              </p>
            </div>
            <div class="col-span-2 pt-2">
              <a href="/auth/change-password" class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-600 hover:text-indigo-800 bg-indigo-50 border border-indigo-200 px-3.5 py-2 rounded-xl transition">
                <span>🔐 Change Account Password &rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Recent Test Attempts ───────────────────────────────────── -->
      <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
          <div>
            <h3 class="font-bold text-slate-900 text-sm">Recent Test Performance</h3>
            <p class="text-xs text-slate-500">Your latest test attempts and results</p>
          </div>
          <a href="/student/results" class="text-xs font-bold text-sky-700 hover:text-sky-900">
            View All Results &rarr;
          </a>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead class="bg-slate-50 text-slate-600 font-bold border-b border-slate-100">
              <tr>
                <th class="px-6 py-3 text-left">Test Title</th>
                <th class="px-6 py-3 text-left">Date</th>
                <th class="px-6 py-3 text-left">Score</th>
                <th class="px-6 py-3 text-left">Percentage</th>
                <th class="px-6 py-3 text-left">Status</th>
                <th class="px-6 py-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (results && results.length > 0) { %>
                <% results.forEach(r => {
                  const tMarks = Number(r.totalMarks || (r.testId && r.testId.totalMarks) || 0);
                  const pct = tMarks > 0 ? ((Number(r.score || 0) / tMarks) * 100).toFixed(1) : '—';
                %>
                  <tr class="hover:bg-slate-50/80 transition">
                    <td class="px-6 py-3.5 font-bold text-slate-900">
                      <%= (r.testId && r.testId.title) || 'Exam Test' %>
                    </td>
                    <td class="px-6 py-3.5 text-slate-500 font-medium">
                      <%= new Date(r.createdAt).toLocaleDateString('en-IN') %>
                    </td>
                    <td class="px-6 py-3.5 font-bold text-slate-900">
                      <%= r.score %> <span class="text-slate-400 font-normal">/ <%= tMarks %></span>
                    </td>
                    <td class="px-6 py-3.5">
                      <span class="font-bold <%= Number(pct) >= 50 ? 'text-emerald-600' : 'text-amber-600' %>"><%= pct %>%</span>
                    </td>
                    <td class="px-6 py-3.5">
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        Submitted
                      </span>
                    </td>
                    <td class="px-6 py-3.5 text-right">
                      <a href="/results/<%= r._id %>" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 bg-indigo-50 px-2.5 py-1 rounded-lg transition">
                        View Analysis
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="px-6 py-8 text-center text-slate-400 italic">
                    No submitted tests found. Start taking tests to track your performance!
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ── Uploaded Documents Card ────────────────────────────────── -->
      <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-bold text-slate-900 text-sm">Uploaded Documents</h3>
            <p class="text-xs text-slate-500">Certificates, ID cards and marksheets</p>
          </div>
          <a href="/student/documents" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">
            Manage Documents &rarr;
          </a>
        </div>
        <% if (documents && documents.length > 0) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 pt-2">
            <% documents.forEach(d => { %>
              <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-200/80">
                <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-indigo-600 shrink-0 shadow-2xs">
                  📄
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-xs font-bold text-slate-900 truncate"><%= d.title || d.originalName %></p>
                  <p class="text-[10px] text-slate-400"><%= new Date(d.createdAt).toLocaleDateString('en-IN') %></p>
                </div>
                <a href="<%= d.filePath %>" target="_blank" class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800">
                  Open
                </a>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-400 italic pt-1">No documents uploaded yet. <a href="/student/documents" class="text-indigo-600 font-semibold underline">Upload now</a></p>
        <% } %>
      </div>

    </div>
  </main>
</div>

<!-- ── Edit Profile Modal ───────────────────────────────────────────── -->
<div id="editProfileModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl shadow-card-lg w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh]">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50 shrink-0">
      <div>
        <h3 class="font-bold text-slate-900 text-sm">Update Contact &amp; Details</h3>
        <p class="text-xs text-slate-500">Keep your communication details up to date</p>
      </div>
      <button type="button" onclick="closeEditModal()" class="w-8 h-8 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-500 hover:bg-slate-100">
        ✕
      </button>
    </div>

    <form action="/student/profile/update" method="POST" class="p-6 space-y-4 overflow-y-auto flex-1">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 uppercase tracking-wider text-[10px] mb-1">Student Mobile Number</label>
          <input type="text" name="phone" value="<%= student.phone || '' %>" placeholder="10-digit mobile"
            class="w-full border border-slate-200 rounded-xl px-3.5 py-2 text-xs focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 uppercase tracking-wider text-[10px] mb-1">Blood Group</label>
          <input type="text" name="bloodGroup" value="<%= student.bloodGroup || '' %>" placeholder="e.g. O+, B+"
            class="w-full border border-slate-200 rounded-xl px-3.5 py-2 text-xs focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 uppercase tracking-wider text-[10px] mb-1">Primary Parent Contact</label>
          <input type="text" name="parentContact" value="<%= student.parentContact || '' %>" placeholder="Father / Guardian phone"
            class="w-full border border-slate-200 rounded-xl px-3.5 py-2 text-xs focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 uppercase tracking-wider text-[10px] mb-1">Secondary Parent Contact</label>
          <input type="text" name="parentContact2" value="<%= student.parentContact2 || '' %>" placeholder="Mother / Alternate phone"
            class="w-full border border-slate-200 rounded-xl px-3.5 py-2 text-xs focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 uppercase tracking-wider text-[10px] mb-1">Hostel Status</label>
          <select name="hostel" class="w-full border border-slate-200 rounded-xl px-3.5 py-2 text-xs bg-white focus:ring-2 focus:ring-indigo-500">
            <option value="">— Select Hostel Status —</option>
            <option value="Hostelite" <%= student.hostel === 'Hostelite' ? 'selected' : '' %>>Hostelite (Campus Hostel)</option>
            <option value="Day Scholar" <%= student.hostel === 'Day Scholar' ? 'selected' : '' %>>Day Scholar (Commuter)</option>
          </select>
        </div>

        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 uppercase tracking-wider text-[10px] mb-1">Residential Address</label>
          <textarea name="address" rows="2" placeholder="Full residential address"
            class="w-full border border-slate-200 rounded-xl px-3.5 py-2 text-xs focus:ring-2 focus:ring-indigo-500"><%= student.address || '' %></textarea>
        </div>

        <div>
          <label class="block font-bold text-slate-700 uppercase tracking-wider text-[10px] mb-1">Taluka</label>
          <input type="text" name="taluka" value="<%= student.taluka || '' %>" placeholder="Taluka"
            class="w-full border border-slate-200 rounded-xl px-3.5 py-2 text-xs focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 uppercase tracking-wider text-[10px] mb-1">District</label>
          <input type="text" name="district" value="<%= student.district || '' %>" placeholder="District"
            class="w-full border border-slate-200 rounded-xl px-3.5 py-2 text-xs focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 uppercase tracking-wider text-[10px] mb-1">PIN Code</label>
          <input type="text" name="pinCode" value="<%= student.pinCode || '' %>" placeholder="6-digit PIN code"
            class="w-full border border-slate-200 rounded-xl px-3.5 py-2 text-xs focus:ring-2 focus:ring-indigo-500" />
        </div>
      </div>

      <div class="flex gap-3 pt-3 border-t border-slate-100">
        <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 rounded-xl text-xs transition">
          Save Changes
        </button>
        <button type="button" onclick="closeEditModal()" class="flex-1 border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold py-2.5 rounded-xl text-xs transition">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditModal() {
    document.getElementById('editProfileModal').classList.remove('hidden');
  }
  function closeEditModal() {
    document.getElementById('editProfileModal').classList.add('hidden');
  }
</script>
</body>
</html>
